<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared properties + package metadata/symbols/version/README/icon come centrally from
       Directory.Build.props/Directory.Build.targets. Only the package identity here. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Flirty.AspNetCore</PackageId>
    <Description>Optional ASP.NET Core endpoints (MapFlirtyEndpoints) for the Flirty dialog engine.</Description>
    <PackageTags>chatbot;dialog;aspnetcore;minimal-api;flirty</PackageTags>
  </PropertyGroup>

  <!-- Endpoint mapping needs ASP.NET Core; therefore NOT in the core project Flirty. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flirty\Flirty.csproj" />
  </ItemGroup>

</Project>
