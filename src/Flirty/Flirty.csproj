<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared properties (TFM, Nullable, WarnAsError) + package metadata/symbols/version/README/icon
       come centrally from Directory.Build.props/Directory.Build.targets. Only the package identity here. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Flirty</PackageId>
    <Description>Chatbot/dialog engine for .NET: persistence, branching, loops, resume and triggers. Usable without ASP.NET.</Description>
    <PackageTags>chatbot;dialog;conversation;engine;branching;mediator</PackageTags>
  </PropertyGroup>

  <!-- Mediator (martinothamar): abstractions as a runtime dependency, source generator as an
       analyzer (PrivateAssets=all -> not published as a package dependency).
       Versions centrally in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- ILogger<> for the LoggingPipelineBehavior. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- IHostedService + AddHostedService for the auto-migration (#20, FlirtyMigrationHostedService). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- Outbound webhook handler (#33): IHttpClientFactory/AddHttpClient + standard resilience
         (retry/timeout, Polly v8). Real runtime dependency of the Flirty package. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- EF Core 10 (provider-agnostic): FlirtyDbContext + configurations (#18). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- All three providers ship with the Flirty package (#19); the consumer chooses
         one of them at runtime (options API follows in #34). Migrations live provider-separated
         in their own assemblies (src/Flirty.Migrations.*), see docs/PERSISTENCE.md. Version central. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Sandboxed default engine for condition expressions (#23, DynamicExpressoConditionEvaluator).
         Version centrally in Directory.Packages.props. -->
    <PackageReference Include="DynamicExpresso.Core" />
  </ItemGroup>

  <!-- Make the internal smoke-test types (Ping) for the mediator pipeline visible. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Flirty.Tests" />
  </ItemGroup>

  <!--
    #20: Bundle the three provider-separated migrations assemblies (src/Flirty.Migrations.*, IsPackable=false)
    into the Flirty NuGet package, so that package consumers can auto-migrate via o.ApplyMigrations().
    No ProjectReference possible: the migrations projects already reference Flirty -> a back-reference
    (even with ReferenceOutputAssembly=false) would be a build-graph cycle. Therefore an <MSBuild> task
    (not part of the static build graph) builds the projects on-demand and places their output DLLs via
    TargetsForTfmSpecificBuildOutput into lib/<tfm>/. Configuration is passed through explicitly, otherwise
    Debug DLLs would land in the Release package. RemoveProperties="NoBuild" is necessary because CI packs
    in NoBuild mode (dotnet pack without rebuild): the global NoBuild=true property would otherwise be inherited by
    this task and abort the build target call on the migrations projects with NETSDK1085.
    Without NoBuild the call is an incremental no-op (the projects are already up to date from the
    previous solution build) and only delivers the output paths. See
    docs/PERSISTENCE.md and docs/NUGET-PACKAGING.md.
  -->
  <ItemGroup>
    <FlirtyMigrationProject Include="..\Flirty.Migrations.Sqlite\Flirty.Migrations.Sqlite.csproj" />
    <FlirtyMigrationProject Include="..\Flirty.Migrations.PostgreSql\Flirty.Migrations.PostgreSql.csproj" />
    <FlirtyMigrationProject Include="..\Flirty.Migrations.SqlServer\Flirty.Migrations.SqlServer.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeFlirtyMigrationAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeFlirtyMigrationAssemblies">
    <MSBuild Projects="@(FlirtyMigrationProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="NoBuild">
      <Output TaskParameter="TargetOutputs" ItemName="_FlirtyMigrationDll" />
    </MSBuild>
    <ItemGroup>
      <BuildOutputInPackage Include="@(_FlirtyMigrationDll)" />
    </ItemGroup>
  </Target>

</Project>
