<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Migrations assembly for the SQLite provider (#19). EF Core assigns migrations to the
    FlirtyDbContext provider-independently; so that all three providers can coexist, each
    provider migration lives in its own assembly (ARCHITECTURE.md §8, docs/PERSISTENCE.md).
    IsPackable=false (from Directory.Build.props) – the NuGet bundling of the migrations follows in #20.
  -->
  <PropertyGroup>
    <RootNamespace>Flirty.Migrations.Sqlite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings in FlirtyDbContext + the three providers transitively (Flirty references them unguarded). -->
    <ProjectReference Include="..\Flirty\Flirty.csproj" />
    <!-- Design-time tooling for `dotnet ef`; not runtime-relevant, hence PrivateAssets=all. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
