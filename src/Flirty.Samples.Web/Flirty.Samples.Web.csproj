<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TFM, Nullable, ImplicitUsings, WarnAsError come centrally from Directory.Build.props.
       IsPackable stays false (default) -> no NuGet, CS1591 not an error. -->

  <!-- Minimal-API host that hosts and consumes the Flirty endpoints. ASP.NET Core comes through the
       Web SDK; EF Core, Mediator, IHttpClientFactory etc. transitively through the core references.
       Flirty.Migrations.Sqlite is needed at runtime for o.ApplyMigrations() (UseSqlite). -->
  <ItemGroup>
    <ProjectReference Include="..\Flirty\Flirty.csproj" />
    <ProjectReference Include="..\Flirty.AspNetCore\Flirty.AspNetCore.csproj" />
    <!-- The MCP server served at /mcp (#126). Opt-in, exactly as the package is meant to be. -->
    <ProjectReference Include="..\Flirty.Mcp\Flirty.Mcp.csproj" />
    <ProjectReference Include="..\Flirty.Migrations.Sqlite\Flirty.Migrations.Sqlite.csproj" />
  </ItemGroup>

</Project>
