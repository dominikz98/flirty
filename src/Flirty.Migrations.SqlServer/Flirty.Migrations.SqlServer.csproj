<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Migrations assembly for the SQL Server provider (#19). Its own assembly, because EF Core
    assigns migrations to the FlirtyDbContext provider-independently (see docs/PERSISTENCE.md).
    IsPackable=false (from Directory.Build.props) – NuGet bundling follows in #20.
  -->
  <PropertyGroup>
    <RootNamespace>Flirty.Migrations.SqlServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings in FlirtyDbContext + the three providers transitively (Flirty references them unguarded). -->
    <ProjectReference Include="..\Flirty\Flirty.csproj" />
    <!-- Design-time tooling for `dotnet ef`; not runtime-relevant, hence PrivateAssets=all. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
