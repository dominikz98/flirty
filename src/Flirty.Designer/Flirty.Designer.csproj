<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Core engine + all three migration assemblies: for the multi-DB connection profiles (#37) the
       matching MigrationsAssembly (Sqlite/PostgreSql/SqlServer) has to be loadable per provider at
       runtime. With a ProjectReference the NuGet bundling of the migration DLLs does not apply
       (docs/PERSISTENCE.md), so all three are referenced explicitly (like Flirty.Samples.Web, which
       needs only SQLite). -->
  <ItemGroup>
    <ProjectReference Include="..\Flirty\Flirty.csproj" />
    <ProjectReference Include="..\Flirty.Migrations.Sqlite\Flirty.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\Flirty.Migrations.PostgreSql\Flirty.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\Flirty.Migrations.SqlServer\Flirty.Migrations.SqlServer.csproj" />
  </ItemGroup>

  <!-- Make the internals (store/factory/operations) visible to the xUnit service tests (#37) and to
       the Playwright E2E (#46), whose fixture seeds the connection profile with the real types. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Flirty.Tests" />
    <InternalsVisibleTo Include="Flirty.E2E" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>
