@*
    The content of a node on the graph canvas (#101).

    Deliberately HTML in a <foreignObject> instead of SVG <text>: this makes the card a real button, and
    focus ring, Enter/space and the screen-reader role come from the platform instead of from hand work.
    Blazor supports this – its namespace check explicitly excludes foreignObject, so child elements arise
    in the HTML namespace.

    The classes live globally in wwwroot/app.css, not in an isolated CSS file: CSS isolation does not
    carry its scope attribute on to child components (the contrast finding from #95).
*@
@using Flirty.Domain

<g class="graph-node @StateClasses"
   data-node-id="@Node.QuestionId"
   transform="translate(@SvgFormat.N(Node.X) @SvgFormat.N(Node.Y))">
    <foreignObject width="@SvgFormat.N(GraphMetrics.NodeWidth)" height="@SvgFormat.N(GraphMetrics.NodeHeight)">
        <button type="button"
                class="graph-node-card"
                aria-label="@(Node.AriaLabel + RunLabel)"
                aria-pressed="@(Selected ? "true" : "false")"
                title="@Node.FullText"
                @onclick="OnSelect">
            <span class="graph-node-head">
                <span class="graph-node-key">@Node.Key</span>

                @if (Run is { IsCurrent: true })
                {
                    <span class="badge badge-current" title="This question is currently open in the test run">
                        ▶ open
                    </span>
                }
                @if (LoopIteration is { } iteration)
                {
                    <span class="badge badge-loop" title="Iteration in which this question was last answered">
                        Iteration @iteration
                    </span>
                }
                else if (AnswerCount > 1)
                {
                    @* A cycle WITHOUT a loop marker: the engine then assigns no iteration index, yet the
                       question was answered several times. Claiming "iteration" would be wrong. *@
                    <span class="badge badge-loop" title="How often this question was answered in the run">
                        @AnswerCount× answered
                    </span>
                }
                @if (Node.IsStart)
                {
                    <span class="badge badge-start">Entry</span>
                }
                @if (Node.IsTerminal)
                {
                    <span class="badge badge-terminal">Terminal</span>
                }
                @if (Node.IsUnreachable)
                {
                    <span class="badge badge-unreachable">Unreachable</span>
                }
                @if (Node.IsLoopBreaking)
                {
                    <span class="badge badge-loop">Breaking</span>
                }
                @if (Node.Warnings.Count > 0)
                {
                    <span class="badge badge-warning" title="@string.Join(" ", Node.Warnings.Select(w => w.Text))">
                        ⚠ @Node.Warnings.Count
                    </span>
                }
            </span>

            <span class="graph-node-text">@Node.Text</span>

            @* In the run the given answer replaces the configuration line (#104): the card is sized to
               its height and clips overflow – both did not fit side by side. In a run the type is the
               less interesting piece anyway and still stands in the inspector. *@
            @if (LastAnswer is { } answer)
            {
                <span class="graph-node-answer" title="@answer.Display">@answer.Display</span>
            }
            else
            {
                <span class="graph-node-meta">
                    <span>@Node.TypeLabel</span>
                    @if (Node.IsRequired)
                    {
                        <span class="graph-node-required">Required</span>
                    }
                    @if (Node.UsesOptions)
                    {
                        <span>@Node.OptionCount option(s)</span>
                    }
                </span>
            }

            @if (Node.Triggers.Count > 0 || Fired.Count > 0)
            {
                <span class="graph-chips">
                    @foreach (var trigger in Node.Triggers)
                    {
                        <span class="chip @(trigger.Kind == TriggerKind.Webhook ? "chip-webhook" : "chip-inprocess")"
                              title="@trigger.Title">@trigger.Label</span>
                    }
                    @* The events published during the run: they flash once and then remain as a chip.

                       Bundled per point in time and not per event: a loop question collects two entries
                       PER iteration (AfterAnswer and AfterQuestion), and unbundled the chip row bursts the
                       card after a few rounds – which clips overflow, so the answer value would disappear.
                       The individual events including their time stand in the inspector.

                       Deliberately WITHOUT @key: Blazor then diffs by position, a new point in time
                       becomes a new element, and its creation starts the animation. A key over the time
                       would moreover not be unique – two notifications of the same step carry the same
                       timestamp. *@
                    @foreach (var group in FiredGroups)
                    {
                        <span class="chip chip-fired @(group.IsFresh ? "is-fresh" : "")"
                              title="@group.Title">⚡ @group.Label@(group.Count > 1 ? $" {group.Count}×" : "")</span>
                    }
                </span>
            }
        </button>
    </foreignObject>

    @if (Editable)
    {
        @* The port is a SIBLING of the card, not a child: a <button> inside a <button> is invalid HTML,
           and the outer one swallowed click and focus. It sits later in the markup and thus over the
           card – the pointer hits it first, which the JS module assumes in pointerdown (it checks
           .graph-port BEFORE .graph-node). *@
        <foreignObject x="@SvgFormat.N((GraphMetrics.NodeWidth - GraphMetrics.PortSize) / 2)"
                       y="@SvgFormat.N(GraphMetrics.NodeHeight - (GraphMetrics.PortSize / 2))"
                       width="@SvgFormat.N(GraphMetrics.PortSize)"
                       height="@SvgFormat.N(GraphMetrics.PortSize)">
            @* No disabled during a running gesture: Blazor otherwise re-renders the attribute mid-drag,
               and the pointer capture is lost in the process. Locking is done via data-busy on the <svg>
               through CSS (pointer-events), which touches no attribute on the node. *@
            <button type="button"
                    class="graph-port @(IsLinkSource ? "is-active" : "")"
                    aria-label="@(IsLinkSource
                        ? $"Connection from {Node.Key} in progress – choose a target question or activate again to cancel"
                        : $"Drag a transition from {Node.Key} – or activate and then choose the target question")"
                    aria-pressed="@(IsLinkSource ? "true" : "false")"
                    @onclick="OnStartLink">＋</button>
        </foreignObject>
    }
</g>

@code {
    /// <summary>The node to render.</summary>
    [Parameter, EditorRequired]
    public required GraphNode Node { get; set; }

    /// <summary>Whether this node is currently opened in the inspector.</summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>Raised when the node is selected.</summary>
    [Parameter]
    public EventCallback<Guid> Select { get; set; }

    /// <summary>
    /// Whether the graph is editable. On a published version the outgoing port is <b>not rendered</b>
    /// instead of disabled: a port that does nothing would be more confusing than none – and the engine
    /// would reject the gesture with a conflict anyway.
    /// </summary>
    [Parameter]
    public bool Editable { get; set; }

    /// <summary>Whether a connection is currently being drawn from this node (keyboard path).</summary>
    [Parameter]
    public bool IsLinkSource { get; set; }

    /// <summary>Raised when the outgoing port is activated – the pointerless way to connect.</summary>
    [Parameter]
    public EventCallback<Guid> StartLink { get; set; }

    /// <summary>
    /// The run state of this node in the test run (#104) or <see langword="null"/> – the latter both
    /// outside a run and for questions the run did not touch.
    /// </summary>
    [Parameter]
    public GraphRunVisit? Run { get; set; }

    /// <summary>The trigger events published at this question during the run.</summary>
    [Parameter]
    public IReadOnlyList<GraphRunTrigger> Fired { get; set; } = [];

    /// <summary>A group of like events on the same node.</summary>
    /// <param name="Label">The point in time (short).</param>
    /// <param name="Count">How often it fired in the run.</param>
    /// <param name="IsFresh">Whether an event of the last step is among them.</param>
    /// <param name="Title">The full description for tooltip and screen reader.</param>
    private sealed record FiredGroup(string Label, int Count, bool IsFresh, string Title);

    /// <summary>The events of this node, bundled per point in time.</summary>
    private IReadOnlyList<FiredGroup> FiredGroups
        =>
        [
            .. Fired
                .GroupBy(trigger => trigger.Label, StringComparer.Ordinal)
                .Select(group => new FiredGroup(
                    group.Key,
                    group.Count(),
                    group.Any(trigger => trigger.IsFresh),
                    group.Count() == 1
                        ? group.First().Title
                        : $"{group.Key}: fired {group.Count()}×, last {group.Last().Detail}")),
        ];

    /// <summary>The answer last given to this question in the run.</summary>
    private GraphRunAnswer? LastAnswer => Run?.Answers.Count > 0 ? Run.Answers[^1] : null;

    /// <summary>How often the question was answered in the run.</summary>
    private int AnswerCount => Run?.Answers.Count ?? 0;

    /// <summary>
    /// The 1-based iteration of the last answer – <see langword="null"/> outside a loop.
    /// </summary>
    private int? LoopIteration
        => LastAnswer?.IterationIndex is { } index ? index + 1 : null;

    private string StateClasses
    {
        get
        {
            var classes = new List<string>(5);

            if (Selected)
            {
                classes.Add("is-selected");
            }

            if (IsLinkSource)
            {
                classes.Add("is-link-source");
            }

            if (Node.IsStart)
            {
                classes.Add("is-start");
            }

            if (Node.IsTerminal)
            {
                classes.Add("is-terminal");
            }

            if (Node.IsUnreachable)
            {
                classes.Add("is-unreachable");
            }

            if (Node.InLoop)
            {
                classes.Add("in-loop");
            }

            if (Node.IsPinned)
            {
                classes.Add("is-pinned");
            }

            if (Node.Warnings.Count > 0)
            {
                classes.Add("has-warning");
            }

            if (AnswerCount > 0)
            {
                classes.Add("is-visited");
            }

            if (Run is { IsCurrent: true })
            {
                classes.Add("is-current");
            }

            return string.Join(" ", classes);
        }
    }

    /// <summary>
    /// The addition to the <c>aria-label</c> in the test run. Without it the whole run state would exist
    /// only as colour and stroke shape – so not at all for screen readers (the promise from #101: the
    /// label is the only rendering of the node).
    /// </summary>
    private string RunLabel
    {
        get
        {
            if (Run is null)
            {
                return string.Empty;
            }

            var parts = new List<string>(3);

            if (Run.IsCurrent)
            {
                parts.Add("currently open in the test run");
            }

            if (LastAnswer is { } answer)
            {
                parts.Add(LoopIteration is { } iteration
                    ? $"last answered in iteration {iteration} with {answer.Display}"
                    : $"answered with {answer.Display}");
            }

            if (Fired.Count > 0)
            {
                parts.Add($"{Fired.Count} fired trigger(s)");
            }

            return parts.Count == 0 ? string.Empty : " Test run: " + string.Join(", ", parts) + ".";
        }
    }

    private Task OnSelect() => Select.InvokeAsync(Node.QuestionId);

    private Task OnStartLink() => StartLink.InvokeAsync(Node.QuestionId);
}
