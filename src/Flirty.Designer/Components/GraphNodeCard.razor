@*
    Der Inhalt eines Knotens auf dem Graph-Canvas (#101).

    Bewusst HTML in einem <foreignObject> statt SVG-<text>: Damit ist die Karte eine echte
    Schaltfläche, und Fokusring, Enter/Leertaste sowie die Screenreader-Rolle kommen von der
    Plattform statt aus Handarbeit. Blazor unterstützt das – seine Namensraum-Prüfung schließt
    foreignObject ausdrücklich aus, Kindelemente entstehen also im HTML-Namensraum.

    Die Klassen liegen global in wwwroot/app.css, nicht in einer isolierten CSS-Datei: CSS-Isolation
    reicht ihr Scope-Attribut nicht an Kindkomponenten weiter (Kontrast-Befund aus #95).
*@
@using Flirty.Domain

<g class="graph-node @StateClasses"
   data-node-id="@Node.QuestionId"
   transform="translate(@SvgFormat.N(Node.X) @SvgFormat.N(Node.Y))">
    <foreignObject width="@SvgFormat.N(GraphMetrics.NodeWidth)" height="@SvgFormat.N(GraphMetrics.NodeHeight)">
        <button type="button"
                class="graph-node-card"
                aria-label="@(Node.AriaLabel + RunLabel)"
                aria-pressed="@(Selected ? "true" : "false")"
                title="@Node.FullText"
                @onclick="OnSelect">
            <span class="graph-node-head">
                <span class="graph-node-key">@Node.Key</span>

                @if (Run is { IsCurrent: true })
                {
                    <span class="badge badge-current" title="Diese Frage ist im Testlauf gerade offen">
                        ▶ offen
                    </span>
                }
                @if (LoopIteration is { } iteration)
                {
                    <span class="badge badge-loop" title="Iteration, in der diese Frage zuletzt beantwortet wurde">
                        Iteration @iteration
                    </span>
                }
                else if (AnswerCount > 1)
                {
                    @* Ein Zyklus OHNE Schleifen-Marker: Die Engine vergibt dann keinen Iterationsindex,
                       beantwortet wurde die Frage trotzdem mehrfach. „Iteration“ zu behaupten wäre falsch. *@
                    <span class="badge badge-loop" title="So oft wurde diese Frage im Lauf beantwortet">
                        @AnswerCount× beantwortet
                    </span>
                }
                @if (Node.IsStart)
                {
                    <span class="badge badge-start">Einstieg</span>
                }
                @if (Node.IsTerminal)
                {
                    <span class="badge badge-terminal">Abschluss</span>
                }
                @if (Node.IsUnreachable)
                {
                    <span class="badge badge-unreachable">Unerreichbar</span>
                }
                @if (Node.IsLoopBreaking)
                {
                    <span class="badge badge-loop">Breaking</span>
                }
                @if (Node.Warnings.Count > 0)
                {
                    <span class="badge badge-warning" title="@string.Join(" ", Node.Warnings.Select(w => w.Text))">
                        ⚠ @Node.Warnings.Count
                    </span>
                }
            </span>

            <span class="graph-node-text">@Node.Text</span>

            @* Im Lauf ersetzt die gegebene Antwort die Konfigurationszeile (#104): Die Karte ist auf
               ihre Höhe bemessen und schneidet Überlauf ab – beides passte nicht nebeneinander. Der Typ
               ist in einem Lauf ohnehin die uninteressantere Angabe und steht weiterhin im Inspector. *@
            @if (LastAnswer is { } answer)
            {
                <span class="graph-node-answer" title="@answer.Display">@answer.Display</span>
            }
            else
            {
                <span class="graph-node-meta">
                    <span>@Node.TypeLabel</span>
                    @if (Node.IsRequired)
                    {
                        <span class="graph-node-required">Pflicht</span>
                    }
                    @if (Node.UsesOptions)
                    {
                        <span>@Node.OptionCount Option(en)</span>
                    }
                </span>
            }

            @if (Node.Triggers.Count > 0 || Fired.Count > 0)
            {
                <span class="graph-chips">
                    @foreach (var trigger in Node.Triggers)
                    {
                        <span class="chip @(trigger.Kind == TriggerKind.Webhook ? "chip-webhook" : "chip-inprocess")"
                              title="@trigger.Title">@trigger.Label</span>
                    }
                    @* Die im Lauf publizierten Ereignisse: Sie blitzen einmal auf und bleiben danach als
                       Chip stehen.

                       Zusammengefasst je Zeitpunkt und nicht je Ereignis: Eine Schleifenfrage sammelt
                       zwei Einträge PRO Iteration (AfterAnswer und AfterQuestion), und ungebündelt sprengt
                       die Chip-Reihe nach wenigen Runden die Karte – die schneidet Überlauf ab, der Wert
                       der Antwort verschwände also. Die Einzelereignisse samt Zeit stehen im Inspector.

                       Bewusst OHNE @key: Blazor gleicht dann über die Position ab, ein neuer Zeitpunkt
                       wird ein neues Element, und dessen Entstehen startet die Animation. Ein Schlüssel
                       über die Zeit wäre zudem nicht eindeutig – zwei Notifications desselben Schritts
                       tragen denselben Zeitstempel. *@
                    @foreach (var group in FiredGroups)
                    {
                        <span class="chip chip-fired @(group.IsFresh ? "is-fresh" : "")"
                              title="@group.Title">⚡ @group.Label@(group.Count > 1 ? $" {group.Count}×" : "")</span>
                    }
                </span>
            }
        </button>
    </foreignObject>

    @if (Editable)
    {
        @* Der Port ist ein GESCHWISTER der Karte, kein Kind: Ein <button> in einem <button> ist
           ungültiges HTML, und der äußere verschluckte Klick und Fokus. Er liegt später im Markup und
           damit über der Karte – der Zeiger trifft ihn zuerst, was das JS-Modul im pointerdown
           voraussetzt (es prüft .graph-port VOR .graph-node). *@
        <foreignObject x="@SvgFormat.N((GraphMetrics.NodeWidth - GraphMetrics.PortSize) / 2)"
                       y="@SvgFormat.N(GraphMetrics.NodeHeight - (GraphMetrics.PortSize / 2))"
                       width="@SvgFormat.N(GraphMetrics.PortSize)"
                       height="@SvgFormat.N(GraphMetrics.PortSize)">
            @* Kein disabled bei laufender Geste: Blazor rendert das Attribut sonst mitten in einem Zug
               neu, und die Pointer-Capture geht dabei verloren. Gesperrt wird über data-busy am <svg>
               per CSS (pointer-events), was kein Attribut am Knoten anfasst. *@
            <button type="button"
                    class="graph-port @(IsLinkSource ? "is-active" : "")"
                    aria-label="@(IsLinkSource
                        ? $"Verbindung von {Node.Key} läuft – Zielfrage wählen oder erneut betätigen zum Abbrechen"
                        : $"Übergang von {Node.Key} ziehen – oder betätigen und dann die Zielfrage wählen")"
                    aria-pressed="@(IsLinkSource ? "true" : "false")"
                    @onclick="OnStartLink">＋</button>
        </foreignObject>
    }
</g>

@code {
    /// <summary>Der darzustellende Knoten.</summary>
    [Parameter, EditorRequired]
    public required GraphNode Node { get; set; }

    /// <summary>Ob dieser Knoten gerade im Inspector geöffnet ist.</summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>Wird ausgelöst, wenn der Knoten gewählt wird.</summary>
    [Parameter]
    public EventCallback<Guid> Select { get; set; }

    /// <summary>
    /// Ob der Graph bearbeitbar ist. Bei einer veröffentlichten Version wird der Ausgangs-Port
    /// <b>nicht gerendert</b> statt deaktiviert: Ein Port, der nichts tut, wäre irritierender als
    /// keiner – und die Engine lehnte die Geste ohnehin mit einem Konflikt ab.
    /// </summary>
    [Parameter]
    public bool Editable { get; set; }

    /// <summary>Ob gerade eine Verbindung von diesem Knoten aus gelegt wird (Tastaturpfad).</summary>
    [Parameter]
    public bool IsLinkSource { get; set; }

    /// <summary>Wird ausgelöst, wenn der Ausgangs-Port betätigt wird – der Zeigerlose Weg zu verbinden.</summary>
    [Parameter]
    public EventCallback<Guid> StartLink { get; set; }

    /// <summary>
    /// Der Laufzustand dieses Knotens im Testlauf (#104) oder <see langword="null"/> – letzteres sowohl
    /// außerhalb eines Laufs als auch für Fragen, die der Lauf nicht berührt hat.
    /// </summary>
    [Parameter]
    public GraphRunVisit? Run { get; set; }

    /// <summary>Die an dieser Frage im Lauf publizierten Trigger-Ereignisse.</summary>
    [Parameter]
    public IReadOnlyList<GraphRunTrigger> Fired { get; set; } = [];

    /// <summary>Eine Gruppe gleichartiger Ereignisse am selben Knoten.</summary>
    /// <param name="Label">Der Zeitpunkt (kurz).</param>
    /// <param name="Count">Wie oft er im Lauf ausgelöst hat.</param>
    /// <param name="IsFresh">Ob darunter ein Ereignis des letzten Schritts ist.</param>
    /// <param name="Title">Die vollständige Beschreibung für Tooltip und Screenreader.</param>
    private sealed record FiredGroup(string Label, int Count, bool IsFresh, string Title);

    /// <summary>Die Ereignisse dieses Knotens, je Zeitpunkt gebündelt.</summary>
    private IReadOnlyList<FiredGroup> FiredGroups
        =>
        [
            .. Fired
                .GroupBy(trigger => trigger.Label, StringComparer.Ordinal)
                .Select(group => new FiredGroup(
                    group.Key,
                    group.Count(),
                    group.Any(trigger => trigger.IsFresh),
                    group.Count() == 1
                        ? group.First().Title
                        : $"{group.Key}: {group.Count()}× ausgelöst, zuletzt {group.Last().Detail}")),
        ];

    /// <summary>Die zuletzt auf diese Frage gegebene Antwort des Laufs.</summary>
    private GraphRunAnswer? LastAnswer => Run?.Answers.Count > 0 ? Run.Answers[^1] : null;

    /// <summary>Wie oft die Frage im Lauf beantwortet wurde.</summary>
    private int AnswerCount => Run?.Answers.Count ?? 0;

    /// <summary>
    /// Die 1-basierte Iteration der letzten Antwort – <see langword="null"/> außerhalb einer Schleife.
    /// </summary>
    private int? LoopIteration
        => LastAnswer?.IterationIndex is { } index ? index + 1 : null;

    private string StateClasses
    {
        get
        {
            var classes = new List<string>(5);

            if (Selected)
            {
                classes.Add("is-selected");
            }

            if (IsLinkSource)
            {
                classes.Add("is-link-source");
            }

            if (Node.IsStart)
            {
                classes.Add("is-start");
            }

            if (Node.IsTerminal)
            {
                classes.Add("is-terminal");
            }

            if (Node.IsUnreachable)
            {
                classes.Add("is-unreachable");
            }

            if (Node.InLoop)
            {
                classes.Add("in-loop");
            }

            if (Node.IsPinned)
            {
                classes.Add("is-pinned");
            }

            if (Node.Warnings.Count > 0)
            {
                classes.Add("has-warning");
            }

            if (AnswerCount > 0)
            {
                classes.Add("is-visited");
            }

            if (Run is { IsCurrent: true })
            {
                classes.Add("is-current");
            }

            return string.Join(" ", classes);
        }
    }

    /// <summary>
    /// Der Zusatz zum <c>aria-label</c> im Testlauf. Ohne ihn läge der ganze Laufzustand nur als Farbe
    /// und Strichform vor – für Screenreader also gar nicht (Zusage aus #101: Das Label ist die einzige
    /// Fassung des Knotens).
    /// </summary>
    private string RunLabel
    {
        get
        {
            if (Run is null)
            {
                return string.Empty;
            }

            var parts = new List<string>(3);

            if (Run.IsCurrent)
            {
                parts.Add("im Testlauf gerade offen");
            }

            if (LastAnswer is { } answer)
            {
                parts.Add(LoopIteration is { } iteration
                    ? $"zuletzt beantwortet in Iteration {iteration} mit {answer.Display}"
                    : $"beantwortet mit {answer.Display}");
            }

            if (Fired.Count > 0)
            {
                parts.Add($"{Fired.Count} ausgelöste(r) Trigger");
            }

            return parts.Count == 0 ? string.Empty : " Testlauf: " + string.Join(", ", parts) + ".";
        }
    }

    private Task OnSelect() => Select.InvokeAsync(Node.QuestionId);

    private Task OnStartLink() => StartLink.InvokeAsync(Node.QuestionId);
}
