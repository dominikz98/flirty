@*
    The transition branch of the graph inspector (#103).

    The loop suggestion also stands here: a back-jump without a matching marker is offered AT THE CYCLE –
    at the edge that causes it – instead of in a list at the bottom of the page (#41 offered it there). The
    prefill is the same: target of the back-jump = entry, source question = breaking question, key from
    LoopFormModel.SuggestCollectionKey.

    Changing the source question stays reserved for the TransitionEditor: it reassigns the priority in the
    new group, and this rule should not stand in two places.
*@
@using Flirty.Runtime.Admin

<h2>Transition</h2>
<p class="graph-inspector-key mono">
    @KeyOf(Edge.FromQuestionId) → @KeyOf(Edge.TargetQuestionId)
</p>

@foreach (var warning in Edge.Warnings)
{
    <div class="banner warn">@warning.Text</div>
}

<dl class="graph-facts">
    <dt>Evaluation</dt>
    <dd>Position @Edge.Position</dd>
    <dt>Kind</dt>
    <dd>@Role</dd>
</dl>

@* Raw fields instead of EditForm – the same rationale as in the GraphQuestionPanel: the panel is rebuilt
   after every gesture, and the submit of an EditForm did not arrive in it. *@
<div class="field">
    <label for="inspectorTarget">Target question</label>
    <select id="inspectorTarget" class="input" disabled="@Locked" @onchange="OnTargetChanged">
        <option value="">— choose —</option>
        @foreach (var question in Detail.Questions)
        {
            <option value="@question.Id" selected="@(question.Id == _form.TargetQuestionId)">
                @question.Key — @question.Text
            </option>
        }
    </select>
</div>

<div class="field check">
    <input id="inspectorDefault" type="checkbox" disabled="@Locked"
           checked="@_form.IsDefault" @onchange="OnDefaultChanged" />
    <label for="inspectorDefault">Default transition</label>
</div>
    <span class="hint">
        The default matches when <em>no</em> conditional transition applies. Its own condition is
        <strong>not</strong> evaluated in the process.
    </span>

    @if (_form.IsDefault && !string.IsNullOrWhiteSpace(_form.Expression))
    {
        <div class="banner warn">
            This transition is marked as default – its condition is not evaluated at runtime. Either
            remove the default check or clear the condition.
        </div>
    }

    <h3 class="graph-inspector-section">Condition</h3>

    @* The snippet inserter and the identifier table stay off in the panel: the column is narrow, and the
       transition editor is one jump away. The live validation – the actual value – is the same as there,
       because it is the same component. *@
    <ExpressionField Detail="Detail"
                     @bind-Value="_form.Expression"
                     Disabled="@Locked"
                     ShowBuilder="false"
                     FieldId="inspectorExpression"
                     EmptyHint="matches unconditionally"
                     EmptyMeaning="the transition always matches" />

@if (_formError is not null)
{
    <div class="banner err">@_formError</div>
}

<div class="actions">
    <button class="btn btn-primary" disabled="@Locked" @onclick="SaveAsync">Save</button>
    <button class="btn" disabled="@Locked" @onclick="ResetForm">Reset</button>
</div>

@if (IsUnmarkedBackJump && Editable)
{
    <h3 class="graph-inspector-section">Loop</h3>
    <div class="banner warn">
        Back-jump without a loop marker: the answers of this cycle are
        <strong>overwritten</strong> at runtime instead of collected per iteration.
    </div>

    <div class="field">
        <label for="inspectorCollectionKey">Collection key</label>
        <input id="inspectorCollectionKey" class="input mono" @bind="_collectionKey" disabled="@Busy" />
        <span class="hint">
            Under this identifier the answers collected per iteration sit in the expression context.
        </span>
    </div>

    <div class="actions">
        <button class="btn" disabled="@(Busy || string.IsNullOrWhiteSpace(_collectionKey))"
                @onclick="CreateLoopAsync">Mark as loop</button>
    </div>
}

<div class="actions">
    <button class="btn btn-primary" @onclick="() => OpenTransition.InvokeAsync(Edge.TransitionId)">
        Edit transition →
    </button>
    <button class="btn" @onclick="() => SelectQuestion.InvokeAsync(Edge.FromQuestionId)">
        To source question
    </button>
    <button class="btn" @onclick="() => SelectQuestion.InvokeAsync(Edge.TargetQuestionId)">
        To target question
    </button>
</div>

@if (Editable)
{
    <h3 class="graph-inspector-section">Delete transition</h3>

    @if (_confirmDelete)
    {
        <span class="confirm">Delete transition? The questions involved remain.</span>
        <div class="actions">
            <button class="btn btn-danger" disabled="@Busy" @onclick="DeleteAsync">Yes, delete</button>
            <button class="btn" @onclick="() => _confirmDelete = false">Cancel</button>
        </div>
    }
    else
    {
        <div class="actions">
            <button class="btn btn-danger" disabled="@Busy"
                    @onclick="() => _confirmDelete = true">Delete</button>
        </div>
    }
}

@code {
    /// <summary>The dialog including graph.</summary>
    [Parameter, EditorRequired]
    public required DialogDetail Detail { get; set; }

    /// <summary>The selected edge.</summary>
    [Parameter, EditorRequired]
    public required GraphEdge Edge { get; set; }

    /// <summary>Whether this back-jump does not yet have a matching loop marker.</summary>
    [Parameter]
    public bool IsUnmarkedBackJump { get; set; }

    /// <summary>Whether the graph is editable (unpublished version).</summary>
    [Parameter]
    public bool Editable { get; set; }

    /// <summary>Whether a gesture is currently running.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Reports changed fields of the transition.</summary>
    [Parameter]
    public EventCallback<TransitionEdit> Save { get; set; }

    /// <summary>Reports the confirmed deletion wish.</summary>
    [Parameter]
    public EventCallback<Guid> Delete { get; set; }

    /// <summary>Reports a loop marker derived from this back-jump.</summary>
    [Parameter]
    public EventCallback<LoopDraft> CreateLoop { get; set; }

    /// <summary>Selects a question on the canvas.</summary>
    [Parameter]
    public EventCallback<Guid> SelectQuestion { get; set; }

    /// <summary>Jumps into the transition editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenTransition { get; set; }

    private TransitionFormModel _form = new();
    private string _collectionKey = string.Empty;
    private string? _formError;
    private bool _confirmDelete;
    private Guid _shownFor;

    private bool Locked => !Editable || Busy;

    private string Role
    {
        get
        {
            var roles = new List<string>(2);

            if (Edge.IsDefault)
            {
                roles.Add("Default transition");
            }

            if (Edge.IsBackJump)
            {
                roles.Add("Back-jump (cycle)");
            }

            return roles.Count == 0 ? "conditional transition" : string.Join(", ", roles);
        }
    }

    protected override void OnParametersSet()
    {
        if (_shownFor != Edge.TransitionId)
        {
            _shownFor = Edge.TransitionId;
            _confirmDelete = false;
            ResetForm();

            var entry = Detail.Questions.FirstOrDefault(
                question => question.Id == Edge.TargetQuestionId);

            _collectionKey = entry is null
                ? string.Empty
                : LoopFormModel.SuggestCollectionKey(entry.Key, Detail);
        }
    }

    private void ResetForm()
    {
        var transition = Detail.Transitions.FirstOrDefault(
            candidate => candidate.Id == Edge.TransitionId);

        _form = transition is null ? new TransitionFormModel() : TransitionFormModel.From(transition);
        _formError = null;
    }

    private void OnTargetChanged(ChangeEventArgs args)
        => _form.TargetQuestionId = Guid.TryParse(args.Value?.ToString(), out var target) ? target : null;

    private void OnDefaultChanged(ChangeEventArgs args) => _form.IsDefault = args.Value is true;

    private async Task SaveAsync()
    {
        if (_form.TargetQuestionId is not { } target)
        {
            _formError = "Please choose a target question.";
            return;
        }

        _formError = null;
        await Save.InvokeAsync(new TransitionEdit(
            Edge.TransitionId, target, _form.NormalizedExpression(), _form.IsDefault));
    }

    private async Task CreateLoopAsync()
        => await CreateLoop.InvokeAsync(
            new LoopDraft(_collectionKey.Trim(), Edge.TargetQuestionId, Edge.FromQuestionId));

    private async Task DeleteAsync()
    {
        _confirmDelete = false;
        await Delete.InvokeAsync(Edge.TransitionId);
    }

    private string KeyOf(Guid questionId)
        => Detail.Questions.FirstOrDefault(question => question.Id == questionId)?.Key ?? "unknown";
}
