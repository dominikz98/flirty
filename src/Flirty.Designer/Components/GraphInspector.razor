@*
    Das Inspector-Panel der Graph-Ansicht: zeigt das gewählte Element – und bearbeitet es seit #103.

    #101 hatte hier bewusst eine reine Lesesicht mit Sprung in die vier @page-Editoren, weil deren
    Einbetten ihren Umbau bedeutet hätte. #103 dreht das zur Hälfte um: Eingebettet werden NICHT die
    @page-Editoren, sondern eigene Panels, die dieselben Admin-Commands rufen. Die Grenze verläuft
    entlang der Datenform – skalare Felder hier, eigene Unterstruktur (Antwortoptionen,
    Validierungsregeln, Roh-JSON) im Vollteditor. „… bearbeiten →" führt weiterhin dorthin.

    Das Panel ist zugleich der Tastaturpfad zu allem, was auf der Fläche eine Zeiger-Geste ist: Kanten
    sind nicht fokussierbar (45 Tabstopps wären eine Wüste), Verbinden geht hier über eine Auswahlliste,
    und die Auswertungsreihenfolge wird ohnehin nur hier gepflegt – eine Position darf keine Semantik
    tragen.
*@
@using Flirty.Domain
@using Flirty.Runtime.Admin

<aside class="graph-inspector" aria-label="Details zum gewählten Element">
    @if (Selection is null)
    {
        <h2>Inspector</h2>
        <p class="hint">
            Einen Knoten oder eine Kante wählen – hier erscheinen dann die Details und der Sprung in den
            passenden Editor.
        </p>

        <h3 class="graph-inspector-section">Legende</h3>
        <ul class="graph-legend">
            <li><span class="badge badge-start">Einstieg</span> Startfrage des Dialogs</li>
            <li><span class="badge badge-terminal">Abschluss</span> kein ausgehender Übergang – der Dialog endet hier</li>
            <li><span class="badge badge-unreachable">Unerreichbar</span> kein Pfad von der Einstiegsfrage</li>
            <li><span class="badge badge-loop">Breaking</span> Breaking Question einer Schleife</li>
            <li><span class="badge badge-default">Default</span> greift, wenn keine Bedingung zutrifft</li>
        </ul>

        @* Die Trigger ohne Frage-Bezug haben auf der Fläche keinen dauerhaften Ort: Die Scope-Marker
           entstehen erst, WENN sie Trigger tragen (#101 – „der Canvas bleibt frei von Leerformen").
           Deshalb stehen sie hier, im Zweig ohne Auswahl, und nicht an einem Marker, den es noch nicht
           gibt. Ist einer da, führt sein Chip in den Trigger-Editor. *@
        <h3 class="graph-inspector-section">Trigger am Dialog</h3>

        @if (DialogTriggers.Count == 0)
        {
            <p class="hint">Keine – beim Start, nach jeder Antwort und am Ende wird nichts ausgelöst.</p>
        }
        else
        {
            <ul class="graph-inspector-list">
                @foreach (var trigger in DialogTriggers)
                {
                    var current = trigger;
                    <li>
                        <button class="btn" @onclick="() => OpenTrigger.InvokeAsync(current.Id)">
                            @TriggerLabels.Describe(current.Scope) · @TriggerLabels.Describe(current.Kind)
                        </button>
                    </li>
                }
            </ul>
        }

        @if (Editable)
        {
            @if (_newTrigger is null)
            {
                <div class="actions">
                    <button class="btn" @onclick="() => _newTrigger = new TriggerFormModel()">
                        Dialog-Trigger anlegen
                    </button>
                </div>
            }
            else
            {
                <div class="field">
                    <label for="dialogTriggerScope">Zeitpunkt</label>
                    <select id="dialogTriggerScope" class="input" @bind="_newTrigger.Scope">
                        @foreach (var scope in DialogScopes)
                        {
                            <option value="@scope">@TriggerLabels.Describe(scope)</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label for="dialogTriggerKind">Kanal</label>
                    <select id="dialogTriggerKind" class="input" @bind="_newTrigger.Kind">
                        @foreach (var kind in Enum.GetValues<TriggerKind>())
                        {
                            <option value="@kind">@TriggerLabels.Describe(kind)</option>
                        }
                    </select>
                </div>

                @if (_newTrigger.Kind == TriggerKind.Webhook)
                {
                    <div class="field">
                        <label for="dialogTriggerUrl">Ziel-URL</label>
                        <input id="dialogTriggerUrl" class="input mono" @bind="_newTrigger.Url" />
                        <span class="hint">Absolute URL – die Engine lehnt alles andere ab.</span>
                    </div>
                }
                else
                {
                    <p class="hint">
                        In-Process stellt <b>nichts</b> zu: Die Host-Anwendung hängt dafür einen eigenen
                        <span class="mono">INotificationHandler</span> ein.
                    </p>
                }

                <div class="field">
                    <label for="dialogTriggerName">Ereignisname (optional)</label>
                    <input id="dialogTriggerName" class="input" @bind="_newTrigger.Name" />
                </div>

                @if (_triggerError is not null)
                {
                    <div class="banner err">@_triggerError</div>
                }

                <div class="actions">
                    <button class="btn btn-primary" disabled="@Busy"
                            @onclick="CreateDialogTriggerAsync">Anlegen</button>
                    <button class="btn"
                            @onclick="() => { _newTrigger = null; _triggerError = null; }">Abbrechen</button>
                </div>
            }
        }
    }
    else if (SelectedNode is { } node)
    {
        @* Das @key bindet die Panel-Instanz an das bearbeitete Element. Ohne es verwirft Blazor sie beim
           nächsten Diff und der begonnene Formular-Entwurf ist weg – sichtbar daran, dass ein getippter
           Schlüssel nach dem Reload wieder auf dem gespeicherten Wert stand. Mit ihm überlebt der
           Entwurf jeden Re-Render derselben Frage und wird beim Wechsel bewusst verworfen. *@
        <GraphQuestionPanel @key="node.QuestionId"
                            Detail="Detail"
                            Node="node"
                            Outgoing="Outgoing(node.QuestionId)"
                            Incoming="Incoming(node.QuestionId)"
                            Editable="Editable"
                            Busy="Busy"
                            Save="SaveQuestion"
                            SetStart="SetStartQuestion"
                            Move="MoveTransition"
                            ToggleDefault="ToggleDefault"
                            Connect="Connect"
                            AddTrigger="AddTrigger"
                            Delete="DeleteQuestion"
                            SelectTransition="SelectTransition"
                            OpenQuestion="OpenQuestion"
                            OpenTrigger="OpenTrigger" />
    }
    else if (SelectedEdge is { } edge)
    {
        <GraphTransitionPanel @key="edge.TransitionId"
                              Detail="Detail"
                              Edge="edge"
                              IsUnmarkedBackJump="@UnmarkedBackJumps.Contains(edge.TransitionId)"
                              Editable="Editable"
                              Busy="Busy"
                              Save="SaveTransition"
                              Delete="DeleteTransition"
                              CreateLoop="CreateLoop"
                              SelectQuestion="SelectQuestion"
                              OpenTransition="OpenTransition" />
    }
    else if (SelectedLoop is { } loop)
    {
        <h2>Schleife</h2>
        <p class="graph-inspector-key mono">@loop.CollectionKey</p>

        <dl class="graph-facts">
            <dt>Einstieg</dt>
            <dd class="mono">@(string.IsNullOrEmpty(loop.EntryKey) ? "— fehlt —" : loop.EntryKey)</dd>
            <dt>Breaking Question</dt>
            <dd class="mono">@(string.IsNullOrEmpty(loop.BreakingKey) ? "— fehlt —" : loop.BreakingKey)</dd>
        </dl>

        @foreach (var warning in loop.Warnings)
        {
            <div class="banner warn">@warning.Text</div>
        }

        <div class="actions">
            <button class="btn btn-primary" @onclick="() => OpenLoop.InvokeAsync(loop.LoopId)">
                Schleife bearbeiten →
            </button>
        </div>

        @if (Editable)
        {
            <h3 class="graph-inspector-section">Marker löschen</h3>

            @if (_confirmDeleteLoop)
            {
                <span class="confirm">
                    Schleifen-Marker löschen? Der Zyklus selbst bleibt bestehen – seine Antworten werden
                    danach überschrieben statt gesammelt.
                </span>
                <div class="actions">
                    <button class="btn btn-danger" disabled="@Busy"
                            @onclick="() => DeleteLoopAsync(loop.LoopId)">Ja, löschen</button>
                    <button class="btn" @onclick="() => _confirmDeleteLoop = false">Abbrechen</button>
                </div>
            }
            else
            {
                <div class="actions">
                    <button class="btn btn-danger" disabled="@Busy"
                            @onclick="() => _confirmDeleteLoop = true">Löschen</button>
                </div>
            }
        }
    }
</aside>

@code {
    /// <summary>Der gesamte Graph – der Inspector liest daraus die Nachbarschaft des gewählten Elements.</summary>
    [Parameter, EditorRequired]
    public required DialogGraphModel Model { get; set; }

    /// <summary>Der Dialog samt Graph – Datenquelle der eingebetteten Formulare.</summary>
    [Parameter, EditorRequired]
    public required DialogDetail Detail { get; set; }

    /// <summary>Das gewählte Element oder <see langword="null"/>.</summary>
    [Parameter]
    public GraphSelection? Selection { get; set; }

    /// <summary>Ob der Graph bearbeitbar ist (unveröffentlichte Version).</summary>
    [Parameter]
    public bool Editable { get; set; }

    /// <summary>Ob gerade eine Geste läuft.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Die Rücksprünge ohne passenden Schleifen-Marker – von der Seite einmal gerechnet.</summary>
    [Parameter]
    public IReadOnlyList<Guid> UnmarkedBackJumps { get; set; } = [];

    /// <summary>Springt in den Frage-Editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenQuestion { get; set; }

    /// <summary>Springt in den Übergangs-Editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenTransition { get; set; }

    /// <summary>Springt in den Loop-Editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenLoop { get; set; }

    /// <summary>Springt in den Trigger-Editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenTrigger { get; set; }

    /// <summary>Wählt eine andere Frage auf dem Canvas aus.</summary>
    [Parameter]
    public EventCallback<Guid> SelectQuestion { get; set; }

    /// <summary>Wählt eine Kante auf dem Canvas aus.</summary>
    [Parameter]
    public EventCallback<Guid> SelectTransition { get; set; }

    /// <summary>Meldet geänderte Kopffelder einer Frage.</summary>
    [Parameter]
    public EventCallback<QuestionEdit> SaveQuestion { get; set; }

    /// <summary>Meldet den Wunsch, die gewählte Frage zur Einstiegsfrage des Dialogs zu machen.</summary>
    [Parameter]
    public EventCallback<Guid> SetStartQuestion { get; set; }

    /// <summary>Meldet den bestätigten Löschwunsch einer Frage.</summary>
    [Parameter]
    public EventCallback<Guid> DeleteQuestion { get; set; }

    /// <summary>Meldet eine Umsortierung der Auswertungsreihenfolge.</summary>
    [Parameter]
    public EventCallback<TransitionMove> MoveTransition { get; set; }

    /// <summary>Meldet das Umschalten der Default-Kennzeichnung.</summary>
    [Parameter]
    public EventCallback<Guid> ToggleDefault { get; set; }

    /// <summary>Meldet einen neuen Übergang von der gewählten Frage zum gewählten Ziel.</summary>
    [Parameter]
    public EventCallback<Guid> Connect { get; set; }

    /// <summary>Meldet geänderte Felder eines Übergangs.</summary>
    [Parameter]
    public EventCallback<TransitionEdit> SaveTransition { get; set; }

    /// <summary>Meldet den bestätigten Löschwunsch eines Übergangs.</summary>
    [Parameter]
    public EventCallback<Guid> DeleteTransition { get; set; }

    /// <summary>Meldet einen aus einem Rücksprung abgeleiteten Schleifen-Marker.</summary>
    [Parameter]
    public EventCallback<LoopDraft> CreateLoop { get; set; }

    /// <summary>Meldet den bestätigten Löschwunsch eines Schleifen-Markers.</summary>
    [Parameter]
    public EventCallback<Guid> DeleteLoop { get; set; }

    /// <summary>Meldet einen neuen Trigger nach einer Frage.</summary>
    [Parameter]
    public EventCallback<TriggerDraft> AddTrigger { get; set; }

    /// <summary>Meldet einen neuen Trigger ohne Frage-Bezug.</summary>
    [Parameter]
    public EventCallback<TriggerDraft> AddDialogTrigger { get; set; }

    /// <summary>Die Zeitpunkte ohne Frage-Bezug – <c>AfterQuestion</c> entsteht am Knoten.</summary>
    private static readonly TriggerScope[] DialogScopes =
        [.. Enum.GetValues<TriggerScope>().Where(scope => !TriggerLabels.RequiresQuestion(scope))];

    private TriggerFormModel? _newTrigger;
    private string? _triggerError;
    private bool _confirmDeleteLoop;

    private GraphNode? SelectedNode
        => Selection is { Kind: GraphElementKind.Question } selection ? Model.Node(selection.Id) : null;

    private GraphEdge? SelectedEdge
        => Selection is { Kind: GraphElementKind.Transition } selection ? Model.Edge(selection.Id) : null;

    private GraphLoopFrame? SelectedLoop
        => Selection is { Kind: GraphElementKind.Loop } selection
            ? Model.Loops.FirstOrDefault(loop => loop.LoopId == selection.Id)
            : null;

    private IReadOnlyList<TriggerDetail> DialogTriggers
        => [.. Detail.Triggers.Where(trigger => !TriggerLabels.RequiresQuestion(trigger.Scope))];

    private IReadOnlyList<GraphEdge> Outgoing(Guid questionId)
        => [.. Model.Edges
            .Where(edge => edge.FromQuestionId == questionId)
            .OrderBy(edge => edge.Position)];

    private IReadOnlyList<GraphEdge> Incoming(Guid questionId)
        => [.. Model.Edges.Where(edge => edge.TargetQuestionId == questionId)];

    private async Task CreateDialogTriggerAsync()
    {
        if (_newTrigger is null)
        {
            return;
        }

        if (!_newTrigger.TryBuildConfig(out var config, out var configError))
        {
            _triggerError = configError;
            return;
        }

        var draft = new TriggerDraft(_newTrigger.Scope, null, _newTrigger.Kind, config);

        _newTrigger = null;
        _triggerError = null;
        await AddDialogTrigger.InvokeAsync(draft);
    }

    private async Task DeleteLoopAsync(Guid loopId)
    {
        _confirmDeleteLoop = false;
        await DeleteLoop.InvokeAsync(loopId);
    }
}
