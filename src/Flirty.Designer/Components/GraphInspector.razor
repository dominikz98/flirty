@*
    The inspector panel of the graph view: shows the selected element – and edits it since #103.

    #101 deliberately had a pure read view here with a jump into the four @page editors, because
    embedding them would have meant rebuilding them. #103 turns that half around: embedded are NOT the
    @page editors, but dedicated panels that call the same admin commands. The boundary runs along the
    data shape – scalar fields here, own substructure (answer options, validation rules, raw JSON) in the
    full editor. "… edit →" still leads there.

    The panel is at the same time the keyboard path to everything that is a pointer gesture on the
    surface: edges are not focusable (45 tab stops would be a desert), connecting goes through a select
    list here, and the evaluation order is maintained only here anyway – a position must not carry
    semantics.
*@
@using Flirty.Domain
@using Flirty.Runtime.Admin

<aside class="graph-inspector" aria-label="Details of the selected element">
    @if (Selection is null)
    {
        <h2>Inspector</h2>
        <p class="hint">
            Select a node or an edge – the details and the jump into the matching editor then appear
            here.
        </p>

        <h3 class="graph-inspector-section">Legend</h3>
        <ul class="graph-legend">
            <li><span class="badge badge-start">Entry</span> start question of the dialog</li>
            <li><span class="badge badge-terminal">Terminal</span> no outgoing transition – the dialog ends here</li>
            <li><span class="badge badge-unreachable">Unreachable</span> no path from the entry question</li>
            <li><span class="badge badge-loop">Breaking</span> breaking question of a loop</li>
            <li><span class="badge badge-default">Default</span> matches when no condition applies</li>
        </ul>

        @* The triggers without a question reference have no permanent place on the surface: the scope
           markers arise only WHEN they carry triggers (#101 – "the canvas stays free of empty forms").
           That is why they stand here, in the branch without a selection, and not on a marker that does
           not yet exist. If one is there, its chip leads into the trigger editor. *@
        <h3 class="graph-inspector-section">Triggers on the dialog</h3>

        @if (DialogTriggers.Count == 0)
        {
            <p class="hint">None – nothing is fired at start, after each answer or at the end.</p>
        }
        else
        {
            <ul class="graph-inspector-list">
                @foreach (var trigger in DialogTriggers)
                {
                    var current = trigger;
                    <li>
                        <button class="btn" @onclick="() => OpenTrigger.InvokeAsync(current.Id)">
                            @TriggerLabels.Describe(current.Scope) · @TriggerLabels.Describe(current.Kind)
                        </button>
                    </li>
                }
            </ul>
        }

        @if (Editable)
        {
            @if (_newTrigger is null)
            {
                <div class="actions">
                    <button class="btn" @onclick="() => _newTrigger = new TriggerFormModel()">
                        Create dialog trigger
                    </button>
                </div>
            }
            else
            {
                <div class="field">
                    <label for="dialogTriggerScope">Timing</label>
                    <select id="dialogTriggerScope" class="input" @bind="_newTrigger.Scope">
                        @foreach (var scope in DialogScopes)
                        {
                            <option value="@scope">@TriggerLabels.Describe(scope)</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label for="dialogTriggerKind">Channel</label>
                    <select id="dialogTriggerKind" class="input" @bind="_newTrigger.Kind">
                        @foreach (var kind in Enum.GetValues<TriggerKind>())
                        {
                            <option value="@kind">@TriggerLabels.Describe(kind)</option>
                        }
                    </select>
                </div>

                @if (_newTrigger.Kind == TriggerKind.Webhook)
                {
                    <div class="field">
                        <label for="dialogTriggerUrl">Target URL</label>
                        <input id="dialogTriggerUrl" class="input mono" @bind="_newTrigger.Url" />
                        <span class="hint">Absolute URL – the engine rejects anything else.</span>
                    </div>
                }
                else
                {
                    <p class="hint">
                        In-process delivers <b>nothing</b>: the host application plugs in its own
                        <span class="mono">INotificationHandler</span> for that.
                    </p>
                }

                <div class="field">
                    <label for="dialogTriggerName">Event name (optional)</label>
                    <input id="dialogTriggerName" class="input" @bind="_newTrigger.Name" />
                </div>

                @if (_triggerError is not null)
                {
                    <div class="banner err">@_triggerError</div>
                }

                <div class="actions">
                    <button class="btn btn-primary" disabled="@Busy"
                            @onclick="CreateDialogTriggerAsync">Create</button>
                    <button class="btn"
                            @onclick="() => { _newTrigger = null; _triggerError = null; }">Cancel</button>
                </div>
            }
        }
    }
    else if (SelectedNode is { } node)
    {
        @* The @key binds the panel instance to the edited element. Without it Blazor discards it on the
           next diff and the started form draft is gone – visible in that a typed key stood on the saved
           value again after the reload. With it the draft survives every re-render of the same question
           and is deliberately discarded on a switch. *@
        <GraphQuestionPanel @key="node.QuestionId"
                            Detail="Detail"
                            Node="node"
                            Outgoing="Outgoing(node.QuestionId)"
                            Incoming="Incoming(node.QuestionId)"
                            Editable="Editable"
                            Busy="Busy"
                            Save="SaveQuestion"
                            SetStart="SetStartQuestion"
                            Move="MoveTransition"
                            ToggleDefault="ToggleDefault"
                            Connect="Connect"
                            AddTrigger="AddTrigger"
                            Delete="DeleteQuestion"
                            SelectTransition="SelectTransition"
                            OpenQuestion="OpenQuestion"
                            OpenTrigger="OpenTrigger" />
    }
    else if (SelectedEdge is { } edge)
    {
        <GraphTransitionPanel @key="edge.TransitionId"
                              Detail="Detail"
                              Edge="edge"
                              IsUnmarkedBackJump="@UnmarkedBackJumps.Contains(edge.TransitionId)"
                              Editable="Editable"
                              Busy="Busy"
                              Save="SaveTransition"
                              Delete="DeleteTransition"
                              CreateLoop="CreateLoop"
                              SelectQuestion="SelectQuestion"
                              OpenTransition="OpenTransition" />
    }
    else if (SelectedLoop is { } loop)
    {
        <h2>Loop</h2>
        <p class="graph-inspector-key mono">@loop.CollectionKey</p>

        <dl class="graph-facts">
            <dt>Entry</dt>
            <dd class="mono">@(string.IsNullOrEmpty(loop.EntryKey) ? "— missing —" : loop.EntryKey)</dd>
            <dt>Breaking question</dt>
            <dd class="mono">@(string.IsNullOrEmpty(loop.BreakingKey) ? "— missing —" : loop.BreakingKey)</dd>
        </dl>

        @foreach (var warning in loop.Warnings)
        {
            <div class="banner warn">@warning.Text</div>
        }

        <div class="actions">
            <button class="btn btn-primary" @onclick="() => OpenLoop.InvokeAsync(loop.LoopId)">
                Edit loop →
            </button>
        </div>

        @if (Editable)
        {
            <h3 class="graph-inspector-section">Delete marker</h3>

            @if (_confirmDeleteLoop)
            {
                <span class="confirm">
                    Delete loop marker? The cycle itself remains – its answers are then overwritten
                    instead of collected.
                </span>
                <div class="actions">
                    <button class="btn btn-danger" disabled="@Busy"
                            @onclick="() => DeleteLoopAsync(loop.LoopId)">Yes, delete</button>
                    <button class="btn" @onclick="() => _confirmDeleteLoop = false">Cancel</button>
                </div>
            }
            else
            {
                <div class="actions">
                    <button class="btn btn-danger" disabled="@Busy"
                            @onclick="() => _confirmDeleteLoop = true">Delete</button>
                </div>
            }
        }
    }
</aside>

@code {
    /// <summary>The whole graph – the inspector reads the neighbourhood of the selected element from it.</summary>
    [Parameter, EditorRequired]
    public required DialogGraphModel Model { get; set; }

    /// <summary>The dialog including graph – data source of the embedded forms.</summary>
    [Parameter, EditorRequired]
    public required DialogDetail Detail { get; set; }

    /// <summary>The selected element or <see langword="null"/>.</summary>
    [Parameter]
    public GraphSelection? Selection { get; set; }

    /// <summary>Whether the graph is editable (unpublished version).</summary>
    [Parameter]
    public bool Editable { get; set; }

    /// <summary>Whether a gesture is currently running.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>The back-jumps without a matching loop marker – computed once by the page.</summary>
    [Parameter]
    public IReadOnlyList<Guid> UnmarkedBackJumps { get; set; } = [];

    /// <summary>Jumps into the question editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenQuestion { get; set; }

    /// <summary>Jumps into the transition editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenTransition { get; set; }

    /// <summary>Jumps into the loop editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenLoop { get; set; }

    /// <summary>Jumps into the trigger editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenTrigger { get; set; }

    /// <summary>Selects a different question on the canvas.</summary>
    [Parameter]
    public EventCallback<Guid> SelectQuestion { get; set; }

    /// <summary>Selects an edge on the canvas.</summary>
    [Parameter]
    public EventCallback<Guid> SelectTransition { get; set; }

    /// <summary>Reports changed header fields of a question.</summary>
    [Parameter]
    public EventCallback<QuestionEdit> SaveQuestion { get; set; }

    /// <summary>Reports the wish to make the selected question the entry question of the dialog.</summary>
    [Parameter]
    public EventCallback<Guid> SetStartQuestion { get; set; }

    /// <summary>Reports the confirmed deletion wish of a question.</summary>
    [Parameter]
    public EventCallback<Guid> DeleteQuestion { get; set; }

    /// <summary>Reports a reordering of the evaluation order.</summary>
    [Parameter]
    public EventCallback<TransitionMove> MoveTransition { get; set; }

    /// <summary>Reports the toggling of the default marking.</summary>
    [Parameter]
    public EventCallback<Guid> ToggleDefault { get; set; }

    /// <summary>Reports a new transition from the selected question to the selected target.</summary>
    [Parameter]
    public EventCallback<Guid> Connect { get; set; }

    /// <summary>Reports changed fields of a transition.</summary>
    [Parameter]
    public EventCallback<TransitionEdit> SaveTransition { get; set; }

    /// <summary>Reports the confirmed deletion wish of a transition.</summary>
    [Parameter]
    public EventCallback<Guid> DeleteTransition { get; set; }

    /// <summary>Reports a loop marker derived from a back-jump.</summary>
    [Parameter]
    public EventCallback<LoopDraft> CreateLoop { get; set; }

    /// <summary>Reports the confirmed deletion wish of a loop marker.</summary>
    [Parameter]
    public EventCallback<Guid> DeleteLoop { get; set; }

    /// <summary>Reports a new trigger after a question.</summary>
    [Parameter]
    public EventCallback<TriggerDraft> AddTrigger { get; set; }

    /// <summary>Reports a new trigger without a question reference.</summary>
    [Parameter]
    public EventCallback<TriggerDraft> AddDialogTrigger { get; set; }

    /// <summary>The timings without a question reference – <c>AfterQuestion</c> arises on the node.</summary>
    private static readonly TriggerScope[] DialogScopes =
        [.. Enum.GetValues<TriggerScope>().Where(scope => !TriggerLabels.RequiresQuestion(scope))];

    private TriggerFormModel? _newTrigger;
    private string? _triggerError;
    private bool _confirmDeleteLoop;

    private GraphNode? SelectedNode
        => Selection is { Kind: GraphElementKind.Question } selection ? Model.Node(selection.Id) : null;

    private GraphEdge? SelectedEdge
        => Selection is { Kind: GraphElementKind.Transition } selection ? Model.Edge(selection.Id) : null;

    private GraphLoopFrame? SelectedLoop
        => Selection is { Kind: GraphElementKind.Loop } selection
            ? Model.Loops.FirstOrDefault(loop => loop.LoopId == selection.Id)
            : null;

    private IReadOnlyList<TriggerDetail> DialogTriggers
        => [.. Detail.Triggers.Where(trigger => !TriggerLabels.RequiresQuestion(trigger.Scope))];

    private IReadOnlyList<GraphEdge> Outgoing(Guid questionId)
        => [.. Model.Edges
            .Where(edge => edge.FromQuestionId == questionId)
            .OrderBy(edge => edge.Position)];

    private IReadOnlyList<GraphEdge> Incoming(Guid questionId)
        => [.. Model.Edges.Where(edge => edge.TargetQuestionId == questionId)];

    private async Task CreateDialogTriggerAsync()
    {
        if (_newTrigger is null)
        {
            return;
        }

        if (!_newTrigger.TryBuildConfig(out var config, out var configError))
        {
            _triggerError = configError;
            return;
        }

        var draft = new TriggerDraft(_newTrigger.Scope, null, _newTrigger.Kind, config);

        _newTrigger = null;
        _triggerError = null;
        await AddDialogTrigger.InvokeAsync(draft);
    }

    private async Task DeleteLoopAsync(Guid loopId)
    {
        _confirmDeleteLoop = false;
        await DeleteLoop.InvokeAsync(loopId);
    }
}
