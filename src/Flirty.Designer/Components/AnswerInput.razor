@* Input field for an answer in the test runner (#43) – the control that fits each question type. Used by
   the current question AND by editing an earlier answer, hence a component. *@
@using Flirty.Domain
@using Flirty.Designer.Models
@using Flirty.Designer.Services
@using Flirty.Validation
@inject FlirtyQuestionTypeRegistry QuestionTypes

<div class="answer-input">
    @if (Type == QuestionType.SingleChoice)
    {
        @foreach (var option in Options)
        {
            // Local copy: the lambda would otherwise run against the loop state after the last iteration.
            var choice = option;

            <button type="button" class="btn btn-primary" disabled="@Disabled"
                    @onclick="() => ChooseAsync(choice.Value)">
                @choice.Label
            </button>
        }

        @if (Options.Count == 0)
        {
            <span class="hint">The question has no answer options – so it cannot be answered.</span>
        }
    }
    else if (Type == QuestionType.Boolean)
    {
        <button type="button" class="btn btn-primary" disabled="@Disabled" @onclick="ChooseYesAsync">Yes</button>
        <button type="button" class="btn btn-primary" disabled="@Disabled" @onclick="ChooseNoAsync">No</button>
    }
    else if (Type == QuestionType.MultiChoice)
    {
        @foreach (var option in Options)
        {
            var choice = option;

            <label class="choice">
                <input type="checkbox" disabled="@Disabled"
                       checked="@Input.Selected.Contains(choice.Value)"
                       @onchange="args => Input.Toggle(choice.Value, args.Value is true)" />
                @choice.Label
            </label>
        }

        @if (Options.Count == 0)
        {
            <span class="hint">The question has no answer options – so it cannot be answered.</span>
        }

        <button type="button" class="btn btn-primary" disabled="@(Disabled || !Input.CanSubmit)"
                @onclick="OnSubmit">
            @SubmitLabel
        </button>
    }
    else if (Type == QuestionType.Json)
    {
        @* A raw JSON field rather than a form generated from the type (#137). The designer knows a custom
           type's NAME, never its shape - and even a JSON Schema, which this engine deliberately does not
           carry (ADR 0011), expresses far more than a form can render. A textarea is truthful about what
           is known; no @onkeydown, because Enter has to insert a line here. *@
        <textarea class="input mono answer-json" rows="6" disabled="@Disabled"
                  aria-label="Answer as JSON"
                  value="@Input.Text"
                  @oninput="args => Input.Text = args.Value?.ToString() ?? string.Empty"></textarea>

        @if (AnswerValueCodec.IsWellFormedJson(Input.Text))
        {
            <p class="expr-status ok">✓ Well-formed JSON.</p>
        }
        else
        {
            @* Advisory, and the button stays enabled on purpose: the refusal has to come from the engine,
               so that a test run shows the message a host application would show. *@
            <p class="expr-status err">
                ✗ Not well-formed JSON yet. You can still submit – the engine has the final say.
            </p>
        }

        @if (DeltaNote is { } note)
        {
            <p class="hint answer-note">@note</p>
        }

        <button type="button" class="btn btn-primary" disabled="@(Disabled || !Input.CanSubmit)"
                @onclick="OnSubmit">
            @SubmitLabel
        </button>
    }
    else
    {
        @* Raw <input> with @oninput instead of InputText: the submit button should become active while
           typing, not only when the field is left. *@
        <input class="input" type="@InputType" value="@Input.Text" disabled="@Disabled"
               @oninput="args => Input.Text = args.Value?.ToString() ?? string.Empty"
               @onkeydown="OnKeyDownAsync" />

        <button type="button" class="btn btn-primary" disabled="@(Disabled || !Input.CanSubmit)"
                @onclick="OnSubmit">
            @SubmitLabel
        </button>
    }
</div>

@code {
    /// <summary>The answer type of the question – determines the control.</summary>
    [Parameter]
    [EditorRequired]
    public QuestionType Type { get; set; }

    /// <summary>The answer options (only relevant for single/multiple choice).</summary>
    [Parameter]
    public IReadOnlyList<AnswerChoice> Options { get; set; } = [];

    /// <summary>
    /// The question's <see cref="Question.CustomTypeKey"/> (only relevant for
    /// <see cref="QuestionType.Json"/>). Drives the note that states what this run does <b>not</b> check.
    /// </summary>
    [Parameter]
    public string? CustomTypeKey { get; set; }

    /// <summary>The input state that is bound to.</summary>
    [Parameter]
    [EditorRequired]
    public AnswerInputModel Input { get; set; } = default!;

    /// <summary>Raised as soon as the answer should be submitted.</summary>
    [Parameter]
    [EditorRequired]
    public EventCallback OnSubmit { get; set; }

    /// <summary>Label of the submit button.</summary>
    [Parameter]
    public string SubmitLabel { get; set; } = "Answer";

    /// <summary>Locks the input while an engine step is running.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    private string InputType
        => Type switch
        {
            QuestionType.Number => "number",
            QuestionType.Date => "date",
            _ => "text",
        };

    /// <summary>
    /// What this test run does <b>not</b> check, in words – or <see langword="null"/> when there is
    /// nothing to state.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The three cases are the whole point of #137's honesty requirement, and the important one is the
    /// middle: a note appears <b>even when the key resolves</b>. A descriptor buys a display name and a
    /// sample, never the host's <c>IQuestionTypeValidator</c> – that is code in another process. Showing
    /// the note only for unknown keys would tell an author that a known type is fully checked here, which
    /// is exactly the false impression EPIC 14 refused to create.
    /// </para>
    /// <para>
    /// A plain <c>Json</c> question without a key gets <b>no</b> note, and that is not an omission: for
    /// it, well-formedness is the entire engine contract, so this run validates identically to production.
    /// </para>
    /// </remarks>
    private string? DeltaNote
    {
        get
        {
            if (Type != QuestionType.Json || string.IsNullOrWhiteSpace(CustomTypeKey))
            {
                return null;
            }

            return QuestionTypes.TryGet(CustomTypeKey, out var declared) && declared is not null
                ? $"Checked here: well-formed JSON. Not checked here: whatever \"{declared.DisplayName}\" "
                  + "means – that validation is code in the host application and does not run in the "
                  + "designer."
                : $"Unknown custom type \"{CustomTypeKey}\": this designer has no descriptor for it, so "
                  + "the answer is checked for well-formed JSON only. The host's own validation does not "
                  + "run here either way.";
        }
    }

    private Task ChooseYesAsync() => ChooseAsync("true");

    private Task ChooseNoAsync() => ChooseAsync("false");

    /// <summary>Takes a value from a click and submits it directly (choice/yes-no).</summary>
    /// <param name="value">The chosen value.</param>
    private async Task ChooseAsync(string value)
    {
        Input.Text = value;
        await OnSubmit.InvokeAsync();
    }

    /// <summary>Submits the input on the Enter key as well.</summary>
    /// <param name="args">The keyboard event.</param>
    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        ArgumentNullException.ThrowIfNull(args);

        if (args.Key == "Enter" && Input.CanSubmit && !Disabled)
        {
            await OnSubmit.InvokeAsync();
        }
    }
}
