@* Input field for an answer in the test runner (#43) – the control that fits each question type. Used by
   the current question AND by editing an earlier answer, hence a component. *@
@using Flirty.Domain
@using Flirty.Designer.Models

<div class="answer-input">
    @* First branch on purpose: it also covers the graph run view, which renders this same component at
       the selected node. A documented limit rather than a gap - see QuestionTypeLabels. *@
    @if (!QuestionTypeLabels.IsAnswerableInDesigner(Type))
    {
        <p class="hint answer-note">
            A <strong>JSON</strong> question cannot be answered here. The designer does not know the shape
            the host expects – and a test run writes a real session and delivers real webhooks, so it does
            not guess a value. Answer it through the host application, the HTTP API or an MCP client; a
            recorded answer is displayed here read-only.
        </p>
    }
    else if (Type == QuestionType.SingleChoice)
    {
        @foreach (var option in Options)
        {
            // Local copy: the lambda would otherwise run against the loop state after the last iteration.
            var choice = option;

            <button type="button" class="btn btn-primary" disabled="@Disabled"
                    @onclick="() => ChooseAsync(choice.Value)">
                @choice.Label
            </button>
        }

        @if (Options.Count == 0)
        {
            <span class="hint">The question has no answer options – so it cannot be answered.</span>
        }
    }
    else if (Type == QuestionType.Boolean)
    {
        <button type="button" class="btn btn-primary" disabled="@Disabled" @onclick="ChooseYesAsync">Yes</button>
        <button type="button" class="btn btn-primary" disabled="@Disabled" @onclick="ChooseNoAsync">No</button>
    }
    else if (Type == QuestionType.MultiChoice)
    {
        @foreach (var option in Options)
        {
            var choice = option;

            <label class="choice">
                <input type="checkbox" disabled="@Disabled"
                       checked="@Input.Selected.Contains(choice.Value)"
                       @onchange="args => Input.Toggle(choice.Value, args.Value is true)" />
                @choice.Label
            </label>
        }

        @if (Options.Count == 0)
        {
            <span class="hint">The question has no answer options – so it cannot be answered.</span>
        }

        <button type="button" class="btn btn-primary" disabled="@(Disabled || !Input.CanSubmit)"
                @onclick="OnSubmit">
            @SubmitLabel
        </button>
    }
    else
    {
        @* Raw <input> with @oninput instead of InputText: the submit button should become active while
           typing, not only when the field is left. *@
        <input class="input" type="@InputType" value="@Input.Text" disabled="@Disabled"
               @oninput="args => Input.Text = args.Value?.ToString() ?? string.Empty"
               @onkeydown="OnKeyDownAsync" />

        <button type="button" class="btn btn-primary" disabled="@(Disabled || !Input.CanSubmit)"
                @onclick="OnSubmit">
            @SubmitLabel
        </button>
    }
</div>

@code {
    /// <summary>The answer type of the question – determines the control.</summary>
    [Parameter]
    [EditorRequired]
    public QuestionType Type { get; set; }

    /// <summary>The answer options (only relevant for single/multiple choice).</summary>
    [Parameter]
    public IReadOnlyList<AnswerChoice> Options { get; set; } = [];

    /// <summary>The input state that is bound to.</summary>
    [Parameter]
    [EditorRequired]
    public AnswerInputModel Input { get; set; } = default!;

    /// <summary>Raised as soon as the answer should be submitted.</summary>
    [Parameter]
    [EditorRequired]
    public EventCallback OnSubmit { get; set; }

    /// <summary>Label of the submit button.</summary>
    [Parameter]
    public string SubmitLabel { get; set; } = "Answer";

    /// <summary>Locks the input while an engine step is running.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    private string InputType
        => Type switch
        {
            QuestionType.Number => "number",
            QuestionType.Date => "date",
            _ => "text",
        };

    private Task ChooseYesAsync() => ChooseAsync("true");

    private Task ChooseNoAsync() => ChooseAsync("false");

    /// <summary>Takes a value from a click and submits it directly (choice/yes-no).</summary>
    /// <param name="value">The chosen value.</param>
    private async Task ChooseAsync(string value)
    {
        Input.Text = value;
        await OnSubmit.InvokeAsync();
    }

    /// <summary>Submits the input on the Enter key as well.</summary>
    /// <param name="args">The keyboard event.</param>
    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        ArgumentNullException.ThrowIfNull(args);

        if (args.Key == "Enter" && Input.CanSubmit && !Disabled)
        {
            await OnSubmit.InvokeAsync();
        }
    }
}
