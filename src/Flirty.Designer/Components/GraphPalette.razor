@*
    The palette of question types (#103) beside the graph canvas.

    Two ways, deliberately both: an entry can be dragged onto the drawing surface (the question then sits
    at the drop point – the JS module drives the gesture and reports the coordinates), or activated, which
    creates it without a saved position and leaves it to the auto-layout. The second way is the keyboard
    and screen-reader path: a pointer-only drag would be a regression against the form path.

    When the graph is locked the entries are `disabled` rather than invisible – unlike the ports on the
    node, which are then not rendered at all. Reason: the palette is an explanatory surface with a
    heading; letting it disappear would leave the canvas without any hint that something is normally
    created here.
*@
@using Flirty.Domain

<aside class="graph-palette" aria-label="Create new question">
    <h2>Building blocks</h2>

    <ul class="graph-palette-list">
        @foreach (var type in Types)
        {
            var current = type;
            <li>
                @* data-question-type is read by the JS module while dragging; the click runs through Blazor. *@
                <button type="button"
                        class="graph-palette-item"
                        data-question-type="@current"
                        disabled="@Disabled"
                        title="@QuestionTypeLabels.Describe(current)"
                        @onclick="() => Add.InvokeAsync(current)">
                    @QuestionTypeLabels.Describe(current)
                </button>
            </li>
        }
    </ul>

    <p class="hint">
        <b>Dragging</b> onto the surface drops the question there. A <b>click</b> appends it at the end and
        leaves the arrangement to the auto-layout.
    </p>
</aside>

@code {
    /// <summary>
    /// The offered question types. Read from the enum rather than enumerated: a new
    /// <see cref="QuestionType"/> (skill <c>flirty-question-type</c>) then appears here by itself
    /// instead of silently missing.
    /// </summary>
    private static readonly QuestionType[] Types = Enum.GetValues<QuestionType>();

    /// <summary>Whether the entries are locked – on a published dialog or during a running gesture.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Raised when an entry is activated (the pointerless path).</summary>
    [Parameter]
    public EventCallback<QuestionType> Add { get; set; }
}
