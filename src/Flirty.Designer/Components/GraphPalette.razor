@*
    Die Palette der Fragetypen (#103) neben dem Graph-Canvas.

    Zwei Wege, bewusst beide: Ein Eintrag lässt sich auf die Zeichenfläche ziehen (dann liegt die Frage
    an der Drop-Stelle – das JS-Modul führt die Geste und meldet die Koordinaten), oder betätigen, was
    sie ohne gespeicherte Position anlegt und dem Auto-Layout überlässt. Der zweite Weg ist der
    Tastatur- und Screenreader-Pfad: Ein reiner Zeiger-Zug wäre gegenüber dem Formularpfad ein
    Rückschritt.

    Die Einträge sind bei gesperrtem Graphen `disabled` statt unsichtbar – anders als die Ports am
    Knoten, die dann gar nicht gerendert werden. Grund: Die Palette ist eine erklärende Fläche mit
    Überschrift; sie verschwinden zu lassen ließe den Canvas ohne Hinweis darauf, dass hier normalerweise
    etwas anzulegen ist.
*@
@using Flirty.Domain

<aside class="graph-palette" aria-label="Neue Frage anlegen">
    <h2>Bausteine</h2>

    <ul class="graph-palette-list">
        @foreach (var type in Types)
        {
            var current = type;
            <li>
                @* data-question-type liest das JS-Modul beim Ziehen; der Klick läuft über Blazor. *@
                <button type="button"
                        class="graph-palette-item"
                        data-question-type="@current"
                        disabled="@Disabled"
                        title="@QuestionTypeLabels.Describe(current)"
                        @onclick="() => Add.InvokeAsync(current)">
                    @QuestionTypeLabels.Describe(current)
                </button>
            </li>
        }
    </ul>

    <p class="hint">
        Auf die Fläche <b>ziehen</b> legt die Frage dort ab. Ein <b>Klick</b> hängt sie hinten an und
        überlässt die Anordnung dem Auto-Layout.
    </p>
</aside>

@code {
    /// <summary>
    /// Die anbietbaren Fragetypen. Aus dem Enum gelesen statt aufgezählt: Ein neuer
    /// <see cref="QuestionType"/> (Skill <c>flirty-question-type</c>) erscheint dann von selbst hier,
    /// statt still zu fehlen.
    /// </summary>
    private static readonly QuestionType[] Types = Enum.GetValues<QuestionType>();

    /// <summary>Ob die Einträge gesperrt sind – bei veröffentlichtem Dialog oder laufender Geste.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Wird beim Betätigen eines Eintrags ausgelöst (der Pfad ohne Zeiger).</summary>
    [Parameter]
    public EventCallback<QuestionType> Add { get; set; }
}
