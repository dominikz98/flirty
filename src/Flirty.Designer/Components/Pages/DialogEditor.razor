@* Deliberately NOT named "DialogDetail": the component type would otherwise shadow the
   equally named view type Flirty.Runtime.Admin.DialogDetail. *@
@page "/dialogs/{Id:guid}"
@rendermode InteractiveServer
@using Mediator
@using Flirty.Domain
@using Flirty.Runtime.Admin
@using Flirty.Validation
@inject FlirtyAdminGateway Admin
@inject NavigationManager Navigation
@inject FlirtyQuestionTypeRegistry QuestionTypes

<PageTitle>@(_detail?.Dialog.Name ?? "Dialog") · Flirty Designer</PageTitle>

<p class="back"><a href="dialogs">← Dialogs</a></p>

@if (_detail is null)
{
    <h1>Dialog</h1>

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    else
    {
        <p class="empty">Loading …</p>
    }
}
else
{
    <h1>
        @_detail.Dialog.Name
        @if (_detail.Dialog.IsPublished)
        {
            <span class="badge badge-published">Published</span>
        }
        else
        {
            <span class="badge badge-draft">Draft</span>
        }
    </h1>

    <p class="intro">
        Version @_detail.Dialog.Version · created @_detail.Dialog.CreatedAt.LocalDateTime.ToString("g")
        · last changed @_detail.Dialog.UpdatedAt.LocalDateTime.ToString("g")
        · <a href="@($"dialogs/{Id}/graph")">View graph</a>
    </p>

    @if (_detail.Dialog.IsPublished)
    {
        <div class="banner warn">
            <p>
                This dialog is published in version @_detail.Dialog.Version and therefore
                <strong>locked</strong>: questions, answer options, transitions, loops, triggers and the
                entry question cannot be changed. Running sessions keep working on this version –
                a change would break them.
            </p>
            <p>
                To evolve it, create a <strong>new version</strong> (a copy as a draft; the
                published version stays unchanged) or <strong>retire</strong> the dialog
                (then no one starts it anew, running sessions run to completion).
                Name and description remain editable here too.
            </p>
            <div class="actions">
                <button class="btn btn-primary" disabled="@_busy" @onclick="CreateVersionAsync">
                    Create new version
                </button>
            </div>
        </div>
    }

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    @if (_message is not null)
    {
        <div class="banner ok">@_message</div>
    }

    <div class="editor">
        <h2>Metadata</h2>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="key">Key</label>
                <InputText id="key" class="input" @bind-Value="_form.Key" />
                <ValidationMessage For="() => _form.Key" />
            </div>

            <div class="field">
                <label for="name">Name</label>
                <InputText id="name" class="input" @bind-Value="_form.Name" />
                <ValidationMessage For="() => _form.Name" />
            </div>

            <div class="field">
                <label for="description">Description</label>
                <InputTextArea id="description" class="input" rows="2" @bind-Value="_form.Description" />
            </div>

            <div class="field">
                <label for="startQuestion">Entry question</label>
                <InputSelect id="startQuestion" class="input" @bind-Value="_form.StartQuestionId"
                             disabled="@(_detail.Questions.Count == 0 || !Editable)">
                    <option value="">— none —</option>
                    @foreach (var question in _detail.Questions)
                    {
                        <option value="@question.Id">@question.Key — @question.Text</option>
                    }
                </InputSelect>
                @if (_detail.Questions.Count == 0)
                {
                    <span class="hint">Create a question below first – then the entry question can be chosen here.</span>
                }
                else if (_form.StartQuestionId is null)
                {
                    <span class="hint">Without an entry question the dialog cannot be published.</span>
                }
                else
                {
                    <span class="hint">Every session of this dialog begins here.</span>
                }
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary" disabled="@_busy">Save</button>
                <button type="button" class="btn" disabled="@_busy" @onclick="ResetForm">Reset</button>
            </div>
        </EditForm>
    </div>

    <div class="editor">
        <h2>Questions</h2>

        @if (_detail.Questions.Count == 0)
        {
            <p class="empty">No questions created yet.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Key</th>
                        <th>Text</th>
                        <th>Type</th>
                        <th>Required</th>
                        <th>Options</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < _detail.Questions.Count; index++)
                    {
                        // Local copies: otherwise the buttons' lambdas would run against the loop
                        // state after the last iteration.
                        var position = index;
                        var question = _detail.Questions[index];

                        <tr>
                            <td>@(position + 1)</td>
                            <td class="mono">
                                @question.Key
                                @if (_detail.Dialog.StartQuestionId == question.Id)
                                {
                                    <span class="badge badge-start">Entry</span>
                                }
                            </td>
                            <td>@question.Text</td>
                            <td>@QuestionTypeLabels.Describe(question.Type, question.CustomTypeKey, QuestionTypes)</td>
                            <td>@(question.IsRequired ? "yes" : "no")</td>
                            <td>@(QuestionTypeLabels.UsesOptions(question.Type) ? question.Options.Count.ToString() : "—")</td>
                            <td class="row-actions">
                                <button class="btn" title="Move up"
                                        disabled="@(_busy || !Editable || position == 0)"
                                        @onclick="() => MoveQuestionAsync(position, position - 1)">↑</button>
                                <button class="btn" title="Move down"
                                        disabled="@(_busy || !Editable || position == _detail.Questions.Count - 1)"
                                        @onclick="() => MoveQuestionAsync(position, position + 1)">↓</button>
                                <button class="btn" @onclick="() => OpenQuestion(question)">Edit</button>

                                @if (_confirmDeleteQuestionId == question.Id)
                                {
                                    <span class="confirm">Delete the question along with its options and transitions?</span>
                                    <button class="btn btn-danger" disabled="@(_busy || !Editable)"
                                            @onclick="() => DeleteQuestionAsync(question)">Yes, delete</button>
                                    <button class="btn" disabled="@_busy"
                                            @onclick="() => _confirmDeleteQuestionId = null">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-danger" disabled="@(_busy || !Editable)"
                                            @onclick="() => _confirmDeleteQuestionId = question.Id">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (_newQuestion is null)
        {
            <div class="actions">
                <button class="btn btn-primary" disabled="@(_busy || !Editable)" @onclick="StartCreateQuestion">New question</button>
            </div>
        }
        else
        {
            <EditForm Model="_newQuestion" OnValidSubmit="CreateQuestionAsync">
                <DataAnnotationsValidator />

                <div class="field">
                    <label for="questionKey">Key</label>
                    <InputText id="questionKey" class="input" @bind-Value="_newQuestion.Key" />
                    <span class="hint">
                        A domain-level, stable key – unique within the dialog and visible in the branching
                        expression context (e.g. <code>first_name</code>).
                    </span>
                    <ValidationMessage For="() => _newQuestion.Key" />
                </div>

                <div class="field">
                    <label for="questionText">Question text</label>
                    <InputTextArea id="questionText" class="input" rows="2" @bind-Value="_newQuestion.Text" />
                    <ValidationMessage For="() => _newQuestion.Text" />
                </div>

                <PlaceholderReference @bind-Value="_newQuestion.Text" />

                @* A raw select rather than InputSelect: the list holds host-declared types (#137) too,
                   and those are not enum members - picking one has to write the type AND the custom type
                   key. The selection is DERIVED from both fields via ChoiceValue, so an undeclared key
                   falls back to the plain Json entry instead of the two drifting apart. *@
                <div class="field">
                    <label for="questionType">Type</label>
                    <select id="questionType" class="input"
                            value="@QuestionTypeLabels.ChoiceValue(_newQuestion.Type, _newQuestion.CustomTypeKey, QuestionTypes)"
                            @onchange="args => ChooseNewQuestionType(args.Value as string)">
                        @foreach (var choice in QuestionTypeLabels.Choices(QuestionTypes))
                        {
                            <option value="@choice.Value">@choice.Label</option>
                        }
                    </select>
                </div>

                <div class="field check">
                    <InputCheckbox id="questionRequired" @bind-Value="_newQuestion.IsRequired" />
                    <label for="questionRequired">Answer required</label>
                </div>

                <div class="actions">
                    <button type="submit" class="btn btn-primary" disabled="@_busy">Create</button>
                    <button type="button" class="btn" disabled="@_busy" @onclick="() => _newQuestion = null">Cancel</button>
                </div>
            </EditForm>
        }
    </div>

    <div class="editor">
        <h2>Transitions (branching)</h2>

        @if (_detail.Questions.Count == 0)
        {
            <p class="empty">Create questions first – transitions connect questions to each other.</p>
        }
        else
        {
            <p class="hint">
                Per source question the transitions are checked top to bottom; the first matching one
                wins. If none match, the default transition takes effect.
            </p>

            @foreach (var question in _detail.Questions)
            {
                // Local copy: otherwise the buttons' lambdas would run against the loop state
                // after the last iteration.
                var source = question;
                var outgoing = Outgoing(source.Id);

                <h3 class="group">
                    <span class="mono">@source.Key</span>
                    <span class="group-text">— @source.Text</span>
                    <button class="btn" disabled="@(_busy || !Editable)" @onclick="() => StartCreateTransition(source.Id)">
                        + Transition
                    </button>
                </h3>

                @if (outgoing.Count == 0)
                {
                    <p class="hint">No transitions – the dialog ends after this question.</p>
                }
                else
                {
                    @foreach (var warning in TransitionWarningAnalyzer.Analyze(outgoing))
                    {
                        <div class="banner warn">@warning.Text</div>
                    }

                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Condition</th>
                                <th>Target</th>
                                <th>Kind</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var index = 0; index < outgoing.Count; index++)
                            {
                                var position = index;
                                var transition = outgoing[index];

                                <tr>
                                    <td>@(position + 1)</td>
                                    <td class="mono">
                                        @(string.IsNullOrWhiteSpace(transition.Expression)
                                            ? "— unconditional —"
                                            : transition.Expression)
                                    </td>
                                    <td class="mono">@QuestionLabel(transition.TargetQuestionId)</td>
                                    <td>
                                        @if (transition.IsDefault)
                                        {
                                            <span class="badge badge-default">Default</span>
                                        }
                                        @if (IsBackJump(transition))
                                        {
                                            <span class="badge badge-loop" title="Points to an earlier question – cycle/loop">Back-jump</span>
                                        }
                                    </td>
                                    <td class="row-actions">
                                        <button class="btn" title="Move up"
                                                disabled="@(_busy || !Editable || position == 0)"
                                                @onclick="() => MoveTransitionAsync(source.Id, position, position - 1)">↑</button>
                                        <button class="btn" title="Move down"
                                                disabled="@(_busy || !Editable || position == outgoing.Count - 1)"
                                                @onclick="() => MoveTransitionAsync(source.Id, position, position + 1)">↓</button>
                                        <button class="btn" @onclick="() => OpenTransition(transition)">Edit</button>

                                        @if (_confirmDeleteTransitionId == transition.Id)
                                        {
                                            <span class="confirm">Delete transition?</span>
                                            <button class="btn btn-danger" disabled="@(_busy || !Editable)"
                                                    @onclick="() => DeleteTransitionAsync(transition)">Yes, delete</button>
                                            <button class="btn" disabled="@_busy"
                                                    @onclick="() => _confirmDeleteTransitionId = null">Cancel</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-danger" disabled="@(_busy || !Editable)"
                                                    @onclick="() => _confirmDeleteTransitionId = transition.Id">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }

            @if (Orphans().Count > 0)
            {
                <div class="banner warn">
                    @Orphans().Count transition(s) point to an unknown source question and are
                    never evaluated. They can only be deleted:
                    @foreach (var orphan in Orphans())
                    {
                        var stale = orphan;
                        <button class="btn btn-danger" disabled="@(_busy || !Editable)"
                                @onclick="() => DeleteTransitionAsync(stale)">
                            Delete @stale.Id
                        </button>
                    }
                </div>
            }

            @if (_newTransition is null)
            {
                <div class="actions">
                    <button class="btn btn-primary" disabled="@(_busy || !Editable)"
                            @onclick="() => StartCreateTransition(null)">New transition</button>
                </div>
            }
            else
            {
                <EditForm Model="_newTransition" OnValidSubmit="CreateTransitionAsync">
                    <DataAnnotationsValidator />

                    <div class="field-row">
                        <div class="field">
                            <label for="transitionFrom">Source question</label>
                            <InputSelect id="transitionFrom" class="input" @bind-Value="_newTransition.FromQuestionId">
                                <option value="">— choose —</option>
                                @foreach (var question in _detail.Questions)
                                {
                                    <option value="@question.Id">@question.Key — @question.Text</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _newTransition.FromQuestionId" />
                        </div>

                        <div class="field">
                            <label for="transitionTarget">Target question</label>
                            <InputSelect id="transitionTarget" class="input" @bind-Value="_newTransition.TargetQuestionId">
                                <option value="">— choose —</option>
                                @foreach (var question in _detail.Questions)
                                {
                                    <option value="@question.Id">@question.Key — @question.Text</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _newTransition.TargetQuestionId" />
                        </div>
                    </div>

                    <div class="field check">
                        <InputCheckbox id="transitionDefault" @bind-Value="_newTransition.IsDefault" />
                        <label for="transitionDefault">Default transition (applies when no condition matches)</label>
                    </div>

                    <span class="hint">
                        The condition is then maintained in the transition editor – there it is checked
                        live against this dialog's questions.
                    </span>

                    <div class="actions">
                        <button type="submit" class="btn btn-primary" disabled="@_busy">Create</button>
                        <button type="button" class="btn" disabled="@_busy"
                                @onclick="() => _newTransition = null">Cancel</button>
                    </div>
                </EditForm>
            }
        }
    </div>

    <div class="editor">
        <h2>Loops</h2>

        @if (_detail.Questions.Count == 0)
        {
            <p class="empty">Create questions and transitions first – a loop marks an existing cycle.</p>
        }
        else
        {
            <p class="hint">
                A loop arises from the transitions: a back-jump to an earlier question forms the
                cycle. The marker only tells the runtime that the answers of the range are
                <em>collected</em> per iteration under the collection key instead of being overwritten.
            </p>

            @if (_detail.Loops.Count == 0)
            {
                <p class="empty">No loops marked yet.</p>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Collection</th>
                            <th>Entry</th>
                            <th>Breaking</th>
                            <th>Range</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var insight in _loops)
                        {
                            // Local copy: otherwise the buttons' lambdas would run against the loop
                            // state after the last iteration.
                            var loop = insight.Loop;

                            <tr>
                                <td class="mono">@loop.CollectionKey</td>
                                <td class="mono">@QuestionLabel(loop.EntryQuestionId)</td>
                                <td class="mono">@QuestionLabel(loop.BreakingQuestionId)</td>
                                <td>@insight.Body.Count question(s)</td>
                                <td>
                                    @if (insight.Warnings.Count == 0)
                                    {
                                        <span class="badge badge-loop">Loop</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-draft"
                                              title="@string.Join(" ", insight.Warnings)">
                                            @insight.Warnings.Count warning(s)
                                        </span>
                                    }
                                </td>
                                <td class="row-actions">
                                    <button class="btn" @onclick="() => OpenLoop(loop)">Edit</button>

                                    @if (_confirmDeleteLoopId == loop.Id)
                                    {
                                        <span class="confirm">Delete marker? The cycle itself remains.</span>
                                        <button class="btn btn-danger" disabled="@(_busy || !Editable)"
                                                @onclick="() => DeleteLoopAsync(loop)">Yes, delete</button>
                                        <button class="btn" disabled="@_busy"
                                                @onclick="() => _confirmDeleteLoopId = null">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-danger" disabled="@(_busy || !Editable)"
                                                @onclick="() => _confirmDeleteLoopId = loop.Id">Delete</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (UnmarkedBackJumps().Count > 0)
            {
                <div class="banner warn">
                    Back-jump without a loop marker: the answers of this cycle are
                    <strong>overwritten</strong> at runtime instead of collected per iteration.
                    @foreach (var candidate in UnmarkedBackJumps())
                    {
                        var backJump = candidate;
                        <button class="btn" disabled="@(_busy || !Editable)" @onclick="() => StartCreateLoop(backJump)">
                            @QuestionLabel(backJump.FromQuestionId) → @QuestionLabel(backJump.TargetQuestionId)
                            mark as loop
                        </button>
                    }
                </div>
            }

            @if (_newLoop is null)
            {
                <div class="actions">
                    <button class="btn btn-primary" disabled="@(_busy || !Editable)"
                            @onclick="() => StartCreateLoop(null)">New loop</button>
                </div>
            }
            else
            {
                <EditForm Model="_newLoop" OnValidSubmit="CreateLoopAsync">
                    <DataAnnotationsValidator />

                    <div class="field-row">
                        <div class="field">
                            <label for="loopEntry">Entry question</label>
                            <InputSelect id="loopEntry" class="input" @bind-Value="_newLoop.EntryQuestionId">
                                <option value="">— choose —</option>
                                @foreach (var question in _detail.Questions)
                                {
                                    <option value="@question.Id">@question.Key — @question.Text</option>
                                }
                            </InputSelect>
                            <span class="hint">Target of the back-jump; its answer is collected per iteration.</span>
                            <ValidationMessage For="() => _newLoop.EntryQuestionId" />
                        </div>

                        <div class="field">
                            <label for="loopBreaking">Breaking question</label>
                            <InputSelect id="loopBreaking" class="input" @bind-Value="_newLoop.BreakingQuestionId">
                                <option value="">— choose —</option>
                                @foreach (var question in _detail.Questions)
                                {
                                    <option value="@question.Id">@question.Key — @question.Text</option>
                                }
                            </InputSelect>
                            <span class="hint">The question at which back-jump or exit is decided.</span>
                            <ValidationMessage For="() => _newLoop.BreakingQuestionId" />
                        </div>
                    </div>

                    <div class="field">
                        <label for="loopKey">Collection key</label>
                        <InputText id="loopKey" class="input mono" @bind-Value="_newLoop.CollectionKey" />
                        <span class="hint">
                            Identifier of the collected answers in the expression context, e.g.
                            <code>skills</code> for <code>skills.Count &gt; 0</code>.
                        </span>
                        <ValidationMessage For="() => _newLoop.CollectionKey" />
                    </div>

                    <div class="actions">
                        <button type="submit" class="btn btn-primary" disabled="@_busy">Create</button>
                        <button type="button" class="btn" disabled="@_busy"
                                @onclick="() => _newLoop = null">Cancel</button>
                    </div>
                </EditForm>
            }
        }
    </div>

    <div class="editor">
        <h2>Triggers</h2>

        <p class="hint">
            Triggers are back channels into the host application. A <strong>webhook</strong> is delivered
            by the engine itself as an HTTP POST to the configured URL; an
            <strong>in-process</strong> entry only records that the host app reacts at this point with
            its own <code>INotificationHandler&lt;T&gt;</code> – the notification is
            published anyway.
        </p>

        @if (_detail.Triggers.Count == 0)
        {
            <p class="empty">No triggers created yet.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Question</th>
                        <th>Channel</th>
                        <th>Target</th>
                        <th>Condition</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _detail.Triggers)
                    {
                        // Local copy: otherwise the buttons' lambdas would run against the loop
                        // state after the last iteration.
                        var trigger = entry;

                        <tr>
                            <td>@TriggerLabels.Describe(trigger.Scope)</td>
                            <td class="mono">
                                @(trigger.QuestionId is { } questionId ? QuestionLabel(questionId) : "—")
                            </td>
                            <td>@TriggerLabels.Describe(trigger.Kind)</td>
                            <td class="mono">@TriggerTarget(trigger)</td>
                            <td class="mono">
                                @(string.IsNullOrWhiteSpace(trigger.Expression)
                                    ? "— unconditional —"
                                    : trigger.Expression)
                            </td>
                            <td class="row-actions">
                                <button class="btn" @onclick="() => OpenTrigger(trigger)">Edit</button>

                                @if (_confirmDeleteTriggerId == trigger.Id)
                                {
                                    <span class="confirm">Delete trigger?</span>
                                    <button class="btn btn-danger" disabled="@(_busy || !Editable)"
                                            @onclick="() => DeleteTriggerAsync(trigger)">Yes, delete</button>
                                    <button class="btn" disabled="@_busy"
                                            @onclick="() => _confirmDeleteTriggerId = null">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-danger" disabled="@(_busy || !Editable)"
                                            @onclick="() => _confirmDeleteTriggerId = trigger.Id">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (_newTrigger is null)
        {
            <div class="actions">
                <button class="btn btn-primary" disabled="@(_busy || !Editable)" @onclick="StartCreateTrigger">New trigger</button>
            </div>
        }
        else
        {
            <EditForm Model="_newTrigger" OnValidSubmit="CreateTriggerAsync">
                <DataAnnotationsValidator />

                <div class="field-row">
                    <div class="field">
                        <label for="triggerScope">When</label>
                        <InputSelect id="triggerScope" class="input" @bind-Value="_newTrigger.Scope">
                            @foreach (var scope in Enum.GetValues<TriggerScope>())
                            {
                                <option value="@scope">@TriggerLabels.Describe(scope)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="field">
                        <label for="triggerKind">Channel</label>
                        <InputSelect id="triggerKind" class="input" @bind-Value="_newTrigger.Kind">
                            @foreach (var kind in Enum.GetValues<TriggerKind>())
                            {
                                <option value="@kind">@TriggerLabels.Describe(kind)</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                @if (TriggerLabels.RequiresQuestion(_newTrigger.Scope))
                {
                    <div class="field">
                        <label for="triggerQuestion">Question</label>
                        <InputSelect id="triggerQuestion" class="input" @bind-Value="_newTrigger.QuestionId"
                                     disabled="@(_detail.Questions.Count == 0)">
                            <option value="">— choose —</option>
                            @foreach (var question in _detail.Questions)
                            {
                                <option value="@question.Id">@question.Key — @question.Text</option>
                            }
                        </InputSelect>
                        <span class="hint">The trigger only fires after this question.</span>
                    </div>
                }

                @if (_newTrigger.Kind == TriggerKind.Webhook)
                {
                    <div class="field">
                        <label for="triggerUrl">Target URL</label>
                        <InputText id="triggerUrl" class="input mono" @bind-Value="_newTrigger.Url" />
                        <span class="hint">Absolute http/https address, e.g. <code>https://host.example/flirty/completed</code>.</span>
                    </div>
                }

                <div class="field">
                    <label for="triggerName">Event name (optional)</label>
                    <InputText id="triggerName" class="input mono" @bind-Value="_newTrigger.Name" />
                    <span class="hint">
                        Sent with the webhook as the header <code>X-Flirty-Trigger</code>, e.g.
                        <code>order-created</code>.
                    </span>
                </div>

                <span class="hint">
                    The condition is then maintained in the trigger editor – there it is checked live
                    against this dialog's questions.
                </span>

                <div class="actions">
                    <button type="submit" class="btn btn-primary" disabled="@_busy">Create</button>
                    <button type="button" class="btn" disabled="@_busy"
                            @onclick="() => _newTrigger = null">Cancel</button>
                </div>
            </EditForm>
        }
    </div>

    <div class="editor">
        <h2>Test run</h2>

        <p class="hint">
            Play the dialog through with the real engine – even as a draft. The run creates a real
            session in the database of the active profile.
        </p>

        <div class="actions">
            <button class="btn btn-primary"
                    disabled="@(_busy || _detail.Dialog.StartQuestionId is null)"
                    @onclick="OpenTestRunner">
                Test run
            </button>
        </div>

        @if (_detail.Dialog.StartQuestionId is null)
        {
            <p class="hint">Without a set (and saved) entry question there is nothing to play through.</p>
        }
    </div>

    <div class="editor">
        <h2>Publishing &amp; deletion</h2>
        <div class="actions">
            @if (_detail.Dialog.IsPublished)
            {
                <button class="btn" disabled="@_busy" @onclick="UnpublishAsync">Retire</button>
            }
            else if (_confirmPublish)
            {
                <span class="confirm">Publish despite the warnings?</span>
                <button class="btn btn-danger" disabled="@_busy" @onclick="PublishAsync">
                    Yes, publish
                </button>
                <button class="btn" disabled="@_busy" @onclick="() => _confirmPublish = false">Cancel</button>
            }
            else
            {
                <button class="btn btn-primary"
                        disabled="@(_busy || _detail.Dialog.StartQuestionId is null)"
                        @onclick="StartPublish">
                    Publish
                </button>
            }

            @if (_confirmDelete)
            {
                <span class="confirm">Really delete? The entire dialog graph is lost.</span>
                <button class="btn btn-danger" disabled="@_busy" @onclick="DeleteAsync">Yes, delete</button>
                <button class="btn" disabled="@_busy" @onclick="() => _confirmDelete = false">Cancel</button>
            }
            else
            {
                <button class="btn btn-danger" disabled="@_busy" @onclick="() => _confirmDelete = true">Delete</button>
            }
        </div>

        @if (!_detail.Dialog.IsPublished && _detail.Dialog.StartQuestionId is null)
        {
            <p class="hint">
                To publish, an entry question must be set (and saved) above.
            </p>
        }

        @{
            var openWarnings = GraphWarnings();
        }
        @if (!_detail.Dialog.IsPublished && openWarnings.Count > 0)
        {
            <div class="banner warn">
                <p>
                    The graph has open warnings. They are repeated here because a published
                    version is <strong>locked</strong>: what slips through now can only be healed via a
                    new version or a retirement – while running sessions are already running into the
                    error.
                </p>
                <ul>
                    @foreach (var warning in openWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        @if (_activeSessions > 0)
        {
            <div class="banner warn">
                <p>
                    <strong>@_activeSessions session(s)</strong> are running on this version. Deletion is
                    therefore locked: the session rows outlive the dialog but would afterwards be neither
                    resumable nor readable. End them first – answers and history are preserved,
                    only the status changes to "abandoned".
                </p>
                <div class="actions">
                    @if (_confirmAbandon)
                    {
                        <span class="confirm">End @_activeSessions running session(s) for good?</span>
                        <button class="btn btn-danger" disabled="@_busy" @onclick="AbandonSessionsAsync">
                            Yes, end them
                        </button>
                        <button class="btn" disabled="@_busy" @onclick="() => _confirmAbandon = false">
                            Cancel
                        </button>
                    }
                    else
                    {
                        <button class="btn" disabled="@_busy" @onclick="() => _confirmAbandon = true">
                            End running sessions
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    /// <summary>The primary key of the displayed dialog (from the route).</summary>
    [Parameter]
    public Guid Id { get; set; }

    private DialogDetail? _detail;
    private IReadOnlyList<LoopInsight> _loops = [];

    /// <summary>
    /// The graph's drawing model – here not for drawing, but as the <b>complete</b> source
    /// of the warnings (#118). Deliberately held in a field: called from the markup the whole
    /// layout would run on every render, i.e. on every click (see <see cref="DialogGraphModel"/>).
    /// </summary>
    private DialogGraphModel? _graph;

    private DialogFormModel _form = new();
    private QuestionFormModel? _newQuestion;
    private TransitionFormModel? _newTransition;
    private LoopFormModel? _newLoop;
    private TriggerFormModel? _newTrigger;
    private string? _error;
    private string? _message;
    private bool _busy;
    private bool _confirmDelete;
    private bool _confirmAbandon;
    private bool _confirmPublish;
    private int _activeSessions;
    private Guid? _confirmDeleteQuestionId;
    private Guid? _confirmDeleteTransitionId;
    private Guid? _confirmDeleteLoopId;
    private Guid? _confirmDeleteTriggerId;
    private Guid _loadedId;

    /// <summary>
    /// Whether the configuration graph is editable. A <b>published</b> version is locked –
    /// the engine rejects graph changes to it with a conflict (<c>DialogPublishedException</c>),
    /// so that running sessions do not break. The lock mirrors this rule in the UI, instead of
    /// letting the user run into the error message. Name and description remain editable.
    /// </summary>
    private bool Editable => _detail is not null && !_detail.Dialog.IsPublished;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _message = null;
        _confirmDelete = false;
        _confirmPublish = false;
        _confirmDeleteQuestionId = null;
        _confirmDeleteTransitionId = null;
        _confirmDeleteLoopId = null;
        _confirmDeleteTriggerId = null;
        _newQuestion = null;
        _newTransition = null;
        _newLoop = null;
        _newTrigger = null;
        await ReloadAsync();
    }

    /// <summary>
    /// Reloads the dialog including its graph.
    /// </summary>
    /// <param name="resetForm">
    /// Whether the metadata form should be overwritten. For question operations deliberately
    /// <see langword="false"/>: otherwise just-typed, not-yet-saved metadata would be lost there.
    /// The entry question is reconciled anyway, in case it fell away server-side.
    /// </param>
    private async Task ReloadAsync(bool resetForm = true)
    {
        var result = await Admin.ExecuteAsync((sender, token) => sender.Send(new GetDialogQuery(Id), token));
        _detail = result.Value;
        _error = result.Error;
        _loops = _detail is null ? [] : LoopAnalyzer.Analyze(_detail);

        // The graph is not drawn here, but built: it is the only place that knows all
        // warning kinds – reachability arises only from the layout starting at the
        // entry question. Once per load, never per render.
        _graph = _detail is null ? null : DialogGraphBuilder.Build(_detail, QuestionTypes);

        // Running sessions lock deletion (DeleteDialogCommand) – the count belongs in the
        // deletion section, so that it is visible before the click and not only as an error message.
        if (_detail is not null)
        {
            var sessions = await Admin.ExecuteAsync(
                (sender, token) => sender.Send(new CountActiveSessionsQuery(Id), token));
            _activeSessions = sessions.Success ? sessions.Value : 0;
        }
        else
        {
            _activeSessions = 0;
        }

        if (resetForm)
        {
            ResetForm();
        }
        else if (_detail is not null
            && _form.StartQuestionId is { } selected
            && _detail.Questions.All(question => question.Id != selected))
        {
            // The chosen entry question no longer exists (deleted) -> fall back to the server state.
            _form.StartQuestionId = _detail.Dialog.StartQuestionId;
        }
    }

    private void ResetForm()
    {
        if (_detail is not null)
        {
            _form = DialogFormModel.From(_detail.Dialog);
        }
    }

    private async Task SaveAsync()
        => await RunAsync(
            (sender, token) => sender.Send(
                new UpdateDialogCommand(Id, _form.Key, _form.Name, _form.Description, _form.StartQuestionId), token),
            "Changes saved.");

    /// <summary>
    /// Collects <b>all</b> warnings of the graph, each with the key of its cause in front:
    /// transitions (<see cref="TransitionWarningAnalyzer"/>), loops (<see cref="LoopAnalyzer"/>), the
    /// missing entry question and the reachability of the questions. The source is therefore the
    /// <see cref="DialogGraphBuilder"/> and not a single analyzer – the same source feeds the
    /// graph view (#101), which shows the findings at the affected element instead of as a list.
    /// </summary>
    /// <remarks>
    /// Until #118 only <see cref="TransitionWarningAnalyzer"/> stood here. An <b>unreachable</b> question
    /// could thereby be published without a confirmation, even though the graph clearly flagged it. Keeping
    /// the selection hand-picked was the defect: every further warning kind would have fallen
    /// out again.
    /// </remarks>
    /// <returns>The open warnings; empty when the graph is consistent.</returns>
    private IReadOnlyList<string> GraphWarnings()
        => _detail is null || _graph is null
            ? []
            : GraphWarningList.Describe(_detail, _graph);

    /// <summary>
    /// Starts publishing. With open graph warnings it first asks back – once published
    /// the graph is locked, an overlooked configuration error then costs a new version.
    /// </summary>
    /// <returns>A task that completes once publishing (or the confirmation) has happened.</returns>
    private async Task StartPublish()
    {
        if (GraphWarnings().Count > 0)
        {
            _confirmPublish = true;
            return;
        }

        await PublishAsync();
    }

    private async Task PublishAsync()
    {
        _confirmPublish = false;
        await RunAsync((sender, token) => sender.Send(new PublishDialogCommand(Id), token), "Dialog published.");
    }

    private async Task UnpublishAsync()
        => await RunAsync(
            (sender, token) => sender.Send(new UnpublishDialogCommand(Id), token), "Publication retracted.");

    /// <summary>
    /// Derives a new version from the displayed dialog and switches into its editor. The
    /// page change is intentional: from here on one works on the draft, no longer on the published
    /// version.
    /// </summary>
    /// <returns>A task that completes once the version has been created (or the error
    /// displayed).</returns>
    private async Task CreateVersionAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Admin.ExecuteAsync(
                (sender, token) => sender.Send(new CreateDialogVersionCommand(Id), token));
            if (!result.Success || result.Value is null)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            Navigation.NavigateTo($"dialogs/{result.Value.Dialog.Id}");
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Ends the running sessions of this dialog version (status <c>Abandoned</c>).</summary>
    /// <returns>A task that completes once the sessions have been ended.</returns>
    private async Task AbandonSessionsAsync()
    {
        _confirmAbandon = false;
        var count = _activeSessions;
        await RunAsync(
            (sender, token) => sender.Send(new AbandonDialogSessionsCommand(Id), token),
            $"{count} running session(s) ended.");
    }

    /// <summary>
    /// Runs a writing operation, shows success or error and reloads the dialog (the
    /// commands return only their own slice, the view needs the whole graph).
    /// </summary>
    /// <typeparam name="TResult">The result type of the operation.</typeparam>
    /// <param name="operation">The admin message to run.</param>
    /// <param name="successMessage">The message shown on success.</param>
    /// <param name="resetForm">Whether the metadata form should be overwritten from the server state.</param>
    /// <returns><see langword="true"/> if the operation succeeded.</returns>
    private async Task<bool> RunAsync<TResult>(
        Func<ISender, CancellationToken, ValueTask<TResult>> operation,
        string successMessage,
        bool resetForm = true)
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Admin.ExecuteAsync(operation);
            if (!result.Success)
            {
                _error = result.Error;
                return false;
            }

            _error = null;
            _message = successMessage;
            await ReloadAsync(resetForm);
            return true;
        }
        finally
        {
            _busy = false;
        }
    }

    // ---- Questions (#39) --------------------------------------------------------------------------

    private void StartCreateQuestion() => _newQuestion = new QuestionFormModel();

    /// <summary>
    /// Applies a pick from the type dropdown. A host-declared type (#137) sets <c>Json</c> plus its key;
    /// a built-in one clears the key, so switching away cannot leave a stale one behind (the core would
    /// answer that with a 400).
    /// </summary>
    private void ChooseNewQuestionType(string? choiceValue)
    {
        if (_newQuestion is null || !QuestionTypeLabels.TryResolveChoice(choiceValue, out var type, out var key))
        {
            return;
        }

        _newQuestion.Type = type;
        _newQuestion.CustomTypeKey = key;
    }

    private void OpenQuestion(QuestionDetail question)
        => Navigation.NavigateTo($"dialogs/{Id}/questions/{question.Id}");

    /// <summary>
    /// Creates a question at the end of the dialog. Validation rules and answer options are deliberately
    /// maintained not here but in the question editor – this keeps creating several questions quick.
    /// </summary>
    private async Task CreateQuestionAsync()
    {
        if (_detail is null || _newQuestion is null)
        {
            return;
        }

        var model = _newQuestion;
        var order = GraphEditing.NextOrder(_detail);

        var created = await RunAsync<QuestionDetail>(
            (sender, token) => sender.Send(
                new CreateQuestionCommand(
                    Id, model.Key, model.Text, model.Type, order, model.IsRequired, null,
                    model.NormalizedCustomTypeKey()),
                token),
            $"Question \"{model.Key}\" created.",
            resetForm: false);

        if (created)
        {
            _newQuestion = null;
        }
    }

    /// <summary>
    /// Moves a question by one position. The <b>position index</b> is written as the new
    /// <c>Order</c> – this incidentally repairs duplicate or gappy values where a mere
    /// swap of the two numbers would have no effect. Both updates run in <b>one</b>
    /// gateway call, i.e. in the same DI scope with one error path.
    /// </summary>
    /// <param name="from">The current position of the question.</param>
    /// <param name="to">The target position.</param>
    private async Task MoveQuestionAsync(int from, int to)
    {
        if (_detail is null || to < 0 || to >= _detail.Questions.Count)
        {
            return;
        }

        var ordered = _detail.Questions.ToList();
        (ordered[from], ordered[to]) = (ordered[to], ordered[from]);

        var changed = ordered
            .Select((question, index) => (Question: question, Index: index))
            .Where(entry => entry.Question.Order != entry.Index)
            .ToList();

        if (changed.Count == 0)
        {
            return;
        }

        await RunAsync<Unit>(
            async (sender, token) =>
            {
                foreach (var (question, index) in changed)
                {
                    _ = await sender.Send(
                        // CustomTypeKey travels along like ValidationRules: an update overwrites every
                        // field, so leaving it out here would make reordering a question silently wipe
                        // its custom type.
                        new UpdateQuestionCommand(
                            Id, question.Id, question.Key, question.Text, question.Type, index,
                            question.IsRequired, question.ValidationRules, question.CustomTypeKey),
                        token);
                }

                return Unit.Value;
            },
            "Order changed.",
            resetForm: false);
    }

    private async Task DeleteQuestionAsync(QuestionDetail question)
    {
        _confirmDeleteQuestionId = null;

        await RunAsync<Unit>(
            (sender, token) => sender.Send(new DeleteQuestionCommand(Id, question.Id), token),
            $"Question \"{question.Key}\" deleted.",
            resetForm: false);
    }

    // ---- Transitions / branching (#40) ------------------------------------------------------------

    /// <summary>The outgoing transitions of a question in evaluation order.</summary>
    /// <param name="questionId">The source question.</param>
    /// <returns>The transitions sorted by <c>Priority</c>.</returns>
    private IReadOnlyList<TransitionDetail> Outgoing(Guid questionId)
        => _detail is null ? [] : TransitionWarningAnalyzer.Outgoing(_detail, questionId);

    /// <summary>
    /// Transitions whose source question no longer belongs to the dialog. They do not arise through
    /// the designer – but the admin API deliberately does not check question references, so they are
    /// made visible instead of silently swallowed.
    /// </summary>
    private IReadOnlyList<TransitionDetail> Orphans()
        => _detail is null
            ? []
            : [.. _detail.Transitions.Where(
                transition => _detail.Questions.All(question => question.Id != transition.FromQuestionId))];

    private string QuestionLabel(Guid questionId)
        => _detail?.Questions.FirstOrDefault(question => question.Id == questionId)?.Key
            ?? $"unknown ({questionId})";

    /// <summary>
    /// Indicates whether the transition points to an earlier (or the same) question – this forms a cycle,
    /// i.e. a loop. The marker for it is maintained in the "Loops" section. The rule lives in the
    /// <see cref="LoopAnalyzer"/>, so that list and graph edge claim the same thing.
    /// </summary>
    private bool IsBackJump(TransitionDetail transition)
        => _detail is not null && LoopAnalyzer.IsBackJump(_detail, transition);

    private void StartCreateTransition(Guid? fromQuestionId)
        => _newTransition = new TransitionFormModel { FromQuestionId = fromQuestionId };

    private void OpenTransition(TransitionDetail transition)
        => Navigation.NavigateTo($"dialogs/{Id}/transitions/{transition.Id}");

    /// <summary>
    /// Creates a transition at the end of its source question's priority list. The condition stays
    /// empty at first – it is maintained in the transition editor, where it is validated live.
    /// </summary>
    private async Task CreateTransitionAsync()
    {
        if (_detail is null || _newTransition is null)
        {
            return;
        }

        var model = _newTransition;
        var from = model.FromQuestionId!.Value;
        var target = model.TargetQuestionId!.Value;
        var priority = GraphEditing.NextPriority(_detail, from);

        var created = await RunAsync<TransitionDetail>(
            (sender, token) => sender.Send(
                new CreateTransitionCommand(Id, from, target, null, priority, model.IsDefault), token),
            $"Transition {QuestionLabel(from)} → {QuestionLabel(target)} created.",
            resetForm: false);

        if (created)
        {
            _newTransition = null;
        }
    }

    /// <summary>
    /// Moves a transition within its source question. As with questions and options, the
    /// <b>position index</b> is written as the new <c>Priority</c> (repairs duplicate/gappy values);
    /// all updates run in one gateway call.
    /// </summary>
    /// <param name="fromQuestionId">The source question whose transitions are reordered.</param>
    /// <param name="from">The current position of the transition.</param>
    /// <param name="to">The target position.</param>
    private async Task MoveTransitionAsync(Guid fromQuestionId, int from, int to)
    {
        var changed = GraphEditing.Reorder(Outgoing(fromQuestionId), from, to);
        if (changed.Count == 0)
        {
            return;
        }

        await RunAsync<Unit>(
            async (sender, token) =>
            {
                foreach (var (transition, priority) in changed)
                {
                    _ = await sender.Send(
                        new UpdateTransitionCommand(
                            Id, transition.Id, transition.FromQuestionId, transition.TargetQuestionId,
                            transition.Expression, priority, transition.IsDefault),
                        token);
                }

                return Unit.Value;
            },
            "Order of transitions changed.",
            resetForm: false);
    }

    private async Task DeleteTransitionAsync(TransitionDetail transition)
    {
        _confirmDeleteTransitionId = null;

        await RunAsync<Unit>(
            (sender, token) => sender.Send(new DeleteTransitionCommand(Id, transition.Id), token),
            "Transition deleted.",
            resetForm: false);
    }

    // ---- Loops (#41) ------------------------------------------------------------------------------

    /// <summary>
    /// Back-jump transitions for which (as yet) no loop marker fits. The rule lives in the
    /// <see cref="LoopAnalyzer"/>, because the canvas (#103) offers the same suggestion at the cycle.
    /// </summary>
    /// <returns>The unmarked back-jumps in dialog order.</returns>
    private IReadOnlyList<TransitionDetail> UnmarkedBackJumps()
        => _detail is null ? [] : LoopAnalyzer.UnmarkedBackJumps(_detail);

    private void OpenLoop(LoopDetail loop)
        => Navigation.NavigateTo($"dialogs/{Id}/loops/{loop.Id}");

    /// <summary>
    /// Opens the creation form – already pre-filled from a back-jump: its target question is
    /// the entry question, its source question the breaking question.
    /// </summary>
    /// <param name="backJump">The back-jump to pre-fill from, or <see langword="null"/> for an empty form.</param>
    private void StartCreateLoop(TransitionDetail? backJump)
    {
        if (_detail is null || backJump is null)
        {
            _newLoop = new LoopFormModel();
            return;
        }

        var entry = _detail.Questions.FirstOrDefault(question => question.Id == backJump.TargetQuestionId);

        _newLoop = new LoopFormModel
        {
            EntryQuestionId = backJump.TargetQuestionId,
            BreakingQuestionId = backJump.FromQuestionId,
            CollectionKey = entry is null ? string.Empty : LoopFormModel.SuggestCollectionKey(entry.Key, _detail),
        };
    }

    private async Task CreateLoopAsync()
    {
        if (_detail is null || _newLoop is null)
        {
            return;
        }

        var model = _newLoop;

        var created = await RunAsync<LoopDetail>(
            (sender, token) => sender.Send(
                new CreateLoopCommand(
                    Id, model.CollectionKey, model.EntryQuestionId!.Value, model.BreakingQuestionId!.Value),
                token),
            $"Loop \"{model.CollectionKey}\" marked.",
            resetForm: false);

        if (created)
        {
            _newLoop = null;
        }
    }

    private async Task DeleteLoopAsync(LoopDetail loop)
    {
        _confirmDeleteLoopId = null;

        await RunAsync<Unit>(
            (sender, token) => sender.Send(new DeleteLoopCommand(Id, loop.Id), token),
            $"Loop \"{loop.CollectionKey}\" deleted.",
            resetForm: false);
    }

    // ---- Triggers (#42) ---------------------------------------------------------------------------

    private void StartCreateTrigger() => _newTrigger = new TriggerFormModel();

    private void OpenTrigger(TriggerDetail trigger)
        => Navigation.NavigateTo($"dialogs/{Id}/triggers/{trigger.Id}");

    /// <summary>
    /// Describes the target of a trigger for the overview: the webhook URL or the
    /// event name. Unreadable configuration is shown raw instead of concealed – at runtime
    /// the webhook handler skips such entries.
    /// </summary>
    /// <param name="trigger">The trigger to display.</param>
    /// <returns>The display text for the "Target" column.</returns>
    private static string TriggerTarget(TriggerDetail trigger)
    {
        if (!TriggerConfig.TryParse(trigger.Config, out var config, out _))
        {
            return trigger.Config;
        }

        return config.Url ?? config.Name ?? "—";
    }

    /// <summary>
    /// Creates a trigger. The condition stays empty at first – it is maintained in the trigger editor,
    /// where it is validated live.
    /// </summary>
    private async Task CreateTriggerAsync()
    {
        if (_detail is null || _newTrigger is null)
        {
            return;
        }

        var model = _newTrigger;

        if (TriggerLabels.RequiresQuestion(model.Scope) && model.QuestionId is null)
        {
            _error = "Please choose a question – a trigger after a specific question needs its reference.";
            _message = null;
            return;
        }

        if (!model.TryBuildConfig(out var config, out var configError))
        {
            _error = configError;
            _message = null;
            return;
        }

        var created = await RunAsync<TriggerDetail>(
            (sender, token) => sender.Send(
                new CreateTriggerCommand(
                    Id, model.Scope, model.NormalizedQuestionId(), model.Kind, config, null),
                token),
            $"Trigger \"{TriggerLabels.Describe(model.Scope)}\" created.",
            resetForm: false);

        if (created)
        {
            _newTrigger = null;
        }
    }

    private async Task DeleteTriggerAsync(TriggerDetail trigger)
    {
        _confirmDeleteTriggerId = null;

        await RunAsync<Unit>(
            (sender, token) => sender.Send(new DeleteTriggerCommand(Id, trigger.Id), token),
            "Trigger deleted.",
            resetForm: false);
    }

    // ---- Test runner (#43) ------------------------------------------------------------------------

    private void OpenTestRunner() => Navigation.NavigateTo($"dialogs/{Id}/test");

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            var result = await Admin.ExecuteAsync(
                (sender, token) => sender.Send(new DeleteDialogCommand(Id), token));

            if (!result.Success)
            {
                _error = result.Error;
                _confirmDelete = false;
                return;
            }

            Navigation.NavigateTo("dialogs");
        }
        finally
        {
            _busy = false;
        }
    }
}
