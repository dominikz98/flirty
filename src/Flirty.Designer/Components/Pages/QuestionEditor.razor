@* Deliberately NOT named "QuestionDetail": the component type would otherwise shadow the
   view type Flirty.Runtime.Admin.QuestionDetail of the same name (as with DialogEditor/DialogDetail). *@
@page "/dialogs/{DialogId:guid}/questions/{QuestionId:guid}"
@rendermode InteractiveServer
@using Mediator
@using Flirty.Domain
@using Flirty.Runtime.Admin
@using Flirty.Validation
@inject FlirtyAdminGateway Admin
@inject NavigationManager Navigation
@inject FlirtyQuestionTypeRegistry QuestionTypes

<PageTitle>@(_question?.Key ?? "Question") · Flirty Designer</PageTitle>

<p class="back"><a href="@($"dialogs/{DialogId}")">← @(_detail?.Dialog.Name ?? "Dialog")</a></p>

@if (_question is null)
{
    <h1>Question</h1>

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    else
    {
        <p class="empty">Loading …</p>
    }
}
else
{
    <h1>
        @_question.Key
        @if (_detail!.Dialog.StartQuestionId == QuestionId)
        {
            <span class="badge badge-start">Entry question</span>
        }
    </h1>

    <p class="intro">
        Position @(_position + 1) of @_detail.Questions.Count in the dialog
        <a href="@($"dialogs/{DialogId}")">@_detail.Dialog.Name</a> ·
        Type @QuestionTypeLabels.Describe(_question.Type, _question.CustomTypeKey, QuestionTypes)
    </p>

    @if (_detail.Dialog.IsPublished)
    {
        <div class="banner warn">
            The dialog is published in version @_detail.Dialog.Version: its graph is <strong>locked</strong>,
            so that running sessions do not break. To change it, create a new version in the
            <a href="@($"dialogs/{DialogId}")">dialog editor</a> or unpublish the dialog.
        </div>
    }

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    @if (_message is not null)
    {
        <div class="banner ok">@_message</div>
    }

    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="editor">
            <h2>Question</h2>

            <div class="field">
                <label for="key">Key</label>
                <InputText id="key" class="input" @bind-Value="_form.Key" />
                <span class="hint">
                    Business-level, stable key – unique within the dialog and visible in the expression
                    context of branching. Renaming it breaks conditions that use it.
                </span>
                <ValidationMessage For="() => _form.Key" />
            </div>

            <div class="field">
                <label for="text">Question text</label>
                <InputTextArea id="text" class="input" rows="3" @bind-Value="_form.Text" />
                <ValidationMessage For="() => _form.Text" />
            </div>

            <PlaceholderReference @bind-Value="_form.Text" />

            @* A raw select rather than InputSelect: the list holds host-declared types (#137) too, and
               those are not enum members. The selection is DERIVED from type + key, so the dropdown and
               the key field below cannot drift apart. *@
            <div class="field">
                <label for="type">Type</label>
                <select id="type" class="input"
                        value="@QuestionTypeLabels.ChoiceValue(_form.Type, _form.CustomTypeKey, QuestionTypes)"
                        @onchange="args => ChooseType(args.Value as string)">
                    @foreach (var choice in QuestionTypeLabels.Choices(QuestionTypes))
                    {
                        <option value="@choice.Value">@choice.Label</option>
                    }
                </select>
                <span class="hint">The type determines how the answer is parsed and validated.</span>
            </div>

            @* Only shown for Json, which makes the core guard ("a custom type key needs type Json")
               unreachable from this form instead of merely enforced afterwards. *@
            @if (_form.Type == QuestionType.Json)
            {
                <div class="field">
                    <label for="customTypeKey">Custom type key</label>
                    <InputText id="customTypeKey" class="input mono" @bind-Value="_form.CustomTypeKey" />
                    <span class="hint">
                        Optional. The key the host declared the type under
                        (<code>o.AddQuestionType("color", …)</code>). The key is deliberately
                        <strong>not</strong> checked – an unknown one is not an error, the answer is then
                        validated as JSON only. Leave empty for a plain JSON question.
                        @if (QuestionTypes.Types.Count > 0)
                        {
                            <text>
                                The types this designer knows are listed under
                                <a href="question-types">Question types</a>; picking one above fills this
                                field for you.
                            </text>
                        }
                    </span>
                </div>
            }

            <div class="field check">
                <InputCheckbox id="required" @bind-Value="_form.IsRequired" />
                <label for="required">Answer required</label>
            </div>

            <div class="field">
                <label>Order</label>
                <span class="hint">
                    Position @(_position + 1) – changeable via the arrows in the
                    <a href="@($"dialogs/{DialogId}")">question list of the dialog</a>.
                </span>
            </div>
        </div>

        <div class="editor">
            <h2>Validation</h2>

            @if (_form.UseRawJson)
            {
                <div class="banner warn">
                    The saved rules contain unknown fields or are not a valid JSON object. They are
                    therefore edited raw, so that nothing is lost. Known fields are
                    <code>minLength</code>, <code>maxLength</code>, <code>min</code>,
                    <code>max</code> and <code>pattern</code>.
                </div>

                <div class="field">
                    <label for="rawRules">Rules (JSON)</label>
                    <InputTextArea id="rawRules" class="input mono" rows="5" @bind-Value="_form.RawJson" />
                    <span class="hint">Clear to remove the rules.</span>
                </div>
            }
            else if (_form.Type == QuestionType.FreeText)
            {
                <div class="field">
                    <label for="minLength">Minimum length (characters)</label>
                    <InputNumber id="minLength" class="input" @bind-Value="_form.MinLength" />
                </div>

                <div class="field">
                    <label for="maxLength">Maximum length (characters)</label>
                    <InputNumber id="maxLength" class="input" @bind-Value="_form.MaxLength" />
                </div>

                <div class="field">
                    <label for="pattern">Pattern (regular expression)</label>
                    <InputText id="pattern" class="input mono" @bind-Value="_form.Pattern" />
                    <span class="hint">
                        Partial match – anchor it for a full check (e.g. <code>^[A-Za-z ]+$</code>).
                        The pattern is compiled on save; an invalid expression is rejected.
                    </span>
                </div>
            }
            else if (_form.Type == QuestionType.Number)
            {
                <div class="field">
                    <label for="min">Minimum (inclusive)</label>
                    <InputNumber id="min" class="input" @bind-Value="_form.Min" />
                </div>

                <div class="field">
                    <label for="max">Maximum (inclusive)</label>
                    <InputNumber id="max" class="input" @bind-Value="_form.Max" />
                </div>
            }
            else if (_form.Type == QuestionType.Json)
            {
                <p class="hint">
                    The engine only checks that the value is well-formed JSON. A host-declared custom type
                    adds its own check in the host application (its registered
                    <code>IQuestionTypeValidator</code>) – the designer does not know it and cannot show
                    its rules here.
                </p>
            }
            else
            {
                <p class="hint">
                    This question type has no configurable rules – the value itself is checked
                    (for choice types against the answer options below).
                </p>
            }
        </div>

        <div class="actions">
            <button type="submit" class="btn btn-primary" disabled="@(_busy || !Editable)">Save</button>
            <button type="button" class="btn" disabled="@(_busy || !Editable)" @onclick="ResetForm">Reset</button>
        </div>
    </EditForm>

    @if (QuestionTypeLabels.UsesOptions(_question.Type) || _question.Options.Count > 0)
    {
        <div class="editor">
            <h2>Answer options</h2>

            @* A custom type is the one case where "does not evaluate options" must not become "so delete
               them": its validator receives question.Options and may well read them. *@
            @if (_question.Type == QuestionType.Json)
            {
                <div class="banner warn">
                    The engine does not evaluate answer options for
                    @QuestionTypeLabels.Describe(_question.Type, _question.CustomTypeKey, QuestionTypes) – but it passes
                    them to the host's validator, which may read them. Only delete them if the host does not.
                </div>
            }
            else if (!QuestionTypeLabels.UsesOptions(_question.Type))
            {
                <div class="banner warn">
                    The question type @QuestionTypeLabels.Describe(_question.Type) does not evaluate answer
                    options – the following options have no effect and can be deleted.
                </div>
            }
            else if (_question.Options.Count == 0)
            {
                <div class="banner warn">
                    Without options no answer to this question is valid.
                </div>
            }

            @if (_question.Options.Count > 0)
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Key</th>
                            <th>Label</th>
                            <th>Value</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < _question.Options.Count; index++)
                        {
                            // Local copies: otherwise the lambdas would run against the loop state
                            // after the last iteration.
                            var position = index;
                            var option = _question.Options[index];

                            <tr>
                                <td>@(position + 1)</td>
                                <td class="mono">@option.Key</td>
                                <td>@option.Label</td>
                                <td class="mono">@option.Value</td>
                                <td class="row-actions">
                                    <button class="btn" title="Move up"
                                            disabled="@(_busy || !Editable || position == 0)"
                                            @onclick="() => MoveOptionAsync(position, position - 1)">↑</button>
                                    <button class="btn" title="Move down"
                                            disabled="@(_busy || !Editable || position == _question.Options.Count - 1)"
                                            @onclick="() => MoveOptionAsync(position, position + 1)">↓</button>
                                    <button class="btn" disabled="@(_busy || !Editable)"
                                            @onclick="() => StartEditOption(option)">Edit</button>

                                    @if (_confirmDeleteOptionId == option.Id)
                                    {
                                        <span class="confirm">Delete option?</span>
                                        <button class="btn btn-danger" disabled="@(_busy || !Editable)"
                                                @onclick="() => DeleteOptionAsync(option)">Yes, delete</button>
                                        <button class="btn" disabled="@(_busy || !Editable)"
                                                @onclick="() => _confirmDeleteOptionId = null">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-danger" disabled="@(_busy || !Editable)"
                                                @onclick="() => _confirmDeleteOptionId = option.Id">Delete</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (_optionForm is null)
            {
                <div class="actions">
                    <button class="btn btn-primary" disabled="@(_busy || !Editable)" @onclick="StartCreateOption">New option</button>
                </div>
            }
            else
            {
                <EditForm Model="_optionForm" OnValidSubmit="SaveOptionAsync">
                    <DataAnnotationsValidator />

                    <h3>@(_editedOptionId is null ? "New option" : "Edit option")</h3>

                    <div class="field-row">
                        <div class="field">
                            <label for="optionKey">Key</label>
                            <InputText id="optionKey" class="input" @bind-Value="_optionForm.Key" />
                            <ValidationMessage For="() => _optionForm.Key" />
                        </div>

                        <div class="field">
                            <label for="optionLabel">Label</label>
                            <InputText id="optionLabel" class="input" @bind-Value="_optionForm.Label" />
                            <ValidationMessage For="() => _optionForm.Label" />
                        </div>

                        <div class="field">
                            <label for="optionValue">Value</label>
                            <InputText id="optionValue" class="input" @bind-Value="_optionForm.Value" />
                            <ValidationMessage For="() => _optionForm.Value" />
                        </div>
                    </div>

                    <span class="hint">
                        The <em>value</em> is what gets saved and validated; the label is pure
                        display text for the host UI.
                    </span>

                    <div class="actions">
                        <button type="submit" class="btn btn-primary" disabled="@(_busy || !Editable)">Save</button>
                        <button type="button" class="btn" disabled="@(_busy || !Editable)" @onclick="CancelEditOption">Cancel</button>
                    </div>
                </EditForm>
            }
        </div>
    }

    <div class="editor">
        <h2>Delete question</h2>

        <p class="hint">
            Deleting the question also removes its answer options and all transitions that use it as source
            or target question. If it is the entry question, that is reset.
        </p>

        <div class="actions">
            @if (_confirmDelete)
            {
                <span class="confirm">Really delete question "@_question.Key"?</span>
                <button class="btn btn-danger" disabled="@(_busy || !Editable)" @onclick="DeleteAsync">Yes, delete</button>
                <button class="btn" disabled="@(_busy || !Editable)" @onclick="() => _confirmDelete = false">Cancel</button>
            }
            else
            {
                <button class="btn btn-danger" disabled="@(_busy || !Editable)" @onclick="() => _confirmDelete = true">Delete</button>
            }
        </div>
    </div>
}

@code {
    /// <summary>The primary key of the dialog (from the route).</summary>
    [Parameter]
    public Guid DialogId { get; set; }

    /// <summary>The primary key of the edited question (from the route).</summary>
    [Parameter]
    public Guid QuestionId { get; set; }

    /// <summary>
    /// Whether the graph is editable: on a published version the engine rejects graph changes with a
    /// conflict (<c>DialogPublishedException</c>), so that running sessions do not break. The lock
    /// mirrors that in the UI.
    /// </summary>
    private bool Editable => _detail is not null && !_detail.Dialog.IsPublished;
    private DialogDetail? _detail;
    private QuestionDetail? _question;
    private int _position;
    private QuestionFormModel _form = new();
    private AnswerOptionFormModel? _optionForm;
    private Guid? _editedOptionId;
    private Guid? _confirmDeleteOptionId;
    private string? _error;
    private string? _message;
    private bool _busy;
    private bool _confirmDelete;
    private (Guid Dialog, Guid Question) _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == (DialogId, QuestionId))
        {
            return;
        }

        _loaded = (DialogId, QuestionId);
        _message = null;
        _confirmDelete = false;
        _confirmDeleteOptionId = null;
        _optionForm = null;
        _editedOptionId = null;
        await ReloadAsync();
    }

    /// <summary>
    /// Loads the dialog graph and picks out the edited question. A single <c>GetDialogQuery</c> suffices:
    /// it delivers questions including options plus the dialog metadata for the title, entry question and
    /// publication hint.
    /// </summary>
    private async Task ReloadAsync(bool resetForm = true)
    {
        var result = await Admin.ExecuteAsync((sender, token) => sender.Send(new GetDialogQuery(DialogId), token));
        _detail = result.Value;
        _error = result.Error;

        _position = _detail is null
            ? -1
            : _detail.Questions.Select((question, index) => (question, index))
                .Where(entry => entry.question.Id == QuestionId)
                .Select(entry => entry.index)
                .DefaultIfEmpty(-1)
                .First();
        _question = _position < 0 ? null : _detail!.Questions[_position];

        if (_detail is not null && _question is null)
        {
            _error = $"The dialog '{DialogId}' contains no question with the id '{QuestionId}'.";
        }

        if (resetForm)
        {
            ResetForm();
        }
    }

    private void ResetForm()
    {
        if (_question is not null)
        {
            _form = QuestionFormModel.From(_question);
        }
    }

    /// <summary>
    /// Applies a pick from the type dropdown. A host-declared type (#137) sets <c>Json</c> plus its key;
    /// a built-in one clears the key, so what the form shows is what gets saved – the key field is hidden
    /// for every other type, and <c>NormalizedCustomTypeKey</c> would drop it anyway.
    /// </summary>
    private void ChooseType(string? choiceValue)
    {
        if (!QuestionTypeLabels.TryResolveChoice(choiceValue, out var type, out var key))
        {
            return;
        }

        _form.Type = type;
        _form.CustomTypeKey = key;
    }

    /// <summary>
    /// Saves metadata and validation rules in a single <c>UpdateQuestionCommand</c>. Invalid rules
    /// (a broken pattern, swapped bounds, unreadable raw JSON) are caught beforehand – otherwise the
    /// engine would only notice them when validating an answer at runtime.
    /// </summary>
    private async Task SaveAsync()
    {
        if (!_form.TryBuildValidationRules(out var rules, out var ruleError))
        {
            _error = ruleError;
            _message = null;
            return;
        }

        await RunAsync<QuestionDetail>(
            (sender, token) => sender.Send(
                new UpdateQuestionCommand(
                    DialogId, QuestionId, _form.Key, _form.Text, _form.Type, _question!.Order,
                    _form.IsRequired, rules, _form.NormalizedCustomTypeKey()),
                token),
            "Question saved.");
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            var result = await Admin.ExecuteAsync(
                (sender, token) => sender.Send(new DeleteQuestionCommand(DialogId, QuestionId), token));

            if (!result.Success)
            {
                _error = result.Error;
                _confirmDelete = false;
                return;
            }

            Navigation.NavigateTo($"dialogs/{DialogId}");
        }
        finally
        {
            _busy = false;
        }
    }

    // ---- Answer options ---------------------------------------------------------------------------

    private void StartCreateOption()
    {
        _optionForm = new AnswerOptionFormModel();
        _editedOptionId = null;
    }

    private void StartEditOption(AnswerOptionDetail option)
    {
        _optionForm = AnswerOptionFormModel.From(option);
        _editedOptionId = option.Id;
    }

    private void CancelEditOption()
    {
        _optionForm = null;
        _editedOptionId = null;
    }

    private async Task SaveOptionAsync()
    {
        if (_question is null || _optionForm is null)
        {
            return;
        }

        var model = _optionForm;
        var edited = _editedOptionId;

        bool saved;
        if (edited is { } optionId)
        {
            var order = _question.Options.First(option => option.Id == optionId).Order;
            saved = await RunAsync<AnswerOptionDetail>(
                (sender, token) => sender.Send(
                    new UpdateAnswerOptionCommand(
                        DialogId, QuestionId, optionId, model.Key, model.Label, model.Value, order),
                    token),
                $"Option \"{model.Key}\" saved.",
                resetForm: false);
        }
        else
        {
            var order = _question.Options.Count == 0 ? 0 : _question.Options.Max(option => option.Order) + 1;
            saved = await RunAsync<AnswerOptionDetail>(
                (sender, token) => sender.Send(
                    new CreateAnswerOptionCommand(
                        DialogId, QuestionId, model.Key, model.Label, model.Value, order),
                    token),
                $"Option \"{model.Key}\" created.",
                resetForm: false);
        }

        if (saved)
        {
            CancelEditOption();
        }
    }

    private async Task DeleteOptionAsync(AnswerOptionDetail option)
    {
        _confirmDeleteOptionId = null;

        await RunAsync<Unit>(
            (sender, token) => sender.Send(new DeleteAnswerOptionCommand(DialogId, QuestionId, option.Id), token),
            $"Option \"{option.Key}\" deleted.",
            resetForm: false);
    }

    /// <summary>
    /// Moves an option by one position. As with the questions, the <b>position index</b> is written as
    /// the new <c>Order</c> (repairs duplicate/gapped values); all updates run in a single gateway call.
    /// </summary>
    /// <param name="from">The current position of the option.</param>
    /// <param name="to">The target position.</param>
    private async Task MoveOptionAsync(int from, int to)
    {
        if (_question is null || to < 0 || to >= _question.Options.Count)
        {
            return;
        }

        var ordered = _question.Options.ToList();
        (ordered[from], ordered[to]) = (ordered[to], ordered[from]);

        var changed = ordered
            .Select((option, index) => (Option: option, Index: index))
            .Where(entry => entry.Option.Order != entry.Index)
            .ToList();

        if (changed.Count == 0)
        {
            return;
        }

        await RunAsync<Unit>(
            async (sender, token) =>
            {
                foreach (var (option, index) in changed)
                {
                    _ = await sender.Send(
                        new UpdateAnswerOptionCommand(
                            DialogId, QuestionId, option.Id, option.Key, option.Label, option.Value, index),
                        token);
                }

                return Unit.Value;
            },
            "Order of options changed.",
            resetForm: false);
    }

    /// <summary>
    /// Runs a writing operation, shows success or error and reloads the graph.
    /// </summary>
    /// <typeparam name="TResult">The result type of the operation.</typeparam>
    /// <param name="operation">The admin message to execute.</param>
    /// <param name="successMessage">The message shown on success.</param>
    /// <param name="resetForm">
    /// Whether the question form should be overwritten from the server state. For option operations
    /// deliberately <see langword="false"/>, so that not-yet-saved input there is preserved.
    /// </param>
    /// <returns><see langword="true"/> if the operation succeeded.</returns>
    private async Task<bool> RunAsync<TResult>(
        Func<ISender, CancellationToken, ValueTask<TResult>> operation,
        string successMessage,
        bool resetForm = true)
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Admin.ExecuteAsync(operation);
            if (!result.Success)
            {
                _error = result.Error;
                return false;
            }

            _error = null;
            _message = successMessage;
            await ReloadAsync(resetForm);
            return true;
        }
        finally
        {
            _busy = false;
        }
    }
}
