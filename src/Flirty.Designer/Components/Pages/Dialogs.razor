@page "/dialogs"
@rendermode InteractiveServer
@using Flirty.Runtime.Admin
@inject FlirtyAdminGateway Admin
@inject NavigationManager Navigation

<PageTitle>Dialogs · Flirty Designer</PageTitle>

<h1>Dialogs</h1>

<p class="intro">
    Here you create and edit dialogs. A new dialog starts as a <em>draft</em>; to publish it needs an
    entry question. Work happens against the active
    <a href="connections">connection profile</a>.
</p>

@if (_error is not null)
{
    <div class="banner err">@_error</div>
}

@if (_createModel is null)
{
    <button class="btn btn-primary" @onclick="StartCreate">New dialog</button>
}
else
{
    <div class="editor">
        <h2>New dialog</h2>
        <EditForm Model="_createModel" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="key">Key</label>
                <InputText id="key" class="input" @bind-Value="_createModel.Key" />
                <span class="hint">Business-level, stable key – must be unique (e.g. <code>onboarding</code>).</span>
                <ValidationMessage For="() => _createModel.Key" />
            </div>

            <div class="field">
                <label for="name">Name</label>
                <InputText id="name" class="input" @bind-Value="_createModel.Name" />
                <ValidationMessage For="() => _createModel.Name" />
            </div>

            <div class="field">
                <label for="description">Description</label>
                <InputTextArea id="description" class="input" rows="2" @bind-Value="_createModel.Description" />
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary" disabled="@_busy">Create</button>
                <button type="button" class="btn" disabled="@_busy" @onclick="CancelCreate">Cancel</button>
            </div>
        </EditForm>
    </div>
}

@if (_dialogs.Count > 0)
{
    <div class="field filter">
        <label for="filter">Filter</label>
        <input id="filter" class="input" placeholder="Key or name" @bind="_filter" @bind:event="oninput" />
    </div>
}

@if (_dialogs.Count == 0)
{
    <p class="empty">No dialogs created yet.</p>
}
else if (FilteredDialogs.Count == 0)
{
    <p class="empty">No dialog matches the filter "@_filter".</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Key</th>
                <th>Name</th>
                <th>Version</th>
                <th>Status</th>
                <th>Entry question</th>
                <th>Changed</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var dialog in FilteredDialogs)
            {
                <tr>
                    <td class="mono">@dialog.Key</td>
                    <td>@dialog.Name</td>
                    <td>@dialog.Version</td>
                    <td>
                        @if (dialog.IsPublished)
                        {
                            <span class="badge badge-published">Published</span>
                        }
                        else
                        {
                            <span class="badge badge-draft">Draft</span>
                        }
                    </td>
                    <td>@(dialog.StartQuestionId is null ? "—" : "set")</td>
                    <td>@dialog.UpdatedAt.LocalDateTime.ToString("g")</td>
                    <td class="row-actions">
                        <button class="btn" @onclick="() => Open(dialog)">Open</button>
                        <button class="btn" @onclick="() => OpenGraph(dialog)">Graph</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<DialogSummary> _dialogs = [];
    private DialogFormModel? _createModel;
    private string _filter = string.Empty;
    private string? _error;
    private bool _busy;

    private IReadOnlyList<DialogSummary> FilteredDialogs
        => string.IsNullOrWhiteSpace(_filter)
            ? _dialogs
            : [.. _dialogs.Where(dialog =>
                dialog.Key.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || dialog.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase))];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        var result = await Admin.ExecuteAsync((sender, token) => sender.Send(new ListDialogsQuery(), token));
        _dialogs = result.Value ?? [];
        _error = result.Error;
    }

    private void StartCreate() => _createModel = new DialogFormModel();

    private void CancelCreate() => _createModel = null;

    private async Task CreateAsync()
    {
        if (_createModel is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Admin.ExecuteAsync((sender, token) => sender.Send(
                new CreateDialogCommand(_createModel.Key, _createModel.Name, _createModel.Description), token));

            if (!result.Success)
            {
                _error = result.Error;
                return;
            }

            _createModel = null;
            _error = null;
            // Straight to the detail page: entry question and publication are maintained there.
            Navigation.NavigateTo($"dialogs/{result.Value!.Id}");
        }
        finally
        {
            _busy = false;
        }
    }

    private void Open(DialogSummary dialog) => Navigation.NavigateTo($"dialogs/{dialog.Id}");

    /// <summary>Opens the read-only graph view (#101) – the flow instead of the form list.</summary>
    private void OpenGraph(DialogSummary dialog) => Navigation.NavigateTo($"dialogs/{dialog.Id}/graph");
}
