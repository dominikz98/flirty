    private string EdgeClasses(GraphEdge edge)
    {
        var classes = new List<string>(5) { $"shape-{edge.Shape.ToString().ToLowerInvariant()}" };

        if (edge.IsDefault)
        {
            classes.Add("is-default");
        }

        if (edge.IsBackJump)
        {
            classes.Add("is-backjump");
        }

        // Ein Rücksprung ohne Marker ist auf der Fläche erkennbar, weil der Vorschlag „als Schleife
        // markieren" an genau dieser Kante hängt (#103). Die Markierung trägt zusätzlich zur Farbe eine
        // eigene Strichform – keine Aussage darf allein an der Farbe hängen (Befund #95).
        if (_unmarkedBackJumps.Contains(edge.TransitionId))
        {
            classes.Add("is-unmarked");
        }

        if (edge.Warnings.Count > 0)
        {
            classes.Add("has-warning");
        }

        return string.Join(" ", classes);
    }

    private static string LoopLabel(GraphLoopFrame loop)
    {
        var label = $"Schleife {loop.CollectionKey}, Einstieg {loop.EntryKey}, Breaking Question {loop.BreakingKey}";

        return loop.Warnings.Count == 0 ? label + "." : $"{label}, {loop.Warnings.Count} Warnung(en).";
    }

    private RenderFragment ScopeMarker(GraphScopeMarker marker) => @<g class="graph-scope-marker">
        <foreignObject x="@SvgFormat.N(marker.X)" y="@SvgFormat.N(marker.Y)"
                       width="@SvgFormat.N(Math.Max(GraphMetrics.NodeWidth, 260))" height="48">
            <div class="graph-scope">
                <span class="graph-scope-title">@marker.Title</span>
                <span class="graph-chips">
                    @foreach (var trigger in marker.Triggers)
                    {
                        <button type="button"
                                class="chip @(trigger.Kind == TriggerKind.Webhook ? "chip-webhook" : "chip-inprocess")"
                                title="@trigger.Title"
                                @onclick="() => OpenTrigger(trigger.TriggerId)">@trigger.Label</button>
                    }
                </span>
            </div>
        </foreignObject>
    </g>;

    private async Task ReleaseModuleAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach", _canvas);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit schon weg (Reload oder Schließen) – es gibt nichts mehr aufzuräumen.
            }

            _module = null;
        }

        _self?.Dispose();
        _self = null;
    }

    public async ValueTask DisposeAsync() => await ReleaseModuleAsync();
