    /// <summary>Leitet eine neue Version ab und bleibt dabei auf dem Canvas.</summary>
    /// <remarks>
    /// Anders als der <c>DialogEditor</c>, der in seinen eigenen Editor springt: Wer hier arbeitet, will
    /// am Graphen weiterarbeiten, nicht in der Liste.
    /// </remarks>
    private async Task CreateVersionAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;

        try
        {
            var result = await Admin.ExecuteAsync(
                (sender, token) => sender.Send(new CreateDialogVersionCommand(Id), token));

            if (!result.Success || result.Value is null)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            Navigation.NavigateTo($"dialogs/{result.Value.Dialog.Id}/graph");
        }
        finally
        {
            _busy = false;
        }
    }

    // ---- Verschieben (#102) -------------------------------------------------------------------------

    /// <summary>
    /// Übernimmt die neue Position eines Knotens, nachdem der Zug im Browser beendet wurde.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Während des Ziehens schreibt das Modul nur das <c>transform</c> des Knotens (ADR 0006). Der Commit
    /// schreibt denselben Wert anschließend aus C# – die Ansicht springt dabei nicht, weil
    /// <c>SvgFormat.N</c> ganze Zahlen genauso formatiert wie das Modul.
    /// </para>
    /// <para>
    /// Ein Fehlschlag baut das Modell aus dem <b>gespeicherten</b> Stand neu: Der Knoten springt dann
    /// sichtbar zurück. Ihn stehen zu lassen behauptete eine Position, die es in der Datenbank nicht
    /// gibt – und der nächste Reload widerspräche.
    /// </para>
    /// <para>
    /// Prüft bewusst <b>nicht</b> auf <see cref="Editable"/>: Eine Position gehört nicht zum Graphen,
    /// ein veröffentlichter Dialog muss anordbar bleiben (ADR 0007). Der Gesten-Riegel gilt trotzdem –
    /// nicht wegen des Upserts, sondern damit sich ein Zug nicht mit einer fliegenden Graph-Änderung
    /// verschränkt und auf einem Stand aufsetzt, den der Reload gleich ersetzt.
    /// </para>
    /// </remarks>
    /// <param name="questionId">Die verschobene Frage.</param>
    /// <param name="x">Die neue waagerechte Canvas-Koordinate in px.</param>
    /// <param name="y">Die neue senkrechte Canvas-Koordinate in px.</param>
    [JSInvokable]
    public async Task MoveNodeAsync(Guid questionId, int x, int y)
    {
        if (_busy || _detail is null)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await Admin.ExecuteAsync((sender, token) =>
                sender.Send(Position(questionId, x, y), token));

            if (result.Success)
            {
                Rebuild(result.Value!);
            }
            else
            {
                _error = result.Error;
                Rebuild(_detail.Layout);
            }
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>Verwirft alle gespeicherten Positionen; danach greift wieder das Auto-Layout.</summary>
    private async Task ResetLayoutAsync()
    {
        _confirmLayoutReset = false;

        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await Admin.ExecuteAsync((sender, token) =>
                sender.Send(new ResetDialogLayoutCommand(Id), token));

            if (result.Success)
            {
                Rebuild([]);
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Das Modul selbst ist die Wahrheit darüber, ob gebunden ist – ein zusätzliches Flag müsste an
        // jedem Dialogwechsel mit zurückgesetzt werden. Der Canvas existiert jetzt auch ohne Knoten
        // (er ist die Ablagefläche für die erste Frage), die Knotenzahl ist also keine Bedingung mehr.
        if (_module is not null || _model is null)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Pages/DialogGraph.razor.js");
        _self = DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync(
            "attach",
            _canvas,
            _self,
            new
            {
                minZoom = GraphMetrics.MinZoom,
                maxZoom = GraphMetrics.MaxZoom,
                zoomStep = GraphMetrics.ZoomStep,
                nodeWidth = GraphMetrics.NodeWidth,
                nodeHeight = GraphMetrics.NodeHeight,
            });
    }

