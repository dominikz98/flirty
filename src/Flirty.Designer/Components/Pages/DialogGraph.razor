@* Deliberately NOT named "DialogGraphModel" or similar: the component type would otherwise shadow the
   equally named view type (as with DialogEditor/QuestionEditor). *@
@page "/dialogs/{Id:guid}/graph"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Mediator
@using Flirty.Domain
@using Flirty.Runtime.Admin
@inject FlirtyAdminGateway Admin
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_model?.Dialog.Name ?? "Graph") · Graph · Flirty Designer</PageTitle>

<p class="back"><a href="@($"dialogs/{Id}")">← @(_model?.Dialog.Name ?? "Dialog")</a></p>

@if (_model is null)
{
    <h1>Graph</h1>

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    else
    {
        <p class="empty">Loading …</p>
    }
}
else
{
    <h1>
        @_model.Dialog.Name
        @if (_model.Dialog.IsPublished)
        {
            <span class="badge badge-published">Published</span>
        }
        else
        {
            <span class="badge badge-draft">Draft</span>
        }
    </h1>

    <p class="intro">
        Flow of the dialog <span class="mono">@_model.Dialog.Key</span> in version @_model.Dialog.Version.
        Drag building blocks from the palette, connect nodes at the <span class="mono">＋</span>, edit the
        selection in the inspector. Every gesture writes <b>immediately</b> – there is no undo, so deletion
        is confirmed.
    </p>

    @if (!Editable)
    {
        @* Wording from the dialog editor and the four sub-editors – the same rule should sound the same
           everywhere. Extended by the sentence about moving: without it the disabled
           surroundings would read like a defect. *@
        <div class="banner warn">
            <p>
                This dialog is published in version @_model.Dialog.Version and therefore
                <strong>locked</strong>: questions, transitions, loops and triggers cannot be
                changed. Running sessions keep working on this version – a change would break
                them.
            </p>
            <p>
                <b>Moving stays allowed</b>, because a position does not belong to the graph. To
                evolve it, create a <strong>new version</strong> (a copy as a draft; the
                published version stays unchanged).
            </p>
            <div class="actions">
                <button class="btn btn-primary" disabled="@_busy" @onclick="CreateVersionAsync">
                    Create new version
                </button>
            </div>
        </div>
    }

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }

    @if (_message is not null)
    {
        <div class="banner ok">@_message</div>
    }

    @foreach (var warning in _model.DialogWarnings)
    {
        <div class="banner warn">@warning.Text</div>
    }

    @if (_model.OrphanTransitions.Count > 0 || _model.OrphanTriggers.Count > 0)
    {
        <div class="banner warn">
            @if (_model.OrphanTransitions.Count > 0)
            {
                <p>
                    @_model.OrphanTransitions.Count transition(s) point to an unknown question
                    and cannot be drawn. They are never evaluated and must be deleted in the
                    <a href="@($"dialogs/{Id}")">dialog editor</a>.
                </p>
            }
            @if (_model.OrphanTriggers.Count > 0)
            {
                <p>
                    @_model.OrphanTriggers.Count trigger(s) reference a deleted question and never
                    fire.
                </p>
            }
        </div>
    }

    @if (_linkFrom is { } linkSource)
    {
        <div class="banner warn">
            Connection from <span class="mono">@QuestionKey(linkSource)</span> – now choose the target
            question (click a node or tab to it and confirm).
            <div class="actions">
                <button class="btn" disabled="@_busy" @onclick="() => _linkFrom = null">Cancel</button>
            </div>
        </div>
    }

    <div class="graph-toolbar">
        <button class="btn" @onclick="ZoomIn" aria-label="Zoom in">＋</button>
        <button class="btn" @onclick="ZoomOut" aria-label="Zoom out">－</button>
        <button class="btn" @onclick="ResetView">Reset view</button>

        @if (_confirmLayoutReset)
        {
            <span class="confirm">
                Discard @PinnedCount saved position(s)? The auto-layout arranges afterwards.
            </span>
            <button class="btn btn-danger" disabled="@_busy"
                    @onclick="ResetLayoutAsync">Yes, reset</button>
            <button class="btn" disabled="@_busy"
                    @onclick="() => _confirmLayoutReset = false">Cancel</button>
        }
        else if (PinnedCount > 0)
        {
            <button class="btn" disabled="@_busy"
                    @onclick="() => _confirmLayoutReset = true">Reset layout</button>
        }

        <span class="hint">
            Dragging a node moves it, dragging on empty space moves the view; the mouse wheel
            zooms.
        </span>
    </div>

    <div class="graph-layout">
        <GraphPalette Disabled="@(!Editable || _busy)" Add="AddQuestionAsync" />

        <div class="graph-canvas-host">
            @* The summary stands BEFORE the picture: a screen reader should not have to run through 30
               nodes first to learn what it is about. *@
            <p class="visually-hidden">@_model.Summary</p>

            @if (_model.Nodes.Count == 0)
            {
                @* The hint stands ABOVE the canvas, not in its place: onto an empty dialog
                   the first question is dragged – without a drawing surface there would be no target for it. *@
                <p class="empty">
                    No questions yet – drag a building block from the palette onto the surface or
                    <a href="@($"dialogs/{Id}")">create one in the dialog editor</a>.
                </p>
            }

            <svg @ref="_canvas"
                 class="graph-canvas"
                 role="group"
                 aria-label="@_model.Summary"
                 data-editable="@(Editable ? "true" : "false")"
                 data-busy="@(_busy ? "true" : "false")"
                 viewBox="0 @SvgFormat.N(_model.MinY) @SvgFormat.N(_model.Width) @SvgFormat.N(_model.Height)">
                <defs>
                    <marker id="graph-arrow" viewBox="0 0 10 10" refX="9" refY="5"
                            markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" class="graph-arrow-head" />
                    </marker>
                    <marker id="graph-arrow-warn" viewBox="0 0 10 10" refX="9" refY="5"
                            markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" class="graph-arrow-head is-warning" />
                    </marker>
                </defs>

                @* The transform of this group belongs to the JS module. C# NEVER renders it – otherwise
                   the next re-render (e.g. a selection) would reset pan and zoom. *@
                <g class="graph-viewport">
                    @* The order is a promise from ADR 0006: frames, then edges, then nodes.
                       If an edge lay over a node, its hit path would swallow the click on
                       the node center – measured in the #100 spike. *@
                    @foreach (var loop in _model.Loops.Where(frame => frame.Width > 0))
                    {
                        <g class="graph-loop @(IsSelected(GraphElementKind.Loop, loop.LoopId) ? "is-selected" : "")"
                           @key="loop.LoopId">
                            <rect class="graph-loop-frame"
                                  x="@SvgFormat.N(loop.X)" y="@SvgFormat.N(loop.Y)"
                                  width="@SvgFormat.N(loop.Width)" height="@SvgFormat.N(loop.Height)"
                                  rx="14" />
                            <foreignObject x="@SvgFormat.N(loop.X)" y="@SvgFormat.N(loop.Y - 26)"
                                           width="@SvgFormat.N(Math.Max(loop.Width, 160))" height="26">
                                <button type="button" class="graph-loop-label"
                                        aria-label="@LoopLabel(loop)"
                                        @onclick="() => SelectLoop(loop.LoopId)">
                                    ↻ @loop.CollectionKey
                                    @if (loop.Warnings.Count > 0)
                                    {
                                        <span class="badge badge-warning">⚠ @loop.Warnings.Count</span>
                                    }
                                </button>
                            </foreignObject>
                        </g>
                    }

                    @* data-from/data-to are for the JS module: when dragging a node it dims
                       the adjacent edges instead of recomputing their path in the browser. *@
                    @foreach (var edge in _model.Edges)
                    {
                        <g class="graph-edge @EdgeClasses(edge)" @key="edge.TransitionId"
                           data-from="@edge.FromQuestionId" data-to="@edge.TargetQuestionId">
                            <path class="graph-edge-line" d="@edge.Path"
                                  marker-end="@(edge.Warnings.Count > 0 ? "url(#graph-arrow-warn)" : "url(#graph-arrow)")" />
                            @* A wide, invisible path makes the thin line graspable. It lies
                               in the same layer as the line – i.e. below the nodes. *@
                            <path class="graph-edge-hit" d="@edge.Path"
                                  role="img" aria-label="@edge.AriaLabel" tabindex="-1"
                                  @onclick="() => SelectTransition(edge.TransitionId)" />
                            <text class="graph-edge-label" aria-hidden="true"
                                  x="@SvgFormat.N(edge.LabelX)" y="@SvgFormat.N(edge.LabelY)">@edge.Label</text>
                        </g>
                    }

                    @* Nodes last: they lie above everything and are thereby safely clickable. The
                       order (layer, column) is at the same time the tab order – tabbing runs
                       through the dialog top to bottom. *@
                    @foreach (var node in _model.Nodes)
                    {
                        <GraphNodeCard @key="node.QuestionId"
                                       Node="node"
                                       Selected="IsSelected(GraphElementKind.Question, node.QuestionId)"
                                       Editable="Editable"
                                       IsLinkSource="@(_linkFrom == node.QuestionId)"
                                       Select="SelectQuestion"
                                       StartLink="StartLink" />
                    }

                    @if (_model.StartMarker is { } start)
                    {
                        @ScopeMarker(start)
                    }
                    @if (_model.EndMarker is { } end)
                    {
                        @ScopeMarker(end)
                    }

                    @* Two placeholders for the ongoing gesture: C# renders the elements, the JS module
                       fills their geometry (d or x/y/width/height) and empties them again. Deliberately so
                       and NOT via createElement from the JS: foreign DOM in a container managed by Blazor
                       throws the renderer off over the child indices on the next diff. Conversely
                       C# never renders these attributes – the same ownership rule as with the transform
                       of the viewport (ADR 0006). *@
                    <path class="graph-rubber" aria-hidden="true" />
                    <rect class="graph-ghost" aria-hidden="true" />
                </g>
            </svg>
        </div>

        <GraphInspector Model="_model"
                        Detail="_detail!"
                        Selection="_selection"
                        Editable="Editable"
                        Busy="_busy"
                        UnmarkedBackJumps="_unmarkedBackJumps"
                        OpenQuestion="OpenQuestion"
                        OpenTransition="OpenTransition"
                        OpenLoop="OpenLoop"
                        OpenTrigger="OpenTrigger"
                        SelectQuestion="SelectQuestion"
                        SelectTransition="SelectTransition"
                        SaveQuestion="SaveQuestionAsync"
                        SetStartQuestion="SetStartQuestionAsync"
                        DeleteQuestion="DeleteQuestionAsync"
                        MoveTransition="MoveTransitionAsync"
                        ToggleDefault="ToggleDefaultAsync"
                        Connect="ConnectFromInspectorAsync"
                        SaveTransition="SaveTransitionAsync"
                        DeleteTransition="DeleteTransitionAsync"
                        CreateLoop="CreateLoopAsync"
                        DeleteLoop="DeleteLoopAsync"
                        AddTrigger="AddTriggerAsync"
                        AddDialogTrigger="AddTriggerAsync" />
    </div>
}

@code {
    /// <summary>The dialog whose graph is shown.</summary>
    [Parameter]
    public Guid Id { get; set; }

    private DialogDetail? _detail;
    private DialogGraphModel? _model;
    private GraphSelection? _selection;
    private string? _error;
    private string? _message;
    private Guid _loadedId;
    private bool _busy;
    private bool _confirmLayoutReset;

    /// <summary>The source question of a connection begun via the keyboard.</summary>
    private Guid? _linkFrom;

    /// <summary>
    /// The back-jumps without a matching loop marker – computed <b>once</b> per load, like the
    /// drawing model itself. Called from the markup the check would run again on every render.
    /// </summary>
    private IReadOnlyList<Guid> _unmarkedBackJumps = [];

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DialogGraph>? _self;

    /// <summary>
    /// Whether the configuration graph is editable. A <b>published</b> version is locked –
    /// the engine rejects graph changes to it with a conflict (<c>DialogPublishedException</c>),
    /// so that running sessions do not break. The lock mirrors this rule in the UI, instead of
    /// letting the user run into the error message. Moving stays allowed (ADR 0007).
    /// </summary>
    private bool Editable => _detail is not null && !_detail.Dialog.IsPublished;

    /// <summary>How many nodes lie at a position saved by the author.</summary>
    private int PinnedCount => _model?.Nodes.Count(node => node.IsPinned) ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        // On switching to another dialog, release the binding: the DotNetObjectReference would
        // otherwise point to the same instance with a now different Id, and attach short-circuits for a known canvas.
        await ReleaseModuleAsync();

        _loadedId = Id;
        _selection = null;
        _linkFrom = null;
        _message = null;
        await LoadAsync();
    }

    /// <summary>
    /// Loads the dialog and computes the drawing model <b>once</b> into a field. Called from the markup
    /// the whole layout would run again on every render – i.e. on every click.
    /// </summary>
    private async Task LoadAsync()
    {
        var result = await Admin.ExecuteAsync((sender, token) => sender.Send(new GetDialogQuery(Id), token));
        if (!result.Success)
        {
            _detail = null;
            _model = null;
            _error = result.Error;
            return;
        }

        // The loaded dialog is kept: a changed position can thereby be computed in locally,
        // without querying the whole graph again.
        _detail = result.Value!;
        _model = DialogGraphBuilder.Build(_detail);
        _unmarkedBackJumps = [.. LoopAnalyzer.UnmarkedBackJumps(_detail).Select(transition => transition.Id)];
        ReconcileSelection();
    }

    /// <summary>Rebuilds the drawing model from the buffered dialog with the given layout.</summary>
    /// <param name="layout">The new layout (result of the command or empty after the reset).</param>
    private void Rebuild(IReadOnlyList<DialogLayoutDetail> layout)
    {
        if (_detail is null)
        {
            return;
        }

        _detail = _detail with { Layout = layout };
        _model = DialogGraphBuilder.Build(_detail);
    }

    /// <summary>
    /// Discards a selection whose element no longer exists.
    /// </summary>
    /// <remarks>
    /// Mandatory after every mutation, not cosmetics: <c>DeleteQuestionCommand</c> cleans up transitions,
    /// loop markers and triggers along with it. If the selection still pointed to a vanished
    /// element afterwards, the inspector would render into an empty branch – and the visible fall-back to the legend
    /// is itself part of the proof that things were cleaned up too.
    /// </remarks>
    private void ReconcileSelection()
    {
        if (_model is null || _selection is null)
        {
            return;
        }

        var alive = _selection.Kind switch
        {
            GraphElementKind.Question => _model.Node(_selection.Id) is not null,
            GraphElementKind.Transition => _model.Edge(_selection.Id) is not null,
            GraphElementKind.Loop => _model.Loops.Any(loop => loop.LoopId == _selection.Id),
            _ => true,
        };

        if (!alive)
        {
            _selection = null;
        }

        if (_linkFrom is { } from && _model.Node(from) is null)
        {
            _linkFrom = null;
        }
    }

    // ---- Gestures (#103) ----------------------------------------------------------------------------

    /// <summary>
    /// Runs a writing gesture: set the lock, send the commands in <b>one</b> gateway call,
    /// then reload the graph.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The early exit on <c>_busy</c> is the server-side half of the gesture lock. The JS module
    /// already locks client-side, but a <c>[JSInvokable]</c> call sees no rendered
    /// <c>disabled</c> attribute – so the <c>DialogEditor</c>'s pattern does not carry here. And every
    /// <c>await</c> hands off the circuit context, a second call can slip in between.
    /// </para>
    /// <para>
    /// <b>Reloaded instead of written forward locally:</b> the commands return only their own slice,
    /// and <c>DeleteQuestionCommand</c> additionally cleans up transitions, loop markers, triggers and
    /// layout rows. Above all, <c>TransitionWarningAnalyzer</c> and <c>LoopAnalyzer</c> compute
    /// over the <b>whole</b> dialog: a new transition can lift a warning on another question.
    /// "Warnings update immediately" is only true with the real server state. The
    /// exception remains the layout path (<see cref="MoveNodeAsync"/>), whose command returns the complete
    /// new state.
    /// </para>
    /// </remarks>
    /// <typeparam name="TResult">The return type of the command sequence.</typeparam>
    /// <param name="operation">The commands to send.</param>
    /// <param name="successMessage">The success message.</param>
    /// <param name="requireEditable">Whether the gesture requires an unpublished dialog.</param>
    /// <returns><see langword="true"/> if the gesture ran through.</returns>
    private async Task<bool> RunGestureAsync<TResult>(
        Func<ISender, CancellationToken, ValueTask<TResult>> operation,
        string successMessage,
        bool requireEditable = true)
    {
        if (_busy || _detail is null || (requireEditable && !Editable))
        {
            return false;
        }

        _busy = true;
        _message = null;
        _error = null;

        try
        {
            var result = await Admin.ExecuteAsync(operation);
            if (!result.Success)
            {
                _error = result.Error;
                return false;
            }

            _message = successMessage;
            await LoadAsync();
            return true;
        }
        finally
        {
            _busy = false;

            // A JSInvokable call runs outside a render cycle – without this nudge the
            // UI would stay on the state before the gesture.
            StateHasChanged();
        }
    }

    /// <summary>
    /// Creates a question – triggered from the palette, i.e. <b>without</b> a saved position.
    /// </summary>
    /// <remarks>
    /// Deliberately no invented coordinate: "at the drop point" is a statement about the drag gesture.
    /// Without a layout row the auto-layout places the question, which is the more
    /// comprehensible result for the keyboard path.
    /// </remarks>
    /// <param name="type">The chosen question type.</param>
    private async Task AddQuestionAsync(QuestionType type)
    {
        if (_detail is null)
        {
            return;
        }

        var key = QuestionFormModel.SuggestKey(type, _detail);

        var created = await RunGestureAsync(
            (sender, token) => sender.Send(NewQuestion(type, key), token),
            $"Question \"{key}\" created.");

        // After the reload the new question is in the model – found via its key, which is unique
        // within the dialog. Selecting it is the point of the gesture: the inspector shows its fields at once.
        if (created && QuestionIdByKey(key) is { } questionId)
        {
            _selection = new GraphSelection(GraphElementKind.Question, questionId);
        }
    }

    /// <summary>
    /// Creates a question at the drop point – the palette gesture of the JS module.
    /// </summary>
    /// <remarks>
    /// The question type comes as a <b>string</b> from the DOM attribute and is resolved here: Blazor's
    /// JSInterop brings no string-to-enum converter, so a <c>QuestionType</c> parameter would fail
    /// on deserialization. An unknown value is discarded, not guessed.
    /// </remarks>
    /// <param name="type">The name of the question type.</param>
    /// <param name="x">The horizontal canvas coordinate in px.</param>
    /// <param name="y">The vertical canvas coordinate in px.</param>
    [JSInvokable]
    public async Task CreateQuestionAtAsync(string type, int x, int y)
    {
        if (_detail is null || !Enum.TryParse<QuestionType>(type, out var questionType))
        {
            return;
        }

        var key = QuestionFormModel.SuggestKey(questionType, _detail);

        _ = await RunGestureAsync(
            async (sender, token) =>
            {
                var question = await sender.Send(NewQuestion(questionType, key), token);

                // The layout row needs the Guid of the new question – so the order is mandatory.
                // Both commands run in ONE gateway call (one DI scope, one error path), but
                // not in one transaction: each handler saves itself. If the second fails,
                // the question exists without a position and the auto-layout places it. Deliberately no
                // compensation – deleting a just-created question because of a layout hiccup
                // would be the more expensive mistake.
                _ = await sender.Send(Position(question.Id, x, y), token);

                return question;
            },
            $"Question \"{key}\" created.");
    }

    /// <summary>Connects two questions – the port gesture of the JS module and the keyboard path.</summary>
    /// <param name="from">The source question.</param>
    /// <param name="target">The target question.</param>
    [JSInvokable]
    public async Task ConnectAsync(Guid from, Guid target)
    {
        if (_detail is null)
        {
            return;
        }

        _linkFrom = null;

        _ = await RunGestureAsync(
            (sender, token) => sender.Send(
                new CreateTransitionCommand(
                    Id, from, target, null, GraphEditing.NextPriority(_detail, from), false),
                token),
            $"Transition {QuestionKey(from)} → {QuestionKey(target)} created.");
    }

    /// <summary>
    /// Creates a question at the release point and connects it – dragging from the port into the void.
    /// </summary>
    /// <param name="from">The source question.</param>
    /// <param name="x">The horizontal canvas coordinate in px.</param>
    /// <param name="y">The vertical canvas coordinate in px.</param>
    [JSInvokable]
    public async Task ConnectToNewQuestionAsync(Guid from, int x, int y)
    {
        if (_detail is null)
        {
            return;
        }

        var key = QuestionFormModel.SuggestKey(QuestionType.FreeText, _detail);
        var priority = GraphEditing.NextPriority(_detail, from);

        _ = await RunGestureAsync(
            async (sender, token) =>
            {
                var question = await sender.Send(NewQuestion(QuestionType.FreeText, key), token);
                _ = await sender.Send(Position(question.Id, x, y), token);

                return await sender.Send(
                    new CreateTransitionCommand(Id, from, question.Id, null, priority, false), token);
            },
            $"Question \"{key}\" created and connected with {QuestionKey(from)}.");
    }

    /// <summary>
    /// Begins or ends a connection via the keyboard: the source port remembers the source,
    /// the next node click completes it (see <see cref="SelectQuestion"/>).
    /// </summary>
    /// <param name="questionId">The source question.</param>
    private void StartLink(Guid questionId)
    {
        _error = null;
        _message = null;
        _linkFrom = _linkFrom == questionId ? null : questionId;
    }

    // ---- Gestures from the inspector (#103) ---------------------------------------------------------

    /// <summary>
    /// Saves the header fields of a question. <c>Order</c> and <c>ValidationRules</c> go along
    /// unchanged: the panel does not know them, and the command expects the complete set – without them
    /// a field change in the inspector would silently lose the validation rules and the list position.
    /// </summary>
    /// <param name="edit">The changed fields.</param>
    private async Task SaveQuestionAsync(QuestionEdit edit)
    {
        if (_detail?.Questions.FirstOrDefault(question => question.Id == edit.QuestionId) is not { } current)
        {
            return;
        }

        _ = await RunGestureAsync(
            (sender, token) => sender.Send(
                new UpdateQuestionCommand(
                    Id, edit.QuestionId, edit.Key, edit.Text, edit.Type, current.Order, edit.IsRequired,
                    current.ValidationRules),
                token),
            $"Question \"{edit.Key}\" saved.");
    }

    /// <summary>
    /// Makes the chosen question the dialog's entry question.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The only path that touches the <b>dialog</b> metadata instead of the graph – and therefore the
    /// only one that calls <c>UpdateDialogCommand</c>. Key, name and description go along unchanged:
    /// the command expects the complete set, and the canvas only knows the entry question.
    /// </para>
    /// <para>
    /// Not a special case of the publish lock, but its normal case: the command's guard takes effect
    /// exactly when <c>StartQuestionId</c> changes. Because the button in the panel is
    /// <c>disabled</c> when the graph is locked and <see cref="RunGestureAsync"/> additionally
    /// checks <c>requireEditable</c>, this yields no error message but a non-triggerable
    /// action.
    /// </para>
    /// </remarks>
    /// <param name="questionId">The new entry question.</param>
    private async Task SetStartQuestionAsync(Guid questionId)
    {
        if (_detail is null)
        {
            return;
        }

        var dialog = _detail.Dialog;

        _ = await RunGestureAsync(
            (sender, token) => sender.Send(
                new UpdateDialogCommand(Id, dialog.Key, dialog.Name, dialog.Description, questionId),
                token),
            $"\"{QuestionKey(questionId)}\" is now the entry question.");
    }

    /// <summary>
    /// Deletes a question and names the accompanying cleanup.
    /// </summary>
    /// <remarks>
    /// The command cleans up referencing transitions, loop markers, triggers and layout rows. The
    /// numbers for it arise as the difference of the counts before and after the reload – so what is reported
    /// is what really happened, not what the client expected.
    /// </remarks>
    /// <param name="questionId">The question to delete.</param>
    private async Task DeleteQuestionAsync(Guid questionId)
    {
        if (_detail is null)
        {
            return;
        }

        var key = QuestionKey(questionId);
        var before = (_detail.Transitions.Count, _detail.Loops.Count, _detail.Triggers.Count);

        var deleted = await RunGestureAsync(
            (sender, token) => sender.Send(new DeleteQuestionCommand(Id, questionId), token),
            $"Question \"{key}\" deleted.");

        if (deleted && _detail is not null)
        {
            var removed = new List<string>(3);
            Describe(before.Item1 - _detail.Transitions.Count, "transition", "transitions");
            Describe(before.Item2 - _detail.Loops.Count, "loop marker", "loop markers");
            Describe(before.Item3 - _detail.Triggers.Count, "trigger", "triggers");

            if (removed.Count > 0)
            {
                _message = $"Question \"{key}\" deleted – {string.Join(", ", removed)} removed along with it.";
            }

            void Describe(int count, string singular, string plural)
            {
                if (count > 0)
                {
                    removed.Add($"{count} {(count == 1 ? singular : plural)}");
                }
            }
        }
    }

    /// <summary>Moves a transition in the evaluation order of its source question.</summary>
    /// <param name="move">Source question as well as old and new position.</param>
    private async Task MoveTransitionAsync(TransitionMove move)
    {
        if (_detail is null)
        {
            return;
        }

        var changed = GraphEditing.Reorder(
            TransitionWarningAnalyzer.Outgoing(_detail, move.FromQuestionId), move.From, move.To);

        if (changed.Count == 0)
        {
            return;
        }

        _ = await RunGestureAsync(
            async (sender, token) =>
            {
                foreach (var (transition, priority) in changed)
                {
                    _ = await sender.Send(
                        new UpdateTransitionCommand(
                            Id, transition.Id, transition.FromQuestionId, transition.TargetQuestionId,
                            transition.Expression, priority, transition.IsDefault),
                        token);
                }

                return Unit.Value;
            },
            "Order of transitions changed.");
    }

    /// <summary>Toggles the default flag of a transition.</summary>
    /// <param name="transitionId">The transition.</param>
    private async Task ToggleDefaultAsync(Guid transitionId)
    {
        if (_detail?.Transitions.FirstOrDefault(transition => transition.Id == transitionId)
            is not { } current)
        {
            return;
        }

        _ = await RunGestureAsync(
            (sender, token) => sender.Send(
                new UpdateTransitionCommand(
                    Id, current.Id, current.FromQuestionId, current.TargetQuestionId, current.Expression,
                    current.Priority, !current.IsDefault),
                token),
            current.IsDefault ? "Default flag removed." : "Marked as default.");
    }

    /// <summary>Connects the chosen question with the target chosen in the inspector.</summary>
    /// <param name="target">The target question.</param>
    private async Task ConnectFromInspectorAsync(Guid target)
    {
        if (_selection is { Kind: GraphElementKind.Question } selection)
        {
            await ConnectAsync(selection.Id, target);
        }
    }

    /// <summary>Saves target, condition and default flag of a transition.</summary>
    /// <remarks>
    /// Source question and priority stay untouched: changing the source question reassigns the
    /// priority in the new group, and this rule lives in the transition editor. The condition is
    /// already <b>checked live</b> when saving (<c>ExpressionField</c>); a second blocking
    /// check here would be the job of the full editor, which does it unchanged.
    /// </remarks>
    /// <param name="edit">The changed fields.</param>
    private async Task SaveTransitionAsync(TransitionEdit edit)
    {
        if (_detail?.Transitions.FirstOrDefault(transition => transition.Id == edit.TransitionId)
            is not { } current)
        {
            return;
        }

        _ = await RunGestureAsync(
            (sender, token) => sender.Send(
                new UpdateTransitionCommand(
                    Id, current.Id, current.FromQuestionId, edit.TargetQuestionId, edit.Expression,
                    current.Priority, edit.IsDefault),
                token),
            "Transition saved.");
    }

    /// <summary>Deletes a transition.</summary>
    /// <param name="transitionId">The transition to delete.</param>
    private async Task DeleteTransitionAsync(Guid transitionId)
        => _ = await RunGestureAsync(
            (sender, token) => sender.Send(new DeleteTransitionCommand(Id, transitionId), token),
            "Transition deleted.");

    /// <summary>Creates a loop marker from a back-jump.</summary>
    /// <param name="draft">Collection key, entry and breaking question.</param>
