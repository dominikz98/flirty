    /// <summary>
    /// Wählt eine Frage aus und zieht den Fokus auf ihren Knoten nach. Das Nachziehen ist der Grund,
    /// warum die Methode asynchron ist: Wer im Inspector „Zur Zielfrage“ betätigt, soll danach auf dem
    /// gemeinten Knoten stehen und nicht auf der Schaltfläche, die ihn dorthin gebracht hat.
    /// </summary>
    /// <remarks>
    /// Läuft gerade eine über die Tastatur begonnene Verbindung, schließt der Klick sie ab statt
    /// auszuwählen – der Knoten ist dann das Ziel, nicht das Objekt des Interesses.
    /// </remarks>
    private async Task SelectQuestion(Guid questionId)
    {
        if (_linkFrom is { } from)
        {
            await ConnectAsync(from, questionId);
            return;
        }

        _selection = new GraphSelection(GraphElementKind.Question, questionId);

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("focusNode", _canvas, questionId);
        }
    }

