    private CreateQuestionCommand NewQuestion(QuestionType type, string key)
        => new(Id, key, "New question", type, GraphEditing.NextOrder(_detail!), false, null);

    private SetDialogLayoutCommand Position(Guid questionId, int x, int y)
        => new(Id, [new DialogLayoutEntry(LayoutElementKind.Question, questionId, x, y)]);

    /// <summary>Finds a question via its key – which is unique within the dialog.</summary>
    private Guid? QuestionIdByKey(string key)
        => _detail?.Questions.FirstOrDefault(question => question.Key == key)?.Id;

    private string QuestionKey(Guid questionId)
        => _detail?.Questions.FirstOrDefault(question => question.Id == questionId)?.Key ?? "unknown";

    /// <summary>Derives a new version and stays on the canvas.</summary>
    /// <remarks>
    /// Unlike the <c>DialogEditor</c>, which jumps into its own editor: whoever works here wants
    /// to keep working on the graph, not in the list.
    /// </remarks>
    private async Task CreateVersionAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;

        try
        {
            var result = await Admin.ExecuteAsync(
                (sender, token) => sender.Send(new CreateDialogVersionCommand(Id), token));

            if (!result.Success || result.Value is null)
            {
                _error = result.Error;
                return;
            }

            _error = null;
            Navigation.NavigateTo($"dialogs/{result.Value.Dialog.Id}/graph");
        }
        finally
        {
            _busy = false;
        }
    }

    // ---- Moving (#102) ------------------------------------------------------------------------------

    /// <summary>
    /// Takes over the new position of a node after the drag ended in the browser.
    /// </summary>
    /// <remarks>
    /// <para>
    /// During the drag the module writes only the node's <c>transform</c> (ADR 0006). The commit
    /// then writes the same value from C# – the view does not jump, because
    /// <c>SvgFormat.N</c> formats whole numbers exactly as the module does.
    /// </para>
    /// <para>
    /// A failure rebuilds the model from the <b>saved</b> state: the node then springs
    /// back visibly. Leaving it in place would claim a position that does not exist in the database
    /// – and the next reload would contradict it.
    /// </para>
    /// <para>
    /// Deliberately does <b>not</b> check <see cref="Editable"/>: a position does not belong to the graph,
    /// a published dialog must remain arrangeable (ADR 0007). The gesture lock still applies –
    /// not because of the upsert, but so that a drag does not interleave with a flying graph change
    /// and build on a state that the reload replaces right away.
    /// </para>
    /// </remarks>
    /// <param name="questionId">The moved question.</param>
    /// <param name="x">The new horizontal canvas coordinate in px.</param>
    /// <param name="y">The new vertical canvas coordinate in px.</param>
    [JSInvokable]
    public async Task MoveNodeAsync(Guid questionId, int x, int y)
    {
        if (_busy || _detail is null)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await Admin.ExecuteAsync((sender, token) =>
                sender.Send(Position(questionId, x, y), token));

            if (result.Success)
            {
                Rebuild(result.Value!);
            }
            else
            {
                _error = result.Error;
                Rebuild(_detail.Layout);
            }
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>Discards all saved positions; afterwards the auto-layout takes effect again.</summary>
    private async Task ResetLayoutAsync()
    {
        _confirmLayoutReset = false;

        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await Admin.ExecuteAsync((sender, token) =>
                sender.Send(new ResetDialogLayoutCommand(Id), token));

            if (result.Success)
            {
                Rebuild([]);
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The module itself is the truth about whether it is bound – an additional flag would have to be
        // reset along on every dialog switch. The canvas now exists even without nodes
        // (it is the drop surface for the first question), so the node count is no longer a condition.
        if (_module is not null || _model is null)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Pages/DialogGraph.razor.js");
        _self = DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync(
            "attach",
            _canvas,
            _self,
            new
            {
                minZoom = GraphMetrics.MinZoom,
                maxZoom = GraphMetrics.MaxZoom,
                zoomStep = GraphMetrics.ZoomStep,
                nodeWidth = GraphMetrics.NodeWidth,
                nodeHeight = GraphMetrics.NodeHeight,
            });
    }

    // ---- Selection ----------------------------------------------------------------------------------

    private bool IsSelected(GraphElementKind kind, Guid id)
        => _selection is { } selection && selection.Kind == kind && selection.Id == id;

    /// <summary>
    /// Selects a question and moves the focus onto its node. This focus move is the reason
    /// why the method is asynchronous: whoever hits "To the target question" in the inspector should afterwards be on the
    /// intended node and not on the button that brought them there.
    /// </summary>
    /// <remarks>
    /// If a connection begun via the keyboard is currently running, the click completes it instead of
    /// selecting – the node is then the target, not the object of interest.
    /// </remarks>
    private async Task SelectQuestion(Guid questionId)
    {
        if (_linkFrom is { } from)
        {
            await ConnectAsync(from, questionId);
            return;
        }

        _selection = new GraphSelection(GraphElementKind.Question, questionId);

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("focusNode", _canvas, questionId);
        }
    }

    private void SelectTransition(Guid transitionId)
        => _selection = new GraphSelection(GraphElementKind.Transition, transitionId);

    private void SelectLoop(Guid loopId)
        => _selection = new GraphSelection(GraphElementKind.Loop, loopId);

