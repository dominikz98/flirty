@* Deliberately NOT named "TransitionDetail": the component type would otherwise shadow the
   view type Flirty.Runtime.Admin.TransitionDetail of the same name (as with DialogEditor/QuestionEditor). *@
@page "/dialogs/{DialogId:guid}/transitions/{TransitionId:guid}"
@rendermode InteractiveServer
@using Mediator
@using Flirty.Expressions
@using Flirty.Runtime.Admin
@inject FlirtyAdminGateway Admin
@inject IExpressionEvaluator Evaluator
@inject NavigationManager Navigation

<PageTitle>Transition · Flirty Designer</PageTitle>

<p class="back"><a href="@($"dialogs/{DialogId}")">← @(_detail?.Dialog.Name ?? "Dialog")</a></p>

@if (_transition is null)
{
    <h1>Transition</h1>

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    else
    {
        <p class="empty">Loading …</p>
    }
}
else
{
    <h1>
        @QuestionLabel(_transition.FromQuestionId) → @QuestionLabel(_transition.TargetQuestionId)
        @if (_transition.IsDefault)
        {
            <span class="badge badge-default">Default</span>
        }
    </h1>

    <p class="intro">
        Transition @(_position + 1) of @_group.Count from the question
        <span class="mono">@QuestionLabel(_transition.FromQuestionId)</span> in the dialog
        <a href="@($"dialogs/{DialogId}")">@_detail!.Dialog.Name</a>
    </p>

    @if (_detail.Dialog.IsPublished)
    {
        <div class="banner warn">
            The dialog is published in version @_detail.Dialog.Version: its graph is <strong>locked</strong>,
            so that running sessions do not break. To change it, create a new version in the
            <a href="@($"dialogs/{DialogId}")">dialog editor</a> or unpublish the dialog.
        </div>
    }

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    @if (_message is not null)
    {
        <div class="banner ok">@_message</div>
    }

    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="editor">
            <h2>Transition</h2>

            <div class="field">
                <label for="from">Source question</label>
                <InputSelect id="from" class="input" @bind-Value="_form.FromQuestionId">
                    <option value="">— select —</option>
                    @foreach (var question in _detail.Questions)
                    {
                        <option value="@question.Id">@question.Key — @question.Text</option>
                    }
                </InputSelect>
                <span class="hint">
                    If the source question is changed, the transition moves to the end of the priority list
                    in the new question.
                </span>
                <ValidationMessage For="() => _form.FromQuestionId" />
            </div>

            <div class="field">
                <label for="target">Target question</label>
                <InputSelect id="target" class="input" @bind-Value="_form.TargetQuestionId">
                    <option value="">— select —</option>
                    @foreach (var question in _detail.Questions)
                    {
                        <option value="@question.Id">@question.Key — @question.Text</option>
                    }
                </InputSelect>
                <span class="hint">
                    If the target points to an earlier question, a cycle (loop) arises – the marker for it
                    is maintained in the "Loops" section of the
                    <a href="@($"dialogs/{DialogId}")">dialog editor</a>.
                </span>
                <ValidationMessage For="() => _form.TargetQuestionId" />
            </div>

            <div class="field check">
                <InputCheckbox id="isDefault" @bind-Value="_form.IsDefault" />
                <label for="isDefault">Default transition</label>
            </div>
            <span class="hint">
                The default applies when <em>no</em> conditional transition matches. Its own condition
                is <strong>not</strong> evaluated in that case.
            </span>

            <div class="field">
                <label>Priority</label>
                <span class="hint">
                    Position @(_position + 1) – changeable via the arrows in the
                    <a href="@($"dialogs/{DialogId}")">transition list of the dialog</a>. Checked from top
                    to bottom; the first matching transition wins.
                </span>
            </div>
        </div>

        <div class="editor">
            <h2>Condition</h2>

            @if (_form.IsDefault && !string.IsNullOrWhiteSpace(_form.Expression))
            {
                <div class="banner warn">
                    This transition is marked as default – its condition is not evaluated at runtime.
                    Either remove the default checkmark or clear the condition.
                </div>
            }

            @* Input field, live status, error location, snippet inserter and identifier reference have
               lived in ExpressionField since #103 – word for word, but in one place instead of three (here,
               in the TriggerEditor and newly in the graph inspector). The id of the field stays "expression". *@
            <ExpressionField Detail="_detail"
                             @bind-Value="_form.Expression"
                             EmptyHint="unconditionally matching"
                             EmptyMeaning="the transition always applies" />
        </div>

        <div class="actions">
            <button type="submit" class="btn btn-primary" disabled="@(_busy || !Editable)">Save</button>
            <button type="button" class="btn" disabled="@(_busy || !Editable)" @onclick="ResetForm">Reset</button>
        </div>
    </EditForm>

    <div class="editor">
        <h2>Delete transition</h2>

        <p class="hint">
            Without this transition the dialog ends after the source question, provided no other transition
            leads out of it.
        </p>

        <div class="actions">
            @if (_confirmDelete)
            {
                <span class="confirm">Really delete transition?</span>
                <button class="btn btn-danger" disabled="@(_busy || !Editable)" @onclick="DeleteAsync">Yes, delete</button>
                <button class="btn" disabled="@(_busy || !Editable)" @onclick="() => _confirmDelete = false">Cancel</button>
            }
            else
            {
                <button class="btn btn-danger" disabled="@(_busy || !Editable)" @onclick="() => _confirmDelete = true">Delete</button>
            }
        </div>
    </div>
}

@code {
    /// <summary>The primary key of the dialog (from the route).</summary>
    [Parameter]
    public Guid DialogId { get; set; }

    /// <summary>The primary key of the edited transition (from the route).</summary>
    [Parameter]
    public Guid TransitionId { get; set; }

    /// <summary>
    /// Whether the graph is editable: on a published version the engine rejects graph changes with a
    /// conflict (<c>DialogPublishedException</c>), so that running sessions do not break. The lock
    /// mirrors that in the UI.
    /// </summary>
    private bool Editable => _detail is not null && !_detail.Dialog.IsPublished;
    private DialogDetail? _detail;
    private TransitionDetail? _transition;
    private IReadOnlyList<TransitionDetail> _group = [];
    private int _position;
    private TransitionFormModel _form = new();

    /// <summary>
    /// The sample context for the <b>blocking</b> check in <see cref="SaveAsync"/>. The live display
    /// during input is done by <c>ExpressionField</c> with its own context; the decision whether to save
    /// deliberately stays here – otherwise this page would have to know the internal state of the
    /// component.
    /// </summary>
    private ExpressionContext? _context;
    private string? _error;
    private string? _message;
    private bool _busy;
    private bool _confirmDelete;
    private (Guid Dialog, Guid Transition) _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == (DialogId, TransitionId))
        {
            return;
        }

        _loaded = (DialogId, TransitionId);
        _message = null;
        _confirmDelete = false;
        await ReloadAsync();
    }

    /// <summary>
    /// Loads the dialog graph and picks out the edited transition. A single <c>GetDialogQuery</c>
    /// suffices: it delivers questions (for the selection and the sample context), transitions (for
    /// priority and group) and the loop markers (for the collection identifiers in the expression).
    /// </summary>
    private async Task ReloadAsync(bool resetForm = true)
    {
        var result = await Admin.ExecuteAsync((sender, token) => sender.Send(new GetDialogQuery(DialogId), token));
        _detail = result.Value;
        _error = result.Error;

        _transition = _detail?.Transitions.FirstOrDefault(transition => transition.Id == TransitionId);

        if (_detail is not null && _transition is null)
        {
            _error = $"The dialog '{DialogId}' contains no transition with the id '{TransitionId}'.";
        }

        _group = _transition is null || _detail is null
            ? []
            : [.. _detail.Transitions
                .Where(transition => transition.FromQuestionId == _transition.FromQuestionId)
                .OrderBy(transition => transition.Priority)];
        _position = _transition is null ? -1 : _group.ToList().FindIndex(transition => transition.Id == TransitionId);

        if (_detail is not null)
        {
            _context = DesignerExpressionContext.Build(_detail);
        }

        if (resetForm)
        {
            ResetForm();
        }
    }

    private void ResetForm()
    {
        if (_transition is not null)
        {
            _form = TransitionFormModel.From(_transition);
        }
    }

    private string QuestionLabel(Guid questionId)
        => _detail?.Questions.FirstOrDefault(question => question.Id == questionId)?.Key
            ?? questionId.ToString();

    /// <summary>
    /// Saves the transition – after the expression has been validated in a <b>blocking</b> way. An
    /// invalid expression would otherwise only bite the runtime when evaluating the branching
    /// (<c>ExpressionEvaluationException</c> in the middle of a running session).
    /// </summary>
    private async Task SaveAsync()
    {
        if (_detail is null || _transition is null || _context is null)
        {
            return;
        }

        var expression = _form.NormalizedExpression();
        var validation = DesignerExpressionContext.Validate(Evaluator, expression, _context);

        if (!validation.IsValid)
        {
            _error = $"The condition is invalid: {validation.Error}";
            _message = null;
            return;
        }

        var from = _form.FromQuestionId!.Value;
        var target = _form.TargetQuestionId!.Value;

        // When the source question changes, reassign the priority: the old number belongs to the old
        // group and would silently collide with an existing transition in the new one.
        var priority = from == _transition.FromQuestionId ? _transition.Priority : NextPriority(from);

        await RunAsync<TransitionDetail>(
            (sender, token) => sender.Send(
                new UpdateTransitionCommand(
                    DialogId, TransitionId, from, target, expression, priority, _form.IsDefault),
                token),
            "Transition saved.");
    }

    private int NextPriority(Guid fromQuestionId)
    {
        var siblings = _detail!.Transitions
            .Where(transition => transition.FromQuestionId == fromQuestionId && transition.Id != TransitionId)
            .ToList();

        return siblings.Count == 0 ? 0 : siblings.Max(transition => transition.Priority) + 1;
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            var result = await Admin.ExecuteAsync(
                (sender, token) => sender.Send(new DeleteTransitionCommand(DialogId, TransitionId), token));

            if (!result.Success)
            {
                _error = result.Error;
                _confirmDelete = false;
                return;
            }

            Navigation.NavigateTo($"dialogs/{DialogId}");
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Runs a writing operation, shows success or error and reloads the graph.
    /// </summary>
    /// <typeparam name="TResult">The result type of the operation.</typeparam>
    /// <param name="operation">The admin message to execute.</param>
    /// <param name="successMessage">The message shown on success.</param>
    /// <returns><see langword="true"/> if the operation succeeded.</returns>
    private async Task<bool> RunAsync<TResult>(
        Func<ISender, CancellationToken, ValueTask<TResult>> operation,
        string successMessage)
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Admin.ExecuteAsync(operation);
            if (!result.Success)
            {
                _error = result.Error;
                return false;
            }

            _error = null;
            _message = successMessage;
            await ReloadAsync();
            return true;
        }
        finally
        {
            _busy = false;
        }
    }
}
