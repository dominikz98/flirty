@* Deliberately no name from Flirty.Runtime(.Admin): an equally named component type would shadow the
   view type (the same convention as with DialogEditor/QuestionEditor/TriggerEditor). *@
@page "/dialogs/{DialogId:guid}/test"
@rendermode InteractiveServer
@using Flirty.Domain
@using Flirty.Runtime
@using Flirty.Runtime.Admin
@inject FlirtyAdminGateway Admin
@inject FlirtyRuntimeGateway Runtime
@inject DesignerTriggerLog TriggerLog

<PageTitle>Test run · @(_detail?.Dialog.Name ?? "Dialog") · Flirty Designer</PageTitle>

<p class="back"><a href="@($"dialogs/{DialogId}")">← @(_detail?.Dialog.Name ?? "Dialog")</a></p>

@if (_detail is null)
{
    <h1>Test run</h1>

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    else
    {
        <p class="empty">Loading …</p>
    }
}
else
{
    <h1>
        Test run: @_detail.Dialog.Name
        @if (_detail.Dialog.IsPublished)
        {
            <span class="badge badge-published">Published</span>
        }
        else
        {
            <span class="badge badge-draft">Draft</span>
        }
    </h1>

    <p class="intro">
        Plays the dialog through with the real engine – even as a draft, without publishing it.
    </p>

    <div class="banner warn">
        <strong>The run is real.</strong> It creates a
        <code>DialogSession</code> including answers in the database of the active profile (the user key begins with
        <code>@DialogTestRunner.UserKeyPrefix</code>)@(HasWebhookTrigger
            ? ", and the webhook triggers configured on the dialog are actually delivered via HTTP."
            : ".")
    </div>

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    @if (_message is not null)
    {
        <div class="banner ok">@_message</div>
    }

    @* Two representations of the SAME run – not a second runner. Start, answer and editing run in
       both via the same engine calls; the toggle only changes what is shown from it. *@
    <div class="run-views" role="group" aria-label="Representation of the run">
        <button class="btn @(_graphView ? "" : "is-active")" aria-pressed="@(_graphView ? "false" : "true")"
                @onclick="() => SetView(false)">History</button>
        <button class="btn @(_graphView ? "is-active" : "")" aria-pressed="@(_graphView ? "true" : "false")"
                @onclick="() => SetView(true)">Graph</button>
    </div>

    @if (_state is null)
    {
        <div class="editor">
            <h2>Start run</h2>

            @if (_detail.Dialog.StartQuestionId is null)
            {
                <p class="empty">
                    This dialog has no entry question – without it there is nothing to play through.
                    Set and save an entry question in the dialog editor.
                </p>
            }
            else
            {
                <p class="hint">
                    Begins at the entry question
                    <span class="mono">@QuestionLabel(_detail.Dialog.StartQuestionId.Value)</span>.
                    Every run gets its own user key and therefore starts fresh.
                </p>
                <div class="actions">
                    <button class="btn btn-primary" disabled="@_busy" @onclick="StartRunAsync">Start run</button>
                </div>
            }
        </div>
    }
    else
    {
        @* The history list belongs to the list view; the "Current question" card below it stands in
           BOTH – it is the operation of the run, not its representation. *@
        @if (!_graphView)
        {
            <div class="editor">
                <h2>History</h2>

                @if (_state.Answers.Count == 0)
                {
                    <p class="empty">No answer recorded yet.</p>
                }
                else
                {
                    <ol class="transcript">
                        @foreach (var answer in _state.Answers.OrderBy(entry => entry.Sequence))
                        {
                            // Local copies: otherwise the buttons' lambdas would run against the
                            // loop state after the last iteration.
                            var entry = answer;
                            var question = QuestionOf(entry.QuestionId);

                            <li class="@(entry.LoopInstanceId is null ? "step" : "step step-loop")">
                                <div class="step-head">
                                    <span class="mono">@entry.QuestionKey</span>
                                    @if (entry.IterationIndex is { } iteration)
                                    {
                                        <span class="badge badge-loop" title="Answer within a loop">
                                            Iteration @(iteration + 1)
                                        </span>
                                    }
                                    <span class="step-time">@entry.AnsweredAt.LocalDateTime.ToString("T")</span>
                                </div>

                                <div class="step-text">@(question?.Text ?? "Question no longer belongs to the dialog")</div>
                                <div class="step-value">@AnswerValueCodec.Describe(question, entry.Value)</div>

                                @if (question is null)
                                {
                                    <span class="hint">Without a question in the graph this answer cannot be edited.</span>
                                }
                                else if (_editing is { } editing && editing.Answer.Sequence == entry.Sequence)
                                {
                                    <AnswerInput Type="question.Type"
                                                 Options="AnswerChoice.From(question.Options)"
                                                 Input="editing.Input"
                                                 OnSubmit="SaveEditAsync"
                                                 SubmitLabel="Save"
                                                 Disabled="_busy" />
                                    <div class="actions">
                                        <button class="btn" disabled="@_busy" @onclick="() => _editing = null">Cancel</button>
                                    </div>
                                    <span class="hint">
                                        On saving, all downstream answers are discarded and the path
                                        recomputed from here.
                                    </span>
                                }
                                else
                                {
                                    @* Disabled rather than opening a form that can only say no: a JSON
                                       answer is not editable here (AnswerInputModel.CanSubmit). *@
                                    <button class="btn"
                                            disabled="@(_busy || !QuestionTypeLabels.IsAnswerableInDesigner(question.Type))"
                                            title="@(QuestionTypeLabels.IsAnswerableInDesigner(question.Type)
                                                ? null
                                                : "A JSON answer cannot be edited in the designer.")"
                                            @onclick="() => StartEdit(entry, question)">Edit</button>
                                }
                            </li>
                        }
                    </ol>
                }
            </div>
        }

        <div class="editor">
            @if (_state.CurrentQuestion is { } current)
            {
                <h2>Current question</h2>

                @* Deliberately WITHOUT an iteration badge: the iterationIndex of the context means the last
                   answer given to this question, not the upcoming one – read as "current iteration"
                   it would be misleading. The exact indices are in the history, the raw value
                   below in the expression context. *@
                <p class="question-text">
                    <span class="mono">@current.Key</span>
                    @current.Text
                </p>
                <p class="hint">@QuestionTypeLabels.Describe(current.Type)</p>

                @if (_input is not null)
                {
                    <AnswerInput Type="current.Type"
                                 Options="AnswerChoice.From(current.Options)"
                                 Input="_input"
                                 OnSubmit="SubmitAsync"
                                 Disabled="_busy" />
                }
            }
            else
            {
                <h2>Result</h2>

                <div class="banner ok">
                    @(_state.Status == SessionStatus.Completed
                        ? "Dialog completed – after the last question no transition matched anymore."
                        : $"No open question anymore (status: {_state.Status}).")
                    Earlier answers can still be edited above.
                </div>
            }

            <div class="actions">
                <button class="btn" disabled="@_busy" @onclick="StartRunAsync">Start new run</button>
            </div>
        </div>

        @* Expression context and trigger log are the global panels of the list view. In the
           graph view the same details stand at the selected node (#104) – where they arise. *@
        @if (!_graphView)
        {
            <div class="editor">
                <h2>Expression context</h2>

                <p class="hint">
                    What the transition and trigger conditions are computing with right now – the same bindings the
                    engine sees in the expression. The values are raw JSON text.
                </p>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Identifier</th>
                            <th>Kind</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var question in _detail.Questions)
                        {
                            <tr>
                                <td class="mono">@question.Key</td>
                                <td>Answer</td>
                                <td class="mono">
                                    @(_snapshot is not null && _snapshot.Answers.TryGetValue(question.Key, out var bound)
                                        ? bound
                                        : "— not answered yet —")
                                </td>
                            </tr>
                        }
                        @foreach (var loop in _detail.Loops)
                        {
                            var entries = _snapshot?.Collections.GetValueOrDefault(loop.CollectionKey) ?? [];

                            <tr>
                                <td class="mono">@loop.CollectionKey</td>
                                <td>Loop (@entries.Count)</td>
                                <td class="mono">@(entries.Count == 0 ? "— empty —" : string.Join(", ", entries))</td>
                            </tr>
                        }
                        <tr>
                            <td class="mono">iterationIndex</td>
                            <td>Context</td>
                            <td class="mono" title="Iteration index of the last answer given to the open question">
                                @(_snapshot?.IterationIndex?.ToString() ?? "— outside a loop —")
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="editor">
                <h2>Triggers</h2>

                <p class="hint">
                    Above, what the engine has published in this run; below, what is configured on the dialog.
                    <strong>In-process</strong> entries the engine deliberately does not deliver itself –
                    for those the host app plugs in its own <code>INotificationHandler&lt;T&gt;</code>.
                </p>

                @if (TriggerLog.Entries.Count == 0)
                {
                    <p class="empty">Nothing published yet.</p>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>When</th>
                                <th>Question</th>
                                <th>What</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var logEntry in TriggerLog.Entries)
                            {
                                <tr>
                                    <td>@logEntry.OccurredAt.LocalDateTime.ToString("T")</td>
                                    <td>@TriggerLabels.Describe(logEntry.Scope)</td>
                                    <td class="mono">
                                        @(logEntry.QuestionId is { } questionId ? QuestionLabel(questionId) : "—")
                                    </td>
                                    <td>@logEntry.Detail</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (_detail.Triggers.Count == 0)
                {
                    <p class="hint">No trigger is configured on the dialog.</p>
                }
                else
                {
                    <ul class="configured-triggers">
                        @foreach (var trigger in _detail.Triggers)
                        {
                            <li>
                                @TriggerLabels.Describe(trigger.Scope) · @TriggerLabels.Describe(trigger.Kind)
                                @if (trigger.QuestionId is { } questionId)
                                {
                                    <span class="mono">after @QuestionLabel(questionId)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(trigger.Expression))
                                {
                                    <span class="mono">when @trigger.Expression</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    }

    @if (_graphView && _graph is not null)
    {
        <div class="graph-toolbar">
            <button class="btn" @onclick="() => ZoomAsync(GraphMetrics.ZoomStep)" aria-label="Zoom in">＋</button>
            <button class="btn" @onclick="() => ZoomAsync(1 / GraphMetrics.ZoomStep)" aria-label="Zoom out">－</button>
            <button class="btn" @onclick="ResetViewAsync">Reset view</button>

            <span class="hint">
                The graph is not editable here – a run works on exactly this graph.
                Moving and zooming work; to change it go to the
                <a href="@($"dialogs/{DialogId}/graph")">graph editor</a>.
            </span>
        </div>

        <div class="graph-layout">
            <GraphRunCanvas @ref="_canvas"
                            Model="_graph"
                            Run="Overlay"
                            Selection="_selection"
                            Busy="_busy"
                            Select="OnSelect"
                            Move="MoveNodeAsync" />

            <GraphRunInspector Model="_graph"
                               Detail="_detail"
                               Run="Overlay"
                               Snapshot="_snapshot"
                               Selection="_selection"
                               Busy="_busy"
                               EditingSequence="_editing?.Answer.Sequence"
                               EditInput="_editing?.Input"
                               Select="OnSelect"
                               StartEdit="StartEditAt"
                               SaveEdit="SaveEditAsync"
                               CancelEdit="() => _editing = null" />
        </div>
    }
}

@code {
    /// <summary>The primary key of the dialog to play through (from the route).</summary>
    [Parameter]
    public Guid DialogId { get; set; }

    /// <summary>
    /// The initial representation: <c>graph</c> opens the graph view (#104), anything else the
    /// history list. Only an <b>initial value</b> – the toggle afterwards does not rewrite the address,
    /// because a reload ends the run anyway.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    /// <summary>
    /// Prefix of the user key assigned per run. Makes the sessions created in the test run recognizable in
    /// the database – the runner deliberately does not clean them up (the engine knows no deletion
    /// of sessions).
    /// </summary>
    internal const string UserKeyPrefix = "designer-test-";

    private DialogDetail? _detail;
    private ResumeDialogResult? _state;
    private RunExpressionSnapshot? _snapshot;
    private Guid? _sessionId;
    private AnswerInputModel? _input;
    private EditState? _editing;
    private string? _error;
    private string? _message;
    private bool _busy;
    private Guid _loadedId;

    // ---- Graph view (#104) ---------------------------------------------------------------------------

    private bool _graphView;
    private DialogGraphModel? _graph;
    private GraphRunOverlay? _run;
    private GraphSelection? _selection;
    private GraphRunCanvas? _canvas;

    /// <summary>
    /// The state of the trigger log <b>before</b> the running step. Everything from this index on is new
    /// and flashes once at the triggering node.
    /// </summary>
    private int _freshFrom;

    /// <summary>The run state – before the first run the empty one.</summary>
    private GraphRunOverlay Overlay => _run ?? GraphRunAnalyzer.NotStarted();

    /// <summary>The history entry currently being edited together with its pre-filled input state.</summary>
    /// <param name="Answer">The answer to overwrite.</param>
    /// <param name="Input">The pre-filled input state.</param>
    private sealed record EditState(SessionAnswerView Answer, AnswerInputModel Input);

    private bool HasWebhookTrigger
        => _detail is not null && _detail.Triggers.Any(trigger => trigger.Kind == TriggerKind.Webhook);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == DialogId)
        {
            return;
        }

        _loadedId = DialogId;
        _state = null;
        _snapshot = null;
        _sessionId = null;
        _input = null;
        _editing = null;
        _message = null;
        _run = null;
        _selection = null;

        // Only when loading the dialog: afterwards the view belongs to the toggle, not the address.
        _graphView = string.Equals(View, "graph", StringComparison.OrdinalIgnoreCase);

        var result = await Admin.ExecuteAsync((sender, token) => sender.Send(new GetDialogQuery(DialogId), token));
        _detail = result.Value;
        _error = result.Error;

        // The drawing model arises ONCE per loaded dialog. Computed from the markup, the
        // whole layout would run again on every render – i.e. on every step of the run (#101).
        _graph = _detail is null ? null : DialogGraphBuilder.Build(_detail);
    }

    /// <summary>
    /// Starts a new run. The user key is fresh per run – otherwise
    /// <c>StartDialogVersionAsync</c> would continue the still-open session of the previous run (resume) instead of
    /// starting anew.
    /// </summary>
    private async Task StartRunAsync()
    {
        _busy = true;
        _message = null;
        _editing = null;
        _selection = null;
        TriggerLog.Clear();

        // Fresh log: everything this start publishes is new.
        _freshFrom = 0;

        try
        {
            var userKey = $"{UserKeyPrefix}{Guid.NewGuid():N}";
            var started = await Runtime.ExecuteAsync(
                (engine, token) => engine.StartDialogVersionAsync(DialogId, userKey, token));

            if (!started.Success)
            {
                _error = started.Error;
                return;
            }

            _error = null;
            _sessionId = started.Value!.SessionId;
            _message = "New run started.";
            await RefreshAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Submits the answer to the currently open question.</summary>
    private async Task SubmitAsync()
    {
        if (_state?.CurrentQuestion is not { } current || _input is not { CanSubmit: true })
        {
            return;
        }

        var value = _input.Encode();

        _ = await RunAsync(
            (engine, token) => engine.SubmitAnswerAsync(_sessionId!.Value, current.Id, value, token),
            result => result.IsCompleted ? "Answer recorded – dialog completed." : "Answer recorded.");
    }

    /// <summary>Opens the edit mode for an already given answer.</summary>
    /// <param name="answer">The answer to overwrite.</param>
    /// <param name="question">The associated question (for type and options).</param>
    private void StartEdit(SessionAnswerView answer, QuestionDetail question)
    {
        _message = null;
        _editing = new EditState(answer, AnswerInputModel.From(question.Type, answer.Value));
    }

    /// <summary>
    /// Overwrites an earlier answer. The iteration index is passed along so that within a
    /// loop exactly the clicked iteration is hit and not the earliest.
    /// </summary>
    private async Task SaveEditAsync()
    {
        if (_editing is not { Input.CanSubmit: true } editing)
        {
            return;
        }

        var value = editing.Input.Encode();

        var saved = await RunAsync(
            (engine, token) => engine.EditAnswerAsync(
                _sessionId!.Value, editing.Answer.QuestionId, value, editing.Answer.IterationIndex, token),
            result => $"Answer changed – {result.InvalidatedAnswers} downstream answer(s) discarded.");

        if (saved)
        {
            _editing = null;
        }
    }

    /// <summary>
    /// Runs an engine step, reports success or error and then reads the
    /// session state anew – which is the only source for history, current question and context.
    /// </summary>
    /// <typeparam name="TResult">The result type of the step.</typeparam>
    /// <param name="step">The engine step to run.</param>
    /// <param name="describe">Formulates the success message from the result.</param>
    /// <returns><see langword="true"/> if the step succeeded.</returns>
    private async Task<bool> RunAsync<TResult>(
        Func<IFlirtyEngine, CancellationToken, Task<TResult>> step, Func<TResult, string> describe)
    {
        _busy = true;
        _message = null;

        // The state BEFORE the step: what is added afterwards is the result of exactly this step and
        // flashes in the graph view at the triggering node.
        _freshFrom = TriggerLog.Entries.Count;

        try
        {
            var result = await Runtime.ExecuteAsync(step);
            if (!result.Success)
            {
                _error = result.Error;
                return false;
            }

            _error = null;
            _message = describe(result.Value!);
            await RefreshAsync();
            return true;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Reads the session state anew and builds history, input field and expression context from it.
    /// </summary>
    private async Task RefreshAsync()
    {
        if (_sessionId is not { } sessionId)
        {
            return;
        }

        var result = await Runtime.ExecuteAsync((engine, token) => engine.ResumeDialogAsync(sessionId, token));
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }

        _state = result.Value!;
        _snapshot = _detail is null ? null : RunExpressionContext.Build(_detail, _state);
        _input = _state.CurrentQuestion is { } current ? AnswerInputModel.For(current) : null;

        // The run state arises anew after EVERY step – also after an edit that discards downstream
        // answers: the path is derived from the answer sequence and thereby shrinks along by
        // itself (#104).
        _run = _detail is null
            ? null
            : GraphRunAnalyzer.Build(_detail, _state, TriggerLog.Entries, _freshFrom);
    }

    // ---- Graph view (#104) ---------------------------------------------------------------------------

    /// <summary>
    /// Switches the representation. The run itself stays untouched – also an editing session already begun, which
    /// is the same in both views.
    /// </summary>
    /// <param name="graph"><see langword="true"/> for the graph view.</param>
    private void SetView(bool graph) => _graphView = graph;

    /// <summary>Selects an element on the canvas.</summary>
    /// <remarks>
    /// A new selection ends an editing session already begun: the form hangs on the selected node, and
    /// an invisibly continuing draft would, on saving, write into an answer that no one has
    /// in front of them anymore.
    /// </remarks>
    /// <param name="selection">The selected element.</param>
    private void OnSelect(GraphSelection selection)
    {
        _selection = selection;
        _editing = null;
    }

    /// <summary>
    /// Opens the edit mode for the answer with this position – the path from the inspector, which
    /// lists its answers per iteration.
    /// </summary>
    /// <param name="sequence">The <c>Sequence</c> of the answer to overwrite.</param>
    private void StartEditAt(int sequence)
    {
        if (_state?.Answers.FirstOrDefault(answer => answer.Sequence == sequence) is not { } target
            || QuestionOf(target.QuestionId) is not { } question)
        {
            return;
        }

        StartEdit(target, question);
    }

    private async Task ZoomAsync(double factor)
    {
        if (_canvas is not null)
        {
            await _canvas.ZoomAsync(factor);
        }
    }

    private async Task ResetViewAsync()
    {
        if (_canvas is not null)
        {
            await _canvas.ResetViewAsync();
        }
    }

    /// <summary>
    /// Takes over the new position of a node after the drag ended in the browser.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Moving is allowed here too – a position does not belong to the graph, the command runs without
    /// <c>DialogEditGuard</c> (ADR 0007), and whoever follows a run wants all the more to be able to
    /// arrange the graph. It is the only writing path of this view.
    /// </para>
    /// <para>
    /// On success the returned layout is taken over into the <b>buffered</b> <c>DialogDetail</c>
    /// and the drawing model rebuilt from it; on a failure it arises from the unchanged
    /// state, and the node springs back visibly. Leaving it in place would claim a position that
    /// does not exist in the database.
    /// </para>
    /// </remarks>
    /// <param name="move">The moved question and its new position.</param>
    private async Task MoveNodeAsync(NodeMove move)
    {
        if (_busy || _detail is null)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await Admin.ExecuteAsync((sender, token) => sender.Send(
                new SetDialogLayoutCommand(
                    DialogId,
                    [new DialogLayoutEntry(LayoutElementKind.Question, move.QuestionId, move.X, move.Y)]),
                token));

            if (result.Success)
            {
                _detail = _detail with { Layout = result.Value! };
            }
            else
            {
                _error = result.Error;
            }

            _graph = DialogGraphBuilder.Build(_detail);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private QuestionDetail? QuestionOf(Guid questionId)
        => _detail?.Questions.FirstOrDefault(question => question.Id == questionId);

    private string QuestionLabel(Guid questionId)
        => QuestionOf(questionId)?.Key ?? $"unknown ({questionId})";
}
