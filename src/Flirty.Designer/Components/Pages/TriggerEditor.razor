@* Deliberately NOT named "TriggerDetail": the component type would otherwise shadow the
   view type Flirty.Runtime.Admin.TriggerDetail of the same name (as with DialogEditor/QuestionEditor). *@
@page "/dialogs/{DialogId:guid}/triggers/{TriggerId:guid}"
@rendermode InteractiveServer
@using Mediator
@using Flirty.Domain
@using Flirty.Expressions
@using Flirty.Runtime.Admin
@inject FlirtyAdminGateway Admin
@inject IExpressionEvaluator Evaluator
@inject NavigationManager Navigation

<PageTitle>Trigger · Flirty Designer</PageTitle>

<p class="back"><a href="@($"dialogs/{DialogId}")">← @(_detail?.Dialog.Name ?? "Dialog")</a></p>

@if (_trigger is null)
{
    <h1>Trigger</h1>

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    else
    {
        <p class="empty">Loading …</p>
    }
}
else
{
    <h1>
        @TriggerLabels.Describe(_trigger.Scope)
        <span class="badge badge-default">@TriggerLabels.Describe(_trigger.Kind)</span>
    </h1>

    <p class="intro">
        Trigger in the dialog <a href="@($"dialogs/{DialogId}")">@_detail!.Dialog.Name</a>
        @if (_trigger.QuestionId is { } boundQuestionId)
        {
            <text>· bound to the question <span class="mono">@QuestionLabel(boundQuestionId)</span></text>
        }
    </p>

    @if (_detail.Dialog.IsPublished)
    {
        <div class="banner warn">
            The dialog is published in version @_detail.Dialog.Version: its graph is <strong>locked</strong>,
            so that running sessions do not break. To change it, create a new version in the
            <a href="@($"dialogs/{DialogId}")">dialog editor</a> or unpublish the dialog.
        </div>
    }

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    @if (_message is not null)
    {
        <div class="banner ok">@_message</div>
    }

    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="editor">
            <h2>Trigger point</h2>

            <div class="field">
                <label for="scope">Point in time</label>
                <InputSelect id="scope" class="input" @bind-Value="_form.Scope">
                    @foreach (var scope in Enum.GetValues<TriggerScope>())
                    {
                        <option value="@scope">@TriggerLabels.Describe(scope)</option>
                    }
                </InputSelect>
                <span class="hint">
                    Determines which notification fires the trigger – the same four points in time that the
                    engine publishes.
                </span>
            </div>

            @if (TriggerLabels.RequiresQuestion(_form.Scope))
            {
                <div class="field">
                    <label for="question">Question</label>
                    <InputSelect id="question" class="input" @bind-Value="_form.QuestionId">
                        <option value="">— select —</option>
                        @foreach (var question in _detail.Questions)
                        {
                            <option value="@question.Id">@question.Key — @question.Text</option>
                        }
                    </InputSelect>
                    <span class="hint">Required at this point in time: the trigger only fires after this question.</span>
                </div>
            }
            else
            {
                <span class="hint">
                    This point in time does not relate to a single question – a question reference is
                    removed on save.
                </span>
            }

            @if (!TriggerLabels.HasAnswers(_form.Scope) && !string.IsNullOrWhiteSpace(_form.Expression))
            {
                <div class="banner warn">
                    At dialog start there are still <strong>no answers</strong>. A condition on a question
                    key cannot be evaluated at runtime – the trigger then does not fire (the error is only
                    logged).
                </div>
            }
        </div>

        <div class="editor">
            <h2>Channel</h2>

            <div class="field">
                <label for="kind">Channel</label>
                <InputSelect id="kind" class="input" @bind-Value="_form.Kind">
                    @foreach (var kind in Enum.GetValues<TriggerKind>())
                    {
                        <option value="@kind">@TriggerLabels.Describe(kind)</option>
                    }
                </InputSelect>
            </div>

            @if (_form.Kind == TriggerKind.InProcess)
            {
                <div class="banner warn">
                    In-process triggers are <strong>not</strong> delivered by the engine: the notification
                    is published anyway, and it is handled by a handler of the host app. This entry
                    documents the intent (and names it).
                    <br />
                    <code>services.AddFlirtyHandler&lt;DialogCompletedNotification, MyHandler&gt;();</code>
                </div>
            }

            @if (_form.UseRawJson)
            {
                <div class="banner warn">
                    The saved configuration contains unknown fields or is not a valid JSON object. It is
                    therefore edited raw, so that nothing is lost. Known fields are
                    <code>url</code> and <code>name</code>.
                </div>

                <div class="field">
                    <label for="rawConfig">Configuration (JSON)</label>
                    <InputTextArea id="rawConfig" class="input mono" rows="5" @bind-Value="_form.RawJson" />
                </div>
            }
            else
            {
                @if (_form.Kind == TriggerKind.Webhook)
                {
                    <div class="field">
                        <label for="url">Target URL</label>
                        <InputText id="url" class="input mono" @bind-Value="_form.Url" />
                        <span class="hint">
                            Absolute http/https address. An HTTP POST with the notification as the JSON body
                            is delivered (retry/timeout included, best-effort).
                        </span>
                    </div>
                }

                <div class="field">
                    <label for="name">Event name (optional)</label>
                    <InputText id="name" class="input mono" @bind-Value="_form.Name" />
                    <span class="hint">
                        Delivered as the header <code>X-Flirty-Trigger</code>; the point in time is in
                        <code>X-Flirty-Event</code> anyway.
                    </span>
                </div>
            }
        </div>

        <div class="editor">
            <h2>Condition</h2>

            @* Input field, live status, error location, snippet inserter and identifier reference have
               lived in ExpressionField since #103 – previously the block stood here and in the
               TransitionEditor line for line the same. Side effect of the merge: the live status is styled
               here for the first time (.expr-status/.expr-caret used to be scoped in the TransitionEditor). *@
            <ExpressionField Detail="_detail"
                             @bind-Value="_form.Expression"
                             EmptyHint="fires unconditionally"
                             EmptyMeaning="the trigger always fires" />

        </div>

        <div class="actions">
            <button type="submit" class="btn btn-primary" disabled="@(_busy || !Editable)">Save</button>
            <button type="button" class="btn" disabled="@(_busy || !Editable)" @onclick="ResetForm">Reset</button>
        </div>
    </EditForm>

    <div class="editor">
        <h2>Delete trigger</h2>

        <p class="hint">
            Without this trigger the dialog continues unchanged – only the back channel is dropped.
        </p>

        <div class="actions">
            @if (_confirmDelete)
            {
                <span class="confirm">Really delete trigger?</span>
                <button class="btn btn-danger" disabled="@(_busy || !Editable)" @onclick="DeleteAsync">Yes, delete</button>
                <button class="btn" disabled="@(_busy || !Editable)" @onclick="() => _confirmDelete = false">Cancel</button>
            }
            else
            {
                <button class="btn btn-danger" disabled="@(_busy || !Editable)" @onclick="() => _confirmDelete = true">Delete</button>
            }
        </div>
    </div>
}

@code {
    /// <summary>The primary key of the dialog (from the route).</summary>
    [Parameter]
    public Guid DialogId { get; set; }

    /// <summary>The primary key of the edited trigger (from the route).</summary>
    [Parameter]
    public Guid TriggerId { get; set; }

    /// <summary>
    /// Whether the graph is editable: on a published version the engine rejects graph changes with a
    /// conflict (<c>DialogPublishedException</c>), so that running sessions do not break. The lock
    /// mirrors that in the UI.
    /// </summary>
    private bool Editable => _detail is not null && !_detail.Dialog.IsPublished;
    private DialogDetail? _detail;
    private TriggerDetail? _trigger;
    private TriggerFormModel _form = new();
    /// <summary>
    /// The sample context for the <b>blocking</b> check in <see cref="SaveAsync"/>. The live display
    /// during input is done by <c>ExpressionField</c>; the decision whether to save deliberately stays
    /// here.
    /// </summary>
    private ExpressionContext? _context;
    private string? _error;
    private string? _message;
    private bool _busy;
    private bool _confirmDelete;
    private (Guid Dialog, Guid Trigger) _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == (DialogId, TriggerId))
        {
            return;
        }

        _loaded = (DialogId, TriggerId);
        _message = null;
        _confirmDelete = false;
        await ReloadAsync();
    }

    /// <summary>
    /// Loads the dialog graph and picks out the edited trigger. A single <c>GetDialogQuery</c> suffices:
    /// it delivers questions (for the selection and the sample context), the loop markers (for the
    /// collection identifiers in the expression) and the triggers themselves.
    /// </summary>
    private async Task ReloadAsync()
    {
        var result = await Admin.ExecuteAsync((sender, token) => sender.Send(new GetDialogQuery(DialogId), token));
        _detail = result.Value;
        _error = result.Error;

        _trigger = _detail?.Triggers.FirstOrDefault(trigger => trigger.Id == TriggerId);

        if (_detail is not null && _trigger is null)
        {
            _error = $"The dialog '{DialogId}' contains no trigger with the id '{TriggerId}'.";
        }

        if (_detail is not null)
        {
            _context = DesignerExpressionContext.Build(_detail);
        }

        ResetForm();
    }

    private void ResetForm()
    {
        if (_trigger is not null)
        {
            _form = TriggerFormModel.From(_trigger);
        }
    }

    private string QuestionLabel(Guid questionId)
        => _detail?.Questions.FirstOrDefault(question => question.Id == questionId)?.Key
            ?? questionId.ToString();

    /// <summary>
    /// Saves the trigger – after configuration and expression have been checked in a <b>blocking</b> way.
    /// An invalid expression would otherwise only surface at runtime when firing (where it is logged and
    /// the trigger skipped – so silently nothing is delivered).
    /// </summary>
    private async Task SaveAsync()
    {
        if (_detail is null || _trigger is null || _context is null)
        {
            return;
        }

        if (TriggerLabels.RequiresQuestion(_form.Scope) && _form.QuestionId is null)
        {
            _error = "Please select a question – a trigger after a specific question needs its reference.";
            _message = null;
            return;
        }

        if (!_form.TryBuildConfig(out var config, out var configError))
        {
            _error = configError;
            _message = null;
            return;
        }

        var expression = _form.NormalizedExpression();

        // Over the dialog, not the prebuilt context: a JSON answer has no single sample shape, and this
        // check BLOCKS the save - see DesignerExpressionContext.Build(detail, jsonAsObject).
        var validation = DesignerExpressionContext.Validate(Evaluator, expression, _detail!);

        if (!validation.IsValid)
        {
            _error = $"The condition is invalid: {validation.Error}";
            _message = null;
            return;
        }

        await RunAsync<TriggerDetail>(
            (sender, token) => sender.Send(
                new UpdateTriggerCommand(
                    DialogId, TriggerId, _form.Scope, _form.NormalizedQuestionId(), _form.Kind, config,
                    expression),
                token),
            "Trigger saved.");
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            var result = await Admin.ExecuteAsync(
                (sender, token) => sender.Send(new DeleteTriggerCommand(DialogId, TriggerId), token));

            if (!result.Success)
            {
                _error = result.Error;
                _confirmDelete = false;
                return;
            }

            Navigation.NavigateTo($"dialogs/{DialogId}");
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Runs a writing operation, shows success or error and reloads the graph.
    /// </summary>
    /// <typeparam name="TResult">The result type of the operation.</typeparam>
    /// <param name="operation">The admin message to execute.</param>
    /// <param name="successMessage">The message shown on success.</param>
    /// <returns><see langword="true"/> if the operation succeeded.</returns>
    private async Task<bool> RunAsync<TResult>(
        Func<ISender, CancellationToken, ValueTask<TResult>> operation,
        string successMessage)
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Admin.ExecuteAsync(operation);
            if (!result.Success)
            {
                _error = result.Error;
                return false;
            }

            _error = null;
            _message = successMessage;
            await ReloadAsync();
            return true;
        }
        finally
        {
            _busy = false;
        }
    }
}
