@* Deliberately NOT named "LoopDetail": the component type would otherwise shadow the
   view type Flirty.Runtime.Admin.LoopDetail of the same name (as with DialogEditor/QuestionEditor). *@
@page "/dialogs/{DialogId:guid}/loops/{LoopId:guid}"
@rendermode InteractiveServer
@using Mediator
@using Flirty.Runtime.Admin
@inject FlirtyAdminGateway Admin
@inject NavigationManager Navigation

<PageTitle>Loop · Flirty Designer</PageTitle>

<p class="back"><a href="@($"dialogs/{DialogId}")">← @(_detail?.Dialog.Name ?? "Dialog")</a></p>

@if (_insight is null)
{
    <h1>Loop</h1>

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    else
    {
        <p class="empty">Loading …</p>
    }
}
else
{
    <h1>
        <span class="mono">@_insight.Loop.CollectionKey</span>
        @if (_insight.Warnings.Count == 0)
        {
            <span class="badge badge-loop">Loop</span>
        }
        else
        {
            <span class="badge badge-draft">@_insight.Warnings.Count warning(s)</span>
        }
    </h1>

    <p class="intro">
        Loop body over @_insight.Body.Count question(s) in the dialog
        <a href="@($"dialogs/{DialogId}")">@_detail!.Dialog.Name</a>
    </p>

    @if (_detail.Dialog.IsPublished)
    {
        <div class="banner warn">
            The dialog is published in version @_detail.Dialog.Version: its graph is <strong>locked</strong>,
            so that running sessions do not break. To change it, create a new version in the
            <a href="@($"dialogs/{DialogId}")">dialog editor</a> or unpublish the dialog.
        </div>
    }

    @if (_error is not null)
    {
        <div class="banner err">@_error</div>
    }
    @if (_message is not null)
    {
        <div class="banner ok">@_message</div>
    }

    @foreach (var warning in _insight.Warnings)
    {
        <div class="banner warn">@warning</div>
    }

    <div class="editor">
        <h2>Loop block</h2>

        @if (_insight.Body.Count == 0)
        {
            <p class="empty">
                No loop body determinable – the entry or breaking question no longer belongs to this
                dialog.
            </p>
        }
        else
        {
            <p class="hint">
                The body follows from the transition graph: all questions reachable from the entry question
                <em>and</em> from which the breaking question stays reachable. Exactly these questions carry
                an iteration index at runtime.
            </p>

            <ol class="loop-block">
                @foreach (var question in _insight.Body)
                {
                    <li>
                        <span class="mono">@question.Key</span>
                        <span class="group-text">— @question.Text</span>

                        @if (question.Id == _insight.Loop.EntryQuestionId)
                        {
                            <span class="badge badge-start">Entry</span>
                        }
                        @if (question.Id == _insight.Loop.BreakingQuestionId)
                        {
                            <span class="badge badge-loop">Breaking</span>
                        }

                        @if (question.Id == _insight.Loop.BreakingQuestionId)
                        {
                            <ul class="loop-edges">
                                @foreach (var transition in _insight.LoopBackTransitions)
                                {
                                    <li>
                                        <span title="Back-jump into the loop body">↩</span>
                                        <a href="@($"dialogs/{DialogId}/transitions/{transition.Id}")">
                                            → @QuestionLabel(transition.TargetQuestionId)
                                        </a>
                                        <span class="mono">@Condition(transition)</span>
                                    </li>
                                }
                                @foreach (var transition in _insight.ExitTransitions)
                                {
                                    <li>
                                        <span title="Exit from the loop body">⇥</span>
                                        <a href="@($"dialogs/{DialogId}/transitions/{transition.Id}")">
                                            → @QuestionLabel(transition.TargetQuestionId)
                                        </a>
                                        <span class="mono">@Condition(transition)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ol>

            <p class="hint">
                The order of the transitions (and thus which one applies first) is maintained in the
                <a href="@($"dialogs/{DialogId}")">transition list of the dialog</a>.
            </p>
        }
    </div>

    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="editor">
            <h2>Marker</h2>

            <div class="field">
                <label for="collectionKey">Collection key</label>
                <InputText id="collectionKey" class="input mono" @bind-Value="_form.CollectionKey" />
                <span class="hint">
                    Under this identifier the answers of the entry question collected per iteration are
                    available in the expression context – e.g. <code>@(_form.CollectionKey).Count &gt; 0</code>
                    as a break condition. It must be unique within the dialog.
                </span>
                <ValidationMessage For="() => _form.CollectionKey" />
            </div>

            <div class="field-row">
                <div class="field">
                    <label for="entry">Entry question</label>
                    <InputSelect id="entry" class="input" @bind-Value="_form.EntryQuestionId">
                        <option value="">— select —</option>
                        @foreach (var question in _detail.Questions)
                        {
                            <option value="@question.Id">@question.Key — @question.Text</option>
                        }
                    </InputSelect>
                    <span class="hint">
                        Target of the back-jump. Answering it again starts the next iteration, and exactly
                        its answer lands in the collection per iteration.
                    </span>
                    <ValidationMessage For="() => _form.EntryQuestionId" />
                </div>

                <div class="field">
                    <label for="breaking">Breaking question</label>
                    <InputSelect id="breaking" class="input" @bind-Value="_form.BreakingQuestionId">
                        <option value="">— select —</option>
                        @foreach (var question in _detail.Questions)
                        {
                            <option value="@question.Id">@question.Key — @question.Text</option>
                        }
                    </InputSelect>
                    <span class="hint">
                        At it the normal branching decides between back-jump and exit – there is no
                        dedicated break expression.
                    </span>
                    <ValidationMessage For="() => _form.BreakingQuestionId" />
                </div>
            </div>
        </div>

        <div class="actions">
            <button type="submit" class="btn btn-primary" disabled="@(_busy || !Editable)">Save</button>
            <button type="button" class="btn" disabled="@(_busy || !Editable)" @onclick="ResetForm">Reset</button>
        </div>
    </EditForm>

    <div class="editor">
        <h2>Delete loop</h2>

        <p class="hint">
            Only the marker is deleted – the transitions and thus the cycle remain. Without the marker the
            runtime overwrites the answers of the body instead of collecting them per iteration, and
            <span class="mono">@_insight.Loop.CollectionKey</span> is no longer available in conditions.
        </p>

        <div class="actions">
            @if (_confirmDelete)
            {
                <span class="confirm">Really delete marker?</span>
                <button class="btn btn-danger" disabled="@(_busy || !Editable)" @onclick="DeleteAsync">Yes, delete</button>
                <button class="btn" disabled="@(_busy || !Editable)" @onclick="() => _confirmDelete = false">Cancel</button>
            }
            else
            {
                <button class="btn btn-danger" disabled="@(_busy || !Editable)" @onclick="() => _confirmDelete = true">Delete</button>
            }
        </div>
    </div>
}

@code {
    /// <summary>The primary key of the dialog (from the route).</summary>
    [Parameter]
    public Guid DialogId { get; set; }

    /// <summary>The primary key of the edited loop marker (from the route).</summary>
    [Parameter]
    public Guid LoopId { get; set; }

    /// <summary>
    /// Whether the graph is editable: on a published version the engine rejects graph changes with a
    /// conflict (<c>DialogPublishedException</c>), so that running sessions do not break. The lock
    /// mirrors that in the UI.
    /// </summary>
    private bool Editable => _detail is not null && !_detail.Dialog.IsPublished;
    private DialogDetail? _detail;
    private LoopInsight? _insight;
    private LoopFormModel _form = new();
    private string? _error;
    private string? _message;
    private bool _busy;
    private bool _confirmDelete;
    private (Guid Dialog, Guid Loop) _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == (DialogId, LoopId))
        {
            return;
        }

        _loaded = (DialogId, LoopId);
        _message = null;
        _confirmDelete = false;
        await ReloadAsync();
    }

    /// <summary>
    /// Loads the dialog graph and analyzes the edited marker. A single <c>GetDialogQuery</c> suffices:
    /// it delivers questions (for the selection and the loop block), transitions (for the body, back-jumps
    /// and exits) and the other markers (for the overlap check).
    /// </summary>
    private async Task ReloadAsync(bool resetForm = true)
    {
        var result = await Admin.ExecuteAsync((sender, token) => sender.Send(new GetDialogQuery(DialogId), token));
        _detail = result.Value;
        _error = result.Error;

        _insight = _detail is null ? null : LoopAnalyzer.Analyze(_detail, LoopId);

        if (_detail is not null && _insight is null)
        {
            _error = $"The dialog '{DialogId}' contains no loop with the id '{LoopId}'.";
        }

        if (resetForm)
        {
            ResetForm();
        }
    }

    private void ResetForm()
    {
        if (_insight is not null)
        {
            _form = LoopFormModel.From(_insight.Loop);
        }
    }

    private string QuestionLabel(Guid questionId)
        => _detail?.Questions.FirstOrDefault(question => question.Id == questionId)?.Key
            ?? $"unknown ({questionId})";

    private static string Condition(TransitionDetail transition)
        => transition.IsDefault
            ? "— Default —"
            : string.IsNullOrWhiteSpace(transition.Expression)
                ? "— unconditional —"
                : transition.Expression;

    private async Task SaveAsync()
        => await RunAsync<LoopDetail>(
            (sender, token) => sender.Send(
                new UpdateLoopCommand(
                    DialogId, LoopId, _form.CollectionKey,
                    _form.EntryQuestionId!.Value, _form.BreakingQuestionId!.Value),
                token),
            "Loop saved.");

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            var result = await Admin.ExecuteAsync(
                (sender, token) => sender.Send(new DeleteLoopCommand(DialogId, LoopId), token));

            if (!result.Success)
            {
                _error = result.Error;
                _confirmDelete = false;
                return;
            }

            Navigation.NavigateTo($"dialogs/{DialogId}");
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Runs a writing operation, shows success or error and reloads the graph.
    /// </summary>
    /// <typeparam name="TResult">The result type of the operation.</typeparam>
    /// <param name="operation">The admin message to execute.</param>
    /// <param name="successMessage">The message shown on success.</param>
    /// <returns><see langword="true"/> if the operation succeeded.</returns>
    private async Task<bool> RunAsync<TResult>(
        Func<ISender, CancellationToken, ValueTask<TResult>> operation,
        string successMessage)
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Admin.ExecuteAsync(operation);
            if (!result.Success)
            {
                _error = result.Error;
                return false;
            }

            _error = null;
            _message = successMessage;
            await ReloadAsync();
            return true;
        }
        finally
        {
            _busy = false;
        }
    }
}
