@*
    Das Inspector-Panel der Laufansicht (#104).

    Es zeigt dieselben drei Dinge wie die Listenansicht des Runners – Antworten samt Iteration,
    Ausdrucks-Bindungen und publizierte Trigger –, aber am gewählten Element statt global. Genau das ist
    der Gewinn gegenüber der Liste: Die Frage „womit rechnet die Bedingung an dieser Kante?" wird dort
    beantwortet, wo sie entsteht.

    Bearbeitet wird hier nur eine Antwort (EditAnswerAsync), nie der Graph: Eine laufende Session
    arbeitet auf diesem Graphen. Der Weg in die Konfiguration führt über die Editor-Ansicht.
*@
@using Flirty.Domain
@using Flirty.Runtime.Admin
@using Flirty.Designer.Services

<aside class="graph-inspector" aria-label="Details zum gewählten Element des Testlaufs">
    @if (SelectedNode is { } node)
    {
        var question = QuestionOf(node.QuestionId);
        var visit = Run.Visit(node.QuestionId);

        <h2>Frage</h2>
        <p class="graph-inspector-key mono" id="runInspectorKey">@node.Key</p>
        <p class="graph-inspector-text">@node.FullText</p>

        <dl class="graph-facts">
            <dt>Typ</dt>
            <dd>@node.TypeLabel</dd>
            <dt>Im Lauf</dt>
            <dd>
                @(visit switch
                {
                    { IsCurrent: true } => "gerade offen",
                    { Answers.Count: > 0 } => $"{visit.Answers.Count}-mal beantwortet",
                    _ => "nicht besucht",
                })
            </dd>
        </dl>

        @if (visit is { Answers.Count: > 0 } && question is not null)
        {
            <h3 class="graph-inspector-section">Antworten</h3>
            <ul class="graph-inspector-list run-answers">
                @foreach (var answer in visit.Answers)
                {
                    // Lokale Kopie: Die Lambdas liefen sonst gegen den Schleifenzustand nach dem
                    // letzten Durchlauf.
                    var entry = answer;

                    <li>
                        <div class="run-answer-head">
                            @if (entry.IterationIndex is { } iteration)
                            {
                                <span class="badge badge-loop">Iteration @(iteration + 1)</span>
                            }
                            <span class="run-answer-value">@entry.Display</span>
                            <span class="step-time">@entry.AnsweredAt.LocalDateTime.ToString("T")</span>
                        </div>

                        @* Der Rohwert ist das, womit die Bedingungen rechnen – die Anzeigeform darüber
                           ist die Beschriftung. Beides zu zeigen ist der Punkt: Genau diese Verwechslung
                           hat in #47 die Chat-UI stillschweigend falsche Werte speichern lassen. *@
                        <div class="mono run-answer-raw">@entry.Value</div>

                        @if (EditingSequence == entry.Sequence && EditInput is not null)
                        {
                            <AnswerInput Type="question.Type"
                                         Options="AnswerChoice.From(question.Options)"
                                         Input="EditInput"
                                         OnSubmit="SaveEdit"
                                         SubmitLabel="Speichern"
                                         Disabled="Busy" />
                            <div class="actions">
                                <button class="btn" disabled="@Busy" @onclick="() => CancelEdit.InvokeAsync()">
                                    Abbrechen
                                </button>
                            </div>
                            <span class="hint">
                                Beim Speichern werden alle nachgelagerten Antworten verworfen und der Pfad
                                ab hier neu berechnet.
                            </span>
                        }
                        else
                        {
                            <button class="btn" disabled="@Busy"
                                    @onclick="() => StartEdit.InvokeAsync(entry.Sequence)">Bearbeiten</button>
                        }
                    </li>
                }
            </ul>
        }

        <h3 class="graph-inspector-section">Bindungen im Ausdruck</h3>
        <dl class="graph-facts">
            <dt class="mono">@node.Key</dt>
            <dd class="mono">
                @(Snapshot is not null && Snapshot.Answers.TryGetValue(node.Key, out var bound)
                    ? bound
                    : "— noch nicht beantwortet —")
            </dd>

            @foreach (var loop in Run.LoopsOf(node.QuestionId))
            {
                var entries = Snapshot?.Collections.GetValueOrDefault(loop.CollectionKey) ?? [];

                <dt class="mono">@loop.CollectionKey</dt>
                <dd class="mono">@(entries.Count == 0 ? "— leer —" : string.Join(", ", entries))</dd>
            }

            @if (visit is { IsCurrent: true })
            {
                @* Nur an der offenen Frage: Der Wert meint den Index der ZULETZT gegebenen Antwort auf
                   genau sie (Semantik von LoopResolver.ResolveIterationIndex). An einem anderen Knoten
                   gezeigt behauptete er etwas über diesen Knoten – und wäre falsch. *@
                <dt class="mono">iterationIndex</dt>
                <dd class="mono">@(Snapshot?.IterationIndex?.ToString() ?? "— außerhalb einer Schleife —")</dd>
            }
        </dl>

        @if (Run.TriggersOf(node.QuestionId) is { Count: > 0 } fired)
        {
            <h3 class="graph-inspector-section">Ausgelöst</h3>
            <ul class="graph-inspector-list run-events">
                @foreach (var trigger in fired)
                {
                    <li>
                        <span class="step-time">@trigger.OccurredAt.LocalDateTime.ToString("T")</span>
                        <strong>@trigger.Label</strong> @trigger.Detail
                    </li>
                }
            </ul>
        }

        <h3 class="graph-inspector-section">Ausgehende Übergänge</h3>

        @if (Outgoing(node.QuestionId) is { Count: 0 })
        {
            <p class="hint">Keiner – hier endet der Dialog regulär.</p>
        }
        else
        {
            <ol class="graph-inspector-list">
                @foreach (var edge in Outgoing(node.QuestionId))
                {
                    var current = edge;
                    var use = Run.Edge(current.TransitionId);

                    <li>
                        <button class="btn graph-edge-link @(use is null ? "" : "is-taken")"
                                @onclick="() => Select.InvokeAsync(new GraphSelection(GraphElementKind.Transition, current.TransitionId))">
                            → @TargetKey(current) <span class="graph-edge-link-condition">@current.Label</span>
                        </button>
                        <span class="hint">@Describe(use)</span>
                    </li>
                }
            </ol>
        }
    }
    else if (SelectedEdge is { } edge)
    {
        var use = Run.Edge(edge.TransitionId);

        <h2>Übergang</h2>
        <p class="graph-inspector-key mono">@QuestionKey(edge.FromQuestionId) → @QuestionKey(edge.TargetQuestionId)</p>

        <dl class="graph-facts">
            <dt>Bedingung</dt>
            <dd class="mono">@edge.Label</dd>
            <dt>Im Lauf</dt>
            <dd>@Describe(use)</dd>
        </dl>

        @if (use is { IsAmbiguous: true })
        {
            <div class="banner warn">
                Zwischen diesen beiden Fragen liegen mehrere Übergänge. Welcher davon gegriffen hat, hält
                die Engine nicht fest – der Pfad wird aus der Antwortfolge abgeleitet, und die kennt nur
                das Fragenpaar. Markiert sind deshalb alle.
            </div>
        }

        <div class="actions">
            <button class="btn"
                    @onclick="() => Select.InvokeAsync(new GraphSelection(GraphElementKind.Question, edge.FromQuestionId))">
                Zur Ausgangsfrage
            </button>
            <button class="btn"
                    @onclick="() => Select.InvokeAsync(new GraphSelection(GraphElementKind.Question, edge.TargetQuestionId))">
                Zur Zielfrage
            </button>
        </div>
    }
    else if (SelectedLoop is { } loop)
    {
        var state = Run.Loop(loop.LoopId);

        <h2>Schleife</h2>
        <p class="graph-inspector-key mono">@loop.CollectionKey</p>

        <dl class="graph-facts">
            <dt>Einstieg</dt>
            <dd class="mono">@(string.IsNullOrEmpty(loop.EntryKey) ? "— fehlt —" : loop.EntryKey)</dd>
            <dt>Breaking Question</dt>
            <dd class="mono">@(string.IsNullOrEmpty(loop.BreakingKey) ? "— fehlt —" : loop.BreakingKey)</dd>
            <dt>Im Lauf</dt>
            <dd>
                @(state switch
                {
                    { Iterations: 0 } or null => "nicht betreten",
                    { IsActive: true } => $"{state.Iterations} Iteration(en), läuft gerade",
                    _ => $"{state.Iterations} Iteration(en), verlassen",
                })
            </dd>
            <dt class="mono">@loop.CollectionKey</dt>
            <dd class="mono">
                @{
                    var entries = Snapshot?.Collections.GetValueOrDefault(loop.CollectionKey) ?? [];
                }
                @(entries.Count == 0 ? "— leer —" : string.Join(", ", entries))
            </dd>
        </dl>
    }
    else
    {
        <h2>Testlauf</h2>

        <dl class="graph-facts">
            <dt>Status</dt>
            <dd>@DescribeStatus(Run.Status)</dd>
            <dt>Schritte</dt>
            <dd>@Run.Steps</dd>
        </dl>

        <p class="hint">
            Einen Knoten wählen – dann stehen hier seine Antworten, seine Bindungen und die dort
            ausgelösten Trigger.
        </p>

        @if (Run.DialogTriggers is { Count: > 0 } events)
        {
            <h3 class="graph-inspector-section">Ausgelöst (ohne Frage-Bezug)</h3>
            <ul class="graph-inspector-list run-events">
                @foreach (var trigger in events)
                {
                    <li>
                        <span class="step-time">@trigger.OccurredAt.LocalDateTime.ToString("T")</span>
                        <strong>@trigger.Label</strong> @trigger.Detail
                    </li>
                }
            </ul>
        }

        <h3 class="graph-inspector-section">Legende</h3>
        <ul class="graph-legend">
            <li><span class="badge badge-current">▶ offen</span> die Frage, die der Lauf gerade stellt</li>
            <li><span class="badge badge-visited">besucht</span> beantwortet – die Karte zeigt den Wert</li>
            <li><span class="chip chip-fired">⚡</span> im Lauf publizierter Trigger</li>
            <li><span class="legend-line is-taken"></span> gegriffener Übergang (dick und durchgezogen)</li>
        </ul>
    }
</aside>

@code {
    /// <summary>Der gesamte Graph – Nachbarschaft und Beschriftungen des gewählten Elements.</summary>
    [Parameter, EditorRequired]
    public required DialogGraphModel Model { get; set; }

    /// <summary>Der Dialog samt Graph – Quelle für Fragetyp und Antwortoptionen beim Editieren.</summary>
    [Parameter, EditorRequired]
    public required DialogDetail Detail { get; set; }

    /// <summary>Der Laufzustand.</summary>
    [Parameter, EditorRequired]
    public required GraphRunOverlay Run { get; set; }

    /// <summary>Die Ausdrucks-Bindungen des Laufs; <see langword="null"/>, solange keiner läuft.</summary>
    [Parameter]
    public RunExpressionSnapshot? Snapshot { get; set; }

    /// <summary>Das gewählte Element oder <see langword="null"/>.</summary>
    [Parameter]
    public GraphSelection? Selection { get; set; }

    /// <summary>Ob gerade ein Engine-Schritt läuft.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Die <c>Sequence</c> der gerade bearbeiteten Antwort oder <see langword="null"/>.</summary>
    [Parameter]
    public int? EditingSequence { get; set; }

    /// <summary>Der Eingabezustand der gerade bearbeiteten Antwort.</summary>
    [Parameter]
    public AnswerInputModel? EditInput { get; set; }

    /// <summary>Meldet die neue Auswahl.</summary>
    [Parameter]
    public EventCallback<GraphSelection> Select { get; set; }

    /// <summary>Meldet den Wunsch, die Antwort mit dieser <c>Sequence</c> zu bearbeiten.</summary>
    [Parameter]
    public EventCallback<int> StartEdit { get; set; }

    /// <summary>Meldet, dass die bearbeitete Antwort gespeichert werden soll.</summary>
    [Parameter]
    public EventCallback SaveEdit { get; set; }

    /// <summary>Meldet den Abbruch der Bearbeitung.</summary>
    [Parameter]
    public EventCallback CancelEdit { get; set; }

    private GraphNode? SelectedNode
        => Selection is { Kind: GraphElementKind.Question } selection ? Model.Node(selection.Id) : null;

    private GraphEdge? SelectedEdge
        => Selection is { Kind: GraphElementKind.Transition } selection ? Model.Edge(selection.Id) : null;

    private GraphLoopFrame? SelectedLoop
        => Selection is { Kind: GraphElementKind.Loop } selection
            ? Model.Loops.FirstOrDefault(loop => loop.LoopId == selection.Id)
            : null;

    private QuestionDetail? QuestionOf(Guid questionId)
        => Detail.Questions.FirstOrDefault(question => question.Id == questionId);

    private string QuestionKey(Guid questionId) => QuestionOf(questionId)?.Key ?? "unbekannt";

    private string TargetKey(GraphEdge edge) => QuestionKey(edge.TargetQuestionId);

    private IReadOnlyList<GraphEdge> Outgoing(Guid questionId)
        => [.. Model.Edges.Where(edge => edge.FromQuestionId == questionId).OrderBy(edge => edge.Position)];

    /// <summary>Beschreibt, ob und wie oft eine Kante gegriffen hat.</summary>
    private static string Describe(GraphRunEdgeUse? use)
        => use switch
        {
            null => "nicht gegriffen",
            { IsAmbiguous: true } => $"{use.Count}-mal durchlaufen (mehrdeutig)",
            { Count: 1 } => "gegriffen",
            _ => $"{use.Count}-mal gegriffen",
        };

    private static string DescribeStatus(SessionStatus status) => status switch
    {
        SessionStatus.InProgress => "läuft",
        SessionStatus.Completed => "abgeschlossen",
        SessionStatus.Abandoned => "abgebrochen",
        _ => status.ToString(),
    };
}
