@*
    The inspector panel of the run view (#104).

    It shows the same three things as the list view of the runner – answers including iteration,
    expression bindings and published triggers –, but at the selected element instead of globally. That is
    exactly the gain over the list: the question "what does the condition on this edge compute with?" is
    answered where it arises.

    Only an answer is edited here (EditAnswerAsync), never the graph: a running session works on this
    graph. The way into the configuration leads via the editor view.
*@
@using Flirty.Domain
@using Flirty.Runtime.Admin
@using Flirty.Designer.Services

<aside class="graph-inspector" aria-label="Details of the selected element of the test run">
    @if (SelectedNode is { } node)
    {
        var question = QuestionOf(node.QuestionId);
        var visit = Run.Visit(node.QuestionId);

        <h2>Question</h2>
        <p class="graph-inspector-key mono" id="runInspectorKey">@node.Key</p>
        <p class="graph-inspector-text">@node.FullText</p>

        <dl class="graph-facts">
            <dt>Type</dt>
            <dd>@node.TypeLabel</dd>
            <dt>In the run</dt>
            <dd>
                @(visit switch
                {
                    { IsCurrent: true } => "currently open",
                    { Answers.Count: > 0 } => $"answered {visit.Answers.Count} times",
                    _ => "not visited",
                })
            </dd>
        </dl>

        @if (visit is { Answers.Count: > 0 } && question is not null)
        {
            <h3 class="graph-inspector-section">Answers</h3>
            <ul class="graph-inspector-list run-answers">
                @foreach (var answer in visit.Answers)
                {
                    // Local copy: the lambdas would otherwise run against the loop state after the last
                    // iteration.
                    var entry = answer;

                    <li>
                        <div class="run-answer-head">
                            @if (entry.IterationIndex is { } iteration)
                            {
                                <span class="badge badge-loop">Iteration @(iteration + 1)</span>
                            }
                            <span class="run-answer-value">@entry.Display</span>
                            <span class="step-time">@entry.AnsweredAt.LocalDateTime.ToString("T")</span>
                        </div>

                        @* The raw value is what the conditions compute with – the display form above it
                           is the label. Showing both is the point: exactly this confusion made the chat UI
                           in #47 silently store wrong values. *@
                        <div class="mono run-answer-raw">@entry.Value</div>

                        @if (EditingSequence == entry.Sequence && EditInput is not null)
                        {
                            <AnswerInput Type="question.Type"
                                         Options="AnswerChoice.From(question.Options)"
                                         Input="EditInput"
                                         OnSubmit="SaveEdit"
                                         SubmitLabel="Save"
                                         Disabled="Busy" />
                            <div class="actions">
                                <button class="btn" disabled="@Busy" @onclick="() => CancelEdit.InvokeAsync()">
                                    Cancel
                                </button>
                            </div>
                            <span class="hint">
                                On saving, all downstream answers are discarded and the path from here is
                                recomputed.
                            </span>
                        }
                        else
                        {
                            <button class="btn" disabled="@Busy"
                                    @onclick="() => StartEdit.InvokeAsync(entry.Sequence)">Edit</button>
                        }
                    </li>
                }
            </ul>
        }

        <h3 class="graph-inspector-section">Bindings in the expression</h3>
        <dl class="graph-facts">
            <dt class="mono">@node.Key</dt>
            <dd class="mono">
                @(Snapshot is not null && Snapshot.Answers.TryGetValue(node.Key, out var bound)
                    ? bound
                    : "— not yet answered —")
            </dd>

            @foreach (var loop in Run.LoopsOf(node.QuestionId))
            {
                var entries = Snapshot?.Collections.GetValueOrDefault(loop.CollectionKey) ?? [];

                <dt class="mono">@loop.CollectionKey</dt>
                <dd class="mono">@(entries.Count == 0 ? "— empty —" : string.Join(", ", entries))</dd>
            }

            @if (visit is { IsCurrent: true })
            {
                @* Only at the open question: the value means the index of the LAST answer given to exactly
                   it (semantics of LoopResolver.ResolveIterationIndex). Shown at another node it would
                   claim something about that node – and would be wrong. *@
                <dt class="mono">iterationIndex</dt>
                <dd class="mono">@(Snapshot?.IterationIndex?.ToString() ?? "— outside a loop —")</dd>
            }
        </dl>

        @if (Run.TriggersOf(node.QuestionId) is { Count: > 0 } fired)
        {
            <h3 class="graph-inspector-section">Fired</h3>
            <ul class="graph-inspector-list run-events">
                @foreach (var trigger in fired)
                {
                    <li>
                        <span class="step-time">@trigger.OccurredAt.LocalDateTime.ToString("T")</span>
                        <strong>@trigger.Label</strong> @trigger.Detail
                    </li>
                }
            </ul>
        }

        <h3 class="graph-inspector-section">Outgoing transitions</h3>

        @if (Outgoing(node.QuestionId) is { Count: 0 })
        {
            <p class="hint">None – the dialog ends regularly here.</p>
        }
        else
        {
            <ol class="graph-inspector-list">
                @foreach (var edge in Outgoing(node.QuestionId))
                {
                    var current = edge;
                    var use = Run.Edge(current.TransitionId);

                    <li>
                        <button class="btn graph-edge-link @(use is null ? "" : "is-taken")"
                                @onclick="() => Select.InvokeAsync(new GraphSelection(GraphElementKind.Transition, current.TransitionId))">
                            → @TargetKey(current) <span class="graph-edge-link-condition">@current.Label</span>
                        </button>
                        <span class="hint">@Describe(use)</span>
                    </li>
                }
            </ol>
        }
    }
    else if (SelectedEdge is { } edge)
    {
        var use = Run.Edge(edge.TransitionId);

        <h2>Transition</h2>
        <p class="graph-inspector-key mono">@QuestionKey(edge.FromQuestionId) → @QuestionKey(edge.TargetQuestionId)</p>

        <dl class="graph-facts">
            <dt>Condition</dt>
            <dd class="mono">@edge.Label</dd>
            <dt>In the run</dt>
            <dd>@Describe(use)</dd>
        </dl>

        @if (use is { IsAmbiguous: true })
        {
            <div class="banner warn">
                There are several transitions between these two questions. Which of them was taken is not
                recorded by the engine – the path is derived from the answer sequence, and that only knows
                the question pair. All of them are therefore marked.
            </div>
        }

        <div class="actions">
            <button class="btn"
                    @onclick="() => Select.InvokeAsync(new GraphSelection(GraphElementKind.Question, edge.FromQuestionId))">
                To source question
            </button>
            <button class="btn"
                    @onclick="() => Select.InvokeAsync(new GraphSelection(GraphElementKind.Question, edge.TargetQuestionId))">
                To target question
            </button>
        </div>
    }
    else if (SelectedLoop is { } loop)
    {
        var state = Run.Loop(loop.LoopId);

        <h2>Loop</h2>
        <p class="graph-inspector-key mono">@loop.CollectionKey</p>

        <dl class="graph-facts">
            <dt>Entry</dt>
            <dd class="mono">@(string.IsNullOrEmpty(loop.EntryKey) ? "— missing —" : loop.EntryKey)</dd>
            <dt>Breaking question</dt>
            <dd class="mono">@(string.IsNullOrEmpty(loop.BreakingKey) ? "— missing —" : loop.BreakingKey)</dd>
            <dt>In the run</dt>
            <dd>
                @(state switch
                {
                    { Iterations: 0 } or null => "not entered",
                    { IsActive: true } => $"{state.Iterations} iteration(s), currently running",
                    _ => $"{state.Iterations} iteration(s), left",
                })
            </dd>
            <dt class="mono">@loop.CollectionKey</dt>
            <dd class="mono">
                @{
                    var entries = Snapshot?.Collections.GetValueOrDefault(loop.CollectionKey) ?? [];
                }
                @(entries.Count == 0 ? "— empty —" : string.Join(", ", entries))
            </dd>
        </dl>
    }
    else
    {
        <h2>Test run</h2>

        <dl class="graph-facts">
            <dt>Status</dt>
            <dd>@DescribeStatus(Run.Status)</dd>
            <dt>Steps</dt>
            <dd>@Run.Steps</dd>
        </dl>

        <p class="hint">
            Select a node – its answers, its bindings and the triggers fired there then stand here.
        </p>

        @if (Run.DialogTriggers is { Count: > 0 } events)
        {
            <h3 class="graph-inspector-section">Fired (without a question reference)</h3>
            <ul class="graph-inspector-list run-events">
                @foreach (var trigger in events)
                {
                    <li>
                        <span class="step-time">@trigger.OccurredAt.LocalDateTime.ToString("T")</span>
                        <strong>@trigger.Label</strong> @trigger.Detail
                    </li>
                }
            </ul>
        }

        <h3 class="graph-inspector-section">Legend</h3>
        <ul class="graph-legend">
            <li><span class="badge badge-current">▶ open</span> the question the run is currently asking</li>
            <li><span class="badge badge-visited">visited</span> answered – the card shows the value</li>
            <li><span class="chip chip-fired">⚡</span> trigger published during the run</li>
            <li><span class="legend-line is-taken"></span> taken transition (thick and solid)</li>
        </ul>
    }
</aside>

@code {
    /// <summary>The whole graph – neighbourhood and labels of the selected element.</summary>
    [Parameter, EditorRequired]
    public required DialogGraphModel Model { get; set; }

    /// <summary>The dialog including graph – source for question type and answer options when editing.</summary>
    [Parameter, EditorRequired]
    public required DialogDetail Detail { get; set; }

    /// <summary>The run state.</summary>
    [Parameter, EditorRequired]
    public required GraphRunOverlay Run { get; set; }

    /// <summary>The expression bindings of the run; <see langword="null"/> as long as none is running.</summary>
    [Parameter]
    public RunExpressionSnapshot? Snapshot { get; set; }

    /// <summary>The selected element or <see langword="null"/>.</summary>
    [Parameter]
    public GraphSelection? Selection { get; set; }

    /// <summary>Whether an engine step is currently running.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>The <c>Sequence</c> of the answer currently being edited or <see langword="null"/>.</summary>
    [Parameter]
    public int? EditingSequence { get; set; }

    /// <summary>The input state of the answer currently being edited.</summary>
    [Parameter]
    public AnswerInputModel? EditInput { get; set; }

    /// <summary>Reports the new selection.</summary>
    [Parameter]
    public EventCallback<GraphSelection> Select { get; set; }

    /// <summary>Reports the wish to edit the answer with this <c>Sequence</c>.</summary>
    [Parameter]
    public EventCallback<int> StartEdit { get; set; }

    /// <summary>Reports that the edited answer should be saved.</summary>
    [Parameter]
    public EventCallback SaveEdit { get; set; }

    /// <summary>Reports the cancellation of the editing.</summary>
    [Parameter]
    public EventCallback CancelEdit { get; set; }

    private GraphNode? SelectedNode
        => Selection is { Kind: GraphElementKind.Question } selection ? Model.Node(selection.Id) : null;

    private GraphEdge? SelectedEdge
        => Selection is { Kind: GraphElementKind.Transition } selection ? Model.Edge(selection.Id) : null;

    private GraphLoopFrame? SelectedLoop
        => Selection is { Kind: GraphElementKind.Loop } selection
            ? Model.Loops.FirstOrDefault(loop => loop.LoopId == selection.Id)
            : null;

    private QuestionDetail? QuestionOf(Guid questionId)
        => Detail.Questions.FirstOrDefault(question => question.Id == questionId);

    private string QuestionKey(Guid questionId) => QuestionOf(questionId)?.Key ?? "unknown";

    private string TargetKey(GraphEdge edge) => QuestionKey(edge.TargetQuestionId);

    private IReadOnlyList<GraphEdge> Outgoing(Guid questionId)
        => [.. Model.Edges.Where(edge => edge.FromQuestionId == questionId).OrderBy(edge => edge.Position)];

    /// <summary>Describes whether and how often an edge was taken.</summary>
    private static string Describe(GraphRunEdgeUse? use)
        => use switch
        {
            null => "not taken",
            { IsAmbiguous: true } => $"traversed {use.Count} times (ambiguous)",
            { Count: 1 } => "taken",
            _ => $"taken {use.Count} times",
        };

    private static string DescribeStatus(SessionStatus status) => status switch
    {
        SessionStatus.InProgress => "running",
        SessionStatus.Completed => "completed",
        SessionStatus.Abandoned => "abandoned",
        _ => status.ToString(),
    };
}
