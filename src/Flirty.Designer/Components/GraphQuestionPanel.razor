@*
    The question branch of the graph inspector (#103): the read view from #101 becomes an editor.

    The boundary to the full editor is a rule, not a whim: the SCALAR fields that a gesture created and
    left provisionally stand here. Everything with its own substructure or its own raw-JSON fallback –
    answer options and validation rules – stays in the QuestionEditor, which has a whole form for that.
    "Edit question →" leads there.

    The QuestionFormModel stays private state: it is internal, and an internal type on a [Parameter] would
    be CS0053. Outward goes QuestionEdit (see Models/GraphEdits.cs).
*@
@using Flirty.Domain
@using Flirty.Runtime.Admin
@using Flirty.Validation
@inject FlirtyQuestionTypeRegistry QuestionTypes

<h2>Question</h2>
<p class="graph-inspector-key mono">@Node.Key</p>

@foreach (var warning in Node.Warnings)
{
    <div class="banner warn">@warning.Text</div>
}

@* Deliberately NO EditForm with InputText/InputSelect, but raw fields with @bind:event="oninput".

   Two reasons, both measured on the running panel: the panel is rebuilt after EVERY gesture (the reload
   replaces `Detail`), and the default `onchange` delivers an input only when the field is left – it was
   lost in the process, and on saving the old value silently stood in the command. In addition an EditForm
   assumes a stable form lifecycle that does not exist here; its submit did not arrive in the panel. The
   same decision as with the raw <textarea> of the expression editor (§ Conventions in docs/DESIGNER.md).

   The required check is thus handled by SaveAsync – like the cross-field rules of the trigger form, which
   also run before the command. *@
<div class="field">
    <label for="inspectorKey">Key</label>
    <input id="inspectorKey" class="input mono" disabled="@Locked"
           value="@_form.Key" @oninput="OnKeyInput" />
</div>

<div class="field">
    <label for="inspectorText">Question text</label>
    <textarea id="inspectorText" class="input" rows="2" disabled="@Locked"
              value="@_form.Text" @oninput="OnTextInput"></textarea>
</div>

<div class="field">
    <label for="inspectorType">Answer type</label>
    @{ var typeChoice = QuestionTypeLabels.ChoiceValue(_form.Type, _form.CustomTypeKey, QuestionTypes); }
    <select id="inspectorType" class="input" disabled="@Locked"
            value="@typeChoice" @onchange="OnTypeChanged">
        @foreach (var choice in QuestionTypeLabels.Choices(QuestionTypes))
        {
            <option value="@choice.Value" selected="@(choice.Value == typeChoice)">@choice.Label</option>
        }
    </select>
    @if (QuestionTypeLabels.UsesOptions(_form.Type) && Node.OptionCount == 0)
    {
        <span class="hint">
            This type evaluates answer options – none are created yet. The question editor maintains them.
        </span>
    }
</div>

@* A scalar field, so it belongs in this panel by its own rule (only substructure stays in the full
   editor). @oninput rather than @bind: the panel is rebuilt after every gesture, and onchange would
   lose a value that was never left. *@
@if (_form.Type == QuestionType.Json)
{
    <div class="field">
        <label for="inspectorCustomTypeKey">Custom type key</label>
        <input id="inspectorCustomTypeKey" class="input mono" disabled="@Locked"
               value="@_form.CustomTypeKey" @oninput="OnCustomTypeKeyInput" />
        <span class="hint">
            Optional, the key the host declared the type under. Not checked here – the designer has no
            registry, and an unknown key degrades to the plain JSON check.
        </span>
    </div>
}

<div class="field check">
    <input id="inspectorRequired" type="checkbox" disabled="@Locked"
           checked="@_form.IsRequired" @onchange="OnRequiredChanged" />
    <label for="inspectorRequired">Answer required</label>
</div>

@if (_formError is not null)
{
    <div class="banner err">@_formError</div>
}

<div class="actions">
    <button class="btn btn-primary" disabled="@Locked" @onclick="SaveAsync">Save</button>
    <button class="btn" disabled="@Locked" @onclick="ResetForm">Reset</button>
</div>

<dl class="graph-facts">
    <dt>Role</dt>
    <dd>@Role</dd>
    @if (Node.UsesOptions)
    {
        <dt>Answer options</dt>
        <dd>@Node.OptionCount</dd>
    }
</dl>

@* The entry point belongs on the surface: without this button the whole graph could be built on the
   canvas but not started – the author would have to leave it for a single field, and that is exactly what
   the graph warns about ("No entry question set", DialogGraphBuilder). It is set via UpdateDialogCommand,
   whose guard fits exactly: on a published version this very field is locked (name/description stay free)
   – so the button carries the usual `Locked` and does not run into a 409.

   If the node is already the entry, the button is omitted: the role above says so already, and a disabled
   button without an alternative would be an empty form. *@
@if (!Node.IsStart)
{
    <div class="actions">
        <button class="btn" disabled="@Locked"
                @onclick="() => SetStart.InvokeAsync(Node.QuestionId)">
            Set as entry question
        </button>
    </div>
}

<h3 class="graph-inspector-section">Outgoing transitions</h3>

@if (Outgoing.Count == 0)
{
    <p class="hint">None – the dialog ends after this question.</p>
}
else
{
    @* The order of this list IS the evaluation order (Priority, smaller = earlier). It is maintained here
       and not via the position of the edges on the surface: a position must not carry semantics, otherwise
       tidying up changes the behaviour. *@
    <ol class="graph-inspector-list">
        @foreach (var (edge, index) in Outgoing.Select((edge, index) => (edge, index)))
        {
            var current = edge;
            var position = index;
            <li>
                <button class="btn graph-edge-link" title="@current.AriaLabel"
                        @onclick="() => SelectTransition.InvokeAsync(current.TransitionId)">
                    <span class="mono">@KeyOf(current.TargetQuestionId)</span>
                    <span class="graph-edge-link-condition">@current.Label</span>
                </button>
                <span class="row-actions">
                    <button class="btn" disabled="@(Locked || position == 0)"
                            title="Evaluate earlier"
                            @onclick="() => Move.InvokeAsync(new TransitionMove(Node.QuestionId, position, position - 1))">↑</button>
                    <button class="btn" disabled="@(Locked || position == Outgoing.Count - 1)"
                            title="Evaluate later"
                            @onclick="() => Move.InvokeAsync(new TransitionMove(Node.QuestionId, position, position + 1))">↓</button>
                    <button class="btn @(current.IsDefault ? "btn-primary" : "")" disabled="@Locked"
                            title="@(current.IsDefault
                                ? "Remove default marking"
                                : "Mark as default – matches when no condition applies")"
                            @onclick="() => ToggleDefault.InvokeAsync(current.TransitionId)">Default</button>
                </span>
            </li>
        }
    </ol>
}

@if (!Locked)
{
    <div class="field">
        <label for="inspectorConnect">Transition to</label>
        <select id="inspectorConnect" class="input" @bind="_connectTarget">
            <option value="">— choose target question —</option>
            @foreach (var candidate in Detail.Questions)
            {
                <option value="@candidate.Id">@candidate.Key — @candidate.Text</option>
            }
        </select>
        <span class="hint">
            The pointerless way to connect – equivalent to dragging on the node's
            <span class="mono">＋</span>.
        </span>
    </div>
    <div class="actions">
        <button class="btn" disabled="@(Locked || _connectTarget is null)"
                @onclick="ConnectAsync">Connect</button>
    </div>
}

@if (Incoming.Count > 0)
{
    <h3 class="graph-inspector-section">Incoming transitions</h3>
    <ul class="graph-inspector-list">
        @foreach (var edge in Incoming)
        {
            var current = edge;
            <li>
                <button class="btn graph-edge-link" title="@current.AriaLabel"
                        @onclick="() => SelectTransition.InvokeAsync(current.TransitionId)">
                    <span class="mono">@KeyOf(current.FromQuestionId)</span>
                    <span class="graph-edge-link-condition">@current.Label</span>
                </button>
            </li>
        }
    </ul>
}

<h3 class="graph-inspector-section">Triggers</h3>

@if (Node.Triggers.Count == 0)
{
    <p class="hint">None – nothing is fired after this question.</p>
}
else
{
    <ul class="graph-inspector-list">
        @foreach (var trigger in Node.Triggers)
        {
            var current = trigger;
            <li>
                <button class="btn" @onclick="() => OpenTrigger.InvokeAsync(current.TriggerId)">
                    @current.Label
                </button>
            </li>
        }
    </ul>
}

@if (!Locked)
{
    @if (_newTrigger is null)
    {
        <div class="actions">
            <button class="btn" @onclick="StartCreateTrigger">Create trigger after this question</button>
        </div>
    }
    else
    {
        <div class="field">
            <label for="inspectorTriggerKind">Channel</label>
            <select id="inspectorTriggerKind" class="input" @bind="_newTrigger.Kind">
                @foreach (var kind in Enum.GetValues<TriggerKind>())
                {
                    <option value="@kind">@TriggerLabels.Describe(kind)</option>
                }
            </select>
        </div>

        @if (_newTrigger.Kind == TriggerKind.Webhook)
        {
            <div class="field">
                <label for="inspectorTriggerUrl">Target URL</label>
                <input id="inspectorTriggerUrl" class="input mono" @bind="_newTrigger.Url" />
                <span class="hint">Absolute URL – the engine rejects anything else.</span>
            </div>
        }
        else
        {
            <p class="hint">
                In-process delivers <b>nothing</b>: the host application plugs in its own
                <span class="mono">INotificationHandler</span> for that.
            </p>
        }

        <div class="field">
            <label for="inspectorTriggerName">Event name (optional)</label>
            <input id="inspectorTriggerName" class="input" @bind="_newTrigger.Name" />
        </div>

        @if (_triggerError is not null)
        {
            <div class="banner err">@_triggerError</div>
        }

        <div class="actions">
            <button class="btn btn-primary" @onclick="CreateTriggerAsync">Create</button>
            <button class="btn" @onclick="() => { _newTrigger = null; _triggerError = null; }">Cancel</button>
        </div>
    }
}

<div class="actions">
    <button class="btn btn-primary" @onclick="() => OpenQuestion.InvokeAsync(Node.QuestionId)">
        Edit question →
    </button>
</div>

@if (!Locked)
{
    <h3 class="graph-inspector-section">Delete question</h3>

    @if (_confirmDelete)
    {
        @* The confirmation text names the co-cleanup BEFORE; the success message counts it afterwards.
           Inline and not via JS confirm – that blocked the Playwright suite. *@
        <span class="confirm">Delete question along with options, transitions, loop markers and triggers?</span>
        <div class="actions">
            <button class="btn btn-danger" @onclick="DeleteAsync">Yes, delete</button>
            <button class="btn" @onclick="() => _confirmDelete = false">Cancel</button>
        </div>
    }
    else
    {
        <div class="actions">
            <button class="btn btn-danger" @onclick="() => _confirmDelete = true">Delete</button>
        </div>
    }
}

@code {
    /// <summary>The dialog including graph – source of the target-question selection.</summary>
    [Parameter, EditorRequired]
    public required DialogDetail Detail { get; set; }

    /// <summary>The selected node.</summary>
    [Parameter, EditorRequired]
    public required GraphNode Node { get; set; }

    /// <summary>The outgoing edges in evaluation order.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<GraphEdge> Outgoing { get; set; }

    /// <summary>The incoming edges.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<GraphEdge> Incoming { get; set; }

    /// <summary>Whether the graph is editable (unpublished version).</summary>
    [Parameter]
    public bool Editable { get; set; }

    /// <summary>Whether a gesture is currently running.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Reports changed header fields.</summary>
    [Parameter]
    public EventCallback<QuestionEdit> Save { get; set; }

    /// <summary>Reports the wish to make this question the entry question of the dialog.</summary>
    [Parameter]
    public EventCallback<Guid> SetStart { get; set; }

    /// <summary>Reports a reordering of the outgoing transitions.</summary>
    [Parameter]
    public EventCallback<TransitionMove> Move { get; set; }

    /// <summary>Reports the toggling of the default marking of an edge.</summary>
    [Parameter]
    public EventCallback<Guid> ToggleDefault { get; set; }

    /// <summary>Reports a new transition to the selected target question.</summary>
    [Parameter]
    public EventCallback<Guid> Connect { get; set; }

    /// <summary>Reports a new trigger after this question.</summary>
    [Parameter]
    public EventCallback<TriggerDraft> AddTrigger { get; set; }

    /// <summary>Reports the confirmed deletion wish.</summary>
    [Parameter]
    public EventCallback<Guid> Delete { get; set; }

    /// <summary>Selects an edge on the canvas.</summary>
    [Parameter]
    public EventCallback<Guid> SelectTransition { get; set; }

    /// <summary>Jumps into the question editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenQuestion { get; set; }

    /// <summary>Jumps into the trigger editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenTrigger { get; set; }

    private QuestionFormModel _form = new();
    private TriggerFormModel? _newTrigger;
    private string? _triggerError;
    private string? _formError;
    private Guid? _connectTarget;
    private bool _confirmDelete;
    private Guid _shownFor;

    private bool Locked => !Editable || Busy;

    private string Role
    {
        get
        {
            var roles = new List<string>(4);

            if (Node.IsStart)
            {
                roles.Add("Entry question");
            }

            if (Node.IsTerminal)
            {
                roles.Add("Terminal (no outgoing transition)");
            }

            if (Node.IsLoopEntry)
            {
                roles.Add("Loop entry");
            }

            if (Node.IsLoopBreaking)
            {
                roles.Add("Breaking question");
            }

            if (Node.IsUnreachable)
            {
                roles.Add("not reachable");
            }

            return roles.Count == 0 ? "Question in the flow" : string.Join(", ", roles);
        }
    }

    protected override void OnParametersSet()
    {
        // On a change of the selected node, refill the form – otherwise a started input would wander to
        // the next question. Within the same selection the draft stays, so a re-render (e.g. after a
        // reordering) does not discard it.
        if (_shownFor != Node.QuestionId)
        {
            _shownFor = Node.QuestionId;
            _newTrigger = null;
            _triggerError = null;
            _connectTarget = null;
            _confirmDelete = false;
            ResetForm();
        }
    }

    private void ResetForm()
    {
        var question = Detail.Questions.FirstOrDefault(candidate => candidate.Id == Node.QuestionId);
        _form = question is null ? new QuestionFormModel() : QuestionFormModel.From(question);
        _formError = null;
    }

    private void OnKeyInput(ChangeEventArgs args) => _form.Key = args.Value?.ToString() ?? string.Empty;

    private void OnTextInput(ChangeEventArgs args) => _form.Text = args.Value?.ToString() ?? string.Empty;

    private void OnTypeChanged(ChangeEventArgs args)
    {
        // A host-declared type (#137) is not an enum member, so the pick carries the key with it. A
        // built-in one clears the key, so the field does not keep displaying a value that
        // NormalizedCustomTypeKey is about to drop anyway.
        if (QuestionTypeLabels.TryResolveChoice(args.Value?.ToString(), out var type, out var key))
        {
            _form.Type = type;
            _form.CustomTypeKey = key;
        }
    }

    private void OnCustomTypeKeyInput(ChangeEventArgs args)
        => _form.CustomTypeKey = args.Value?.ToString();

    private void OnRequiredChanged(ChangeEventArgs args) => _form.IsRequired = args.Value is true;

    /// <summary>
    /// Checks the required fields and reports the change. The check sits here because the panel works
    /// without an <c>EditForm</c> (rationale in the markup) – the command checks it again anyway.
    /// </summary>
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Key) || string.IsNullOrWhiteSpace(_form.Text))
        {
            _formError = "Key and question text are required.";
            return;
        }

        _formError = null;
        await Save.InvokeAsync(new QuestionEdit(
            Node.QuestionId, _form.Key.Trim(), _form.Text.Trim(), _form.Type, _form.IsRequired,
            _form.NormalizedCustomTypeKey()));
    }

    private async Task ConnectAsync()
    {
        if (_connectTarget is not { } target)
        {
            return;
        }

        _connectTarget = null;
        await Connect.InvokeAsync(target);
    }

    private void StartCreateTrigger()
        => _newTrigger = new TriggerFormModel
        {
            Scope = TriggerScope.AfterQuestion,
            QuestionId = Node.QuestionId,
        };

    /// <summary>
    /// Creates the trigger – after the cross-field rules from #42 were checked <b>here</b>. The command
    /// checks them too (<c>IValidatableObject</c> → 400); that the message already appears in the panel
    /// spares the author the detour via an engine error message.
    /// </summary>
    private async Task CreateTriggerAsync()
    {
        if (_newTrigger is null)
        {
            return;
        }

        if (!_newTrigger.TryBuildConfig(out var config, out var configError))
        {
            _triggerError = configError;
            return;
        }

        var draft = new TriggerDraft(
            TriggerScope.AfterQuestion, Node.QuestionId, _newTrigger.Kind, config);

        _newTrigger = null;
        _triggerError = null;
        await AddTrigger.InvokeAsync(draft);
    }

    private async Task DeleteAsync()
    {
        _confirmDelete = false;
        await Delete.InvokeAsync(Node.QuestionId);
    }

    private string KeyOf(Guid questionId)
        => Detail.Questions.FirstOrDefault(question => question.Id == questionId)?.Key ?? "unknown";
}
