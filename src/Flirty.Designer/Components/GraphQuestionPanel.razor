@*
    Der Frage-Zweig des Graph-Inspectors (#103): aus der Lesesicht von #101 wird ein Editor.

    Die Grenze zum Vollteditor ist eine Regel, keine Laune: Hier stehen die SKALAREN Felder, die eine
    Geste angelegt und vorläufig gelassen hat. Alles mit eigener Unterstruktur oder eigenem
    Roh-JSON-Fallback – Antwortoptionen und Validierungsregeln – bleibt im QuestionEditor, der dafür ein
    ganzes Formular hat. „Frage bearbeiten →" führt dorthin.

    Das QuestionFormModel bleibt privater Zustand: Es ist internal, und ein internal Typ an einem
    [Parameter] wäre CS0053. Nach außen geht QuestionEdit (siehe Models/GraphEdits.cs).
*@
@using Flirty.Domain
@using Flirty.Runtime.Admin

<h2>Frage</h2>
<p class="graph-inspector-key mono">@Node.Key</p>

@foreach (var warning in Node.Warnings)
{
    <div class="banner warn">@warning.Text</div>
}

@* Bewusst KEINE EditForm mit InputText/InputSelect, sondern rohe Felder mit @bind:event="oninput".

   Zwei Gründe, beide am laufenden Panel gemessen: Das Panel wird nach JEDER Geste neu aufgebaut (der
   Reload ersetzt `Detail`), und das voreingestellte `onchange` liefert eine Eingabe erst beim Verlassen
   des Felds – sie ging dabei verloren, und beim Speichern stand stillschweigend der alte Wert im
   Command. Zudem setzt eine EditForm einen stabilen Formular-Lebenszyklus voraus, den es hier nicht
   gibt; ihr Submit kam im Panel nicht an. Dieselbe Entscheidung wie beim rohen <textarea> des
   Ausdrucks-Editors (§ Konventionen in docs/DESIGNER.md).

   Die Pflichtprüfung übernimmt damit SaveAsync – wie die Querfeld-Regeln des Trigger-Formulars, die
   ebenfalls vor dem Command laufen. *@
<div class="field">
    <label for="inspectorKey">Schlüssel</label>
    <input id="inspectorKey" class="input mono" disabled="@Locked"
           value="@_form.Key" @oninput="OnKeyInput" />
</div>

<div class="field">
    <label for="inspectorText">Fragetext</label>
    <textarea id="inspectorText" class="input" rows="2" disabled="@Locked"
              value="@_form.Text" @oninput="OnTextInput"></textarea>
</div>

<div class="field">
    <label for="inspectorType">Antworttyp</label>
    <select id="inspectorType" class="input" disabled="@Locked"
            value="@_form.Type" @onchange="OnTypeChanged">
        @foreach (var type in Enum.GetValues<QuestionType>())
        {
            <option value="@type" selected="@(type == _form.Type)">@QuestionTypeLabels.Describe(type)</option>
        }
    </select>
    @if (QuestionTypeLabels.UsesOptions(_form.Type) && Node.OptionCount == 0)
    {
        <span class="hint">
            Dieser Typ wertet Antwortoptionen aus – es sind noch keine angelegt. Die pflegt der
            Frage-Editor.
        </span>
    }
</div>

<div class="field check">
    <input id="inspectorRequired" type="checkbox" disabled="@Locked"
           checked="@_form.IsRequired" @onchange="OnRequiredChanged" />
    <label for="inspectorRequired">Antwort erforderlich</label>
</div>

@if (_formError is not null)
{
    <div class="banner err">@_formError</div>
}

<div class="actions">
    <button class="btn btn-primary" disabled="@Locked" @onclick="SaveAsync">Speichern</button>
    <button class="btn" disabled="@Locked" @onclick="ResetForm">Zurücksetzen</button>
</div>

<dl class="graph-facts">
    <dt>Rolle</dt>
    <dd>@Role</dd>
    @if (Node.UsesOptions)
    {
        <dt>Antwortoptionen</dt>
        <dd>@Node.OptionCount</dd>
    }
</dl>

@* Der Einstiegspunkt gehört auf die Fläche: Ohne diesen Knopf ließe sich der ganze Graph auf dem
   Canvas bauen, aber nicht starten – der Autor müsste ihn für ein einzelnes Feld verlassen, und genau
   darüber warnt der Graph („Keine Einstiegsfrage gesetzt", DialogGraphBuilder). Gesetzt wird er über
   UpdateDialogCommand, dessen Guard exakt passt: An einer veröffentlichten Version ist genau DIESES
   Feld gesperrt (Name/Beschreibung bleiben frei) – deshalb trägt der Knopf das übliche `Locked` und
   läuft nicht in einen 409.

   Ist der Knoten schon Einstieg, entfällt der Knopf: Die Rolle darüber sagt es bereits, und ein
   deaktivierter Knopf ohne Alternative wäre eine Leerform. *@
@if (!Node.IsStart)
{
    <div class="actions">
        <button class="btn" disabled="@Locked"
                @onclick="() => SetStart.InvokeAsync(Node.QuestionId)">
            Als Einstiegsfrage setzen
        </button>
    </div>
}

<h3 class="graph-inspector-section">Ausgehende Übergänge</h3>

@if (Outgoing.Count == 0)
{
    <p class="hint">Keine – der Dialog endet nach dieser Frage.</p>
}
else
{
    @* Die Reihenfolge dieser Liste IST die Auswertungsreihenfolge (Priority, kleiner = früher). Sie
       wird hier gepflegt und nicht über die Lage der Kanten auf der Fläche: Eine Position darf keine
       Semantik tragen, sonst ändert Aufräumen das Verhalten. *@
    <ol class="graph-inspector-list">
        @foreach (var (edge, index) in Outgoing.Select((edge, index) => (edge, index)))
        {
            var current = edge;
            var position = index;
            <li>
                <button class="btn graph-edge-link" title="@current.AriaLabel"
                        @onclick="() => SelectTransition.InvokeAsync(current.TransitionId)">
                    <span class="mono">@KeyOf(current.TargetQuestionId)</span>
                    <span class="graph-edge-link-condition">@current.Label</span>
                </button>
                <span class="row-actions">
                    <button class="btn" disabled="@(Locked || position == 0)"
                            title="Früher auswerten"
                            @onclick="() => Move.InvokeAsync(new TransitionMove(Node.QuestionId, position, position - 1))">↑</button>
                    <button class="btn" disabled="@(Locked || position == Outgoing.Count - 1)"
                            title="Später auswerten"
                            @onclick="() => Move.InvokeAsync(new TransitionMove(Node.QuestionId, position, position + 1))">↓</button>
                    <button class="btn @(current.IsDefault ? "btn-primary" : "")" disabled="@Locked"
                            title="@(current.IsDefault
                                ? "Default-Kennzeichnung entfernen"
                                : "Als Default markieren – greift, wenn keine Bedingung zutrifft")"
                            @onclick="() => ToggleDefault.InvokeAsync(current.TransitionId)">Default</button>
                </span>
            </li>
        }
    </ol>
}

@if (!Locked)
{
    <div class="field">
        <label for="inspectorConnect">Übergang zu</label>
        <select id="inspectorConnect" class="input" @bind="_connectTarget">
            <option value="">— Zielfrage wählen —</option>
            @foreach (var candidate in Detail.Questions)
            {
                <option value="@candidate.Id">@candidate.Key — @candidate.Text</option>
            }
        </select>
        <span class="hint">
            Der zeigerlose Weg zu verbinden – gleichwertig zum Ziehen am <span class="mono">＋</span>
            des Knotens.
        </span>
    </div>
    <div class="actions">
        <button class="btn" disabled="@(Locked || _connectTarget is null)"
                @onclick="ConnectAsync">Verbinden</button>
    </div>
}

@if (Incoming.Count > 0)
{
    <h3 class="graph-inspector-section">Eingehende Übergänge</h3>
    <ul class="graph-inspector-list">
        @foreach (var edge in Incoming)
        {
            var current = edge;
            <li>
                <button class="btn graph-edge-link" title="@current.AriaLabel"
                        @onclick="() => SelectTransition.InvokeAsync(current.TransitionId)">
                    <span class="mono">@KeyOf(current.FromQuestionId)</span>
                    <span class="graph-edge-link-condition">@current.Label</span>
                </button>
            </li>
        }
    </ul>
}

<h3 class="graph-inspector-section">Trigger</h3>

@if (Node.Triggers.Count == 0)
{
    <p class="hint">Keine – nach dieser Frage wird nichts ausgelöst.</p>
}
else
{
    <ul class="graph-inspector-list">
        @foreach (var trigger in Node.Triggers)
        {
            var current = trigger;
            <li>
                <button class="btn" @onclick="() => OpenTrigger.InvokeAsync(current.TriggerId)">
                    @current.Label
                </button>
            </li>
        }
    </ul>
}

@if (!Locked)
{
    @if (_newTrigger is null)
    {
        <div class="actions">
            <button class="btn" @onclick="StartCreateTrigger">Trigger nach dieser Frage anlegen</button>
        </div>
    }
    else
    {
        <div class="field">
            <label for="inspectorTriggerKind">Kanal</label>
            <select id="inspectorTriggerKind" class="input" @bind="_newTrigger.Kind">
                @foreach (var kind in Enum.GetValues<TriggerKind>())
                {
                    <option value="@kind">@TriggerLabels.Describe(kind)</option>
                }
            </select>
        </div>

        @if (_newTrigger.Kind == TriggerKind.Webhook)
        {
            <div class="field">
                <label for="inspectorTriggerUrl">Ziel-URL</label>
                <input id="inspectorTriggerUrl" class="input mono" @bind="_newTrigger.Url" />
                <span class="hint">Absolute URL – die Engine lehnt alles andere ab.</span>
            </div>
        }
        else
        {
            <p class="hint">
                In-Process stellt <b>nichts</b> zu: Die Host-Anwendung hängt dafür einen eigenen
                <span class="mono">INotificationHandler</span> ein.
            </p>
        }

        <div class="field">
            <label for="inspectorTriggerName">Ereignisname (optional)</label>
            <input id="inspectorTriggerName" class="input" @bind="_newTrigger.Name" />
        </div>

        @if (_triggerError is not null)
        {
            <div class="banner err">@_triggerError</div>
        }

        <div class="actions">
            <button class="btn btn-primary" @onclick="CreateTriggerAsync">Anlegen</button>
            <button class="btn" @onclick="() => { _newTrigger = null; _triggerError = null; }">Abbrechen</button>
        </div>
    }
}

<div class="actions">
    <button class="btn btn-primary" @onclick="() => OpenQuestion.InvokeAsync(Node.QuestionId)">
        Frage bearbeiten →
    </button>
</div>

@if (!Locked)
{
    <h3 class="graph-inspector-section">Frage löschen</h3>

    @if (_confirmDelete)
    {
        @* Der Bestätigungstext benennt die Mit-Aufräumung VORHER; die Erfolgsmeldung zählt sie
           nachher. Inline und nicht per JS-confirm – das blockierte die Playwright-Suite. *@
        <span class="confirm">Frage samt Optionen, Übergängen, Schleifen-Markern und Triggern löschen?</span>
        <div class="actions">
            <button class="btn btn-danger" @onclick="DeleteAsync">Ja, löschen</button>
            <button class="btn" @onclick="() => _confirmDelete = false">Abbrechen</button>
        </div>
    }
    else
    {
        <div class="actions">
            <button class="btn btn-danger" @onclick="() => _confirmDelete = true">Löschen</button>
        </div>
    }
}

@code {
    /// <summary>Der Dialog samt Graph – Quelle der Zielfragen-Auswahl.</summary>
    [Parameter, EditorRequired]
    public required DialogDetail Detail { get; set; }

    /// <summary>Der gewählte Knoten.</summary>
    [Parameter, EditorRequired]
    public required GraphNode Node { get; set; }

    /// <summary>Die ausgehenden Kanten in Auswertungsreihenfolge.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<GraphEdge> Outgoing { get; set; }

    /// <summary>Die eingehenden Kanten.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<GraphEdge> Incoming { get; set; }

    /// <summary>Ob der Graph bearbeitbar ist (unveröffentlichte Version).</summary>
    [Parameter]
    public bool Editable { get; set; }

    /// <summary>Ob gerade eine Geste läuft.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Meldet geänderte Kopffelder.</summary>
    [Parameter]
    public EventCallback<QuestionEdit> Save { get; set; }

    /// <summary>Meldet den Wunsch, diese Frage zur Einstiegsfrage des Dialogs zu machen.</summary>
    [Parameter]
    public EventCallback<Guid> SetStart { get; set; }

    /// <summary>Meldet eine Umsortierung der ausgehenden Übergänge.</summary>
    [Parameter]
    public EventCallback<TransitionMove> Move { get; set; }

    /// <summary>Meldet das Umschalten der Default-Kennzeichnung einer Kante.</summary>
    [Parameter]
    public EventCallback<Guid> ToggleDefault { get; set; }

    /// <summary>Meldet einen neuen Übergang zur gewählten Zielfrage.</summary>
    [Parameter]
    public EventCallback<Guid> Connect { get; set; }

    /// <summary>Meldet einen neuen Trigger nach dieser Frage.</summary>
    [Parameter]
    public EventCallback<TriggerDraft> AddTrigger { get; set; }

    /// <summary>Meldet den bestätigten Löschwunsch.</summary>
    [Parameter]
    public EventCallback<Guid> Delete { get; set; }

    /// <summary>Wählt eine Kante auf dem Canvas aus.</summary>
    [Parameter]
    public EventCallback<Guid> SelectTransition { get; set; }

    /// <summary>Springt in den Frage-Editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenQuestion { get; set; }

    /// <summary>Springt in den Trigger-Editor.</summary>
    [Parameter]
    public EventCallback<Guid> OpenTrigger { get; set; }

    private QuestionFormModel _form = new();
    private TriggerFormModel? _newTrigger;
    private string? _triggerError;
    private string? _formError;
    private Guid? _connectTarget;
    private bool _confirmDelete;
    private Guid _shownFor;

    private bool Locked => !Editable || Busy;

    private string Role
    {
        get
        {
            var roles = new List<string>(4);

            if (Node.IsStart)
            {
                roles.Add("Einstiegsfrage");
            }

            if (Node.IsTerminal)
            {
                roles.Add("Abschluss (kein ausgehender Übergang)");
            }

            if (Node.IsLoopEntry)
            {
                roles.Add("Schleifen-Einstieg");
            }

            if (Node.IsLoopBreaking)
            {
                roles.Add("Breaking Question");
            }

            if (Node.IsUnreachable)
            {
                roles.Add("nicht erreichbar");
            }

            return roles.Count == 0 ? "Frage im Ablauf" : string.Join(", ", roles);
        }
    }

    protected override void OnParametersSet()
    {
        // Beim Wechsel des gewählten Knotens das Formular neu befüllen – sonst wanderte eine begonnene
        // Eingabe zur nächsten Frage. Innerhalb derselben Auswahl bleibt der Entwurf stehen, damit ein
        // Re-Render (etwa nach einer Umsortierung) ihn nicht verwirft.
        if (_shownFor != Node.QuestionId)
        {
            _shownFor = Node.QuestionId;
            _newTrigger = null;
            _triggerError = null;
            _connectTarget = null;
            _confirmDelete = false;
            ResetForm();
        }
    }

    private void ResetForm()
    {
        var question = Detail.Questions.FirstOrDefault(candidate => candidate.Id == Node.QuestionId);
        _form = question is null ? new QuestionFormModel() : QuestionFormModel.From(question);
        _formError = null;
    }

    private void OnKeyInput(ChangeEventArgs args) => _form.Key = args.Value?.ToString() ?? string.Empty;

    private void OnTextInput(ChangeEventArgs args) => _form.Text = args.Value?.ToString() ?? string.Empty;

    private void OnTypeChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<QuestionType>(args.Value?.ToString(), out var type))
        {
            _form.Type = type;
        }
    }

    private void OnRequiredChanged(ChangeEventArgs args) => _form.IsRequired = args.Value is true;

    /// <summary>
    /// Prüft die Pflichtfelder und meldet die Änderung. Die Prüfung liegt hier, weil das Panel ohne
    /// <c>EditForm</c> arbeitet (Begründung im Markup) – der Command prüft sie ohnehin erneut.
    /// </summary>
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Key) || string.IsNullOrWhiteSpace(_form.Text))
        {
            _formError = "Schlüssel und Fragetext sind Pflicht.";
            return;
        }

        _formError = null;
        await Save.InvokeAsync(
            new QuestionEdit(Node.QuestionId, _form.Key.Trim(), _form.Text.Trim(), _form.Type, _form.IsRequired));
    }

    private async Task ConnectAsync()
    {
        if (_connectTarget is not { } target)
        {
            return;
        }

        _connectTarget = null;
        await Connect.InvokeAsync(target);
    }

    private void StartCreateTrigger()
        => _newTrigger = new TriggerFormModel
        {
            Scope = TriggerScope.AfterQuestion,
            QuestionId = Node.QuestionId,
        };

    /// <summary>
    /// Legt den Trigger an – nachdem die Querfeld-Regeln aus #42 <b>hier</b> geprüft wurden. Der Command
    /// prüft sie ebenfalls (<c>IValidatableObject</c> → 400); dass die Meldung schon im Panel erscheint,
    /// erspart dem Autor den Umweg über eine Fehlermeldung der Engine.
    /// </summary>
    private async Task CreateTriggerAsync()
    {
        if (_newTrigger is null)
        {
            return;
        }

        if (!_newTrigger.TryBuildConfig(out var config, out var configError))
        {
            _triggerError = configError;
            return;
        }

        var draft = new TriggerDraft(
            TriggerScope.AfterQuestion, Node.QuestionId, _newTrigger.Kind, config);

        _newTrigger = null;
        _triggerError = null;
        await AddTrigger.InvokeAsync(draft);
    }

    private async Task DeleteAsync()
    {
        _confirmDelete = false;
        await Delete.InvokeAsync(Node.QuestionId);
    }

    private string KeyOf(Guid questionId)
        => Detail.Questions.FirstOrDefault(question => question.Id == questionId)?.Key ?? "unbekannt";
}
