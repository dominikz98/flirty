@*
    The expression editor: input field with live validation, error position, snippet inserter and
    identifier reference.

    Pulled out of TransitionEditor and TriggerEditor (#103), where it stood line for line identical –
    except for one sentence ("the transition always matches" / "the trigger always fires"). The canvas
    inspector needs it as a third place; a third copy would have made the convention "raw <textarea> with
    @oninput, not <InputTextArea>" finally untenable.

    The parameter set consists exclusively of public types: Razor generates components as public, an
    internal type on a [Parameter] would be CS0053 – under TreatWarningsAsErrors a build error. That is
    why DialogDetail (a public core type) comes in and the component builds the sample context and
    identifier list itself; ExpressionVariable stays internal.

    The BLOCKING check before saving stays with the caller. Here it is displayed, there it is decided –
    otherwise every caller would have to know the state of this component.
*@
@using Flirty.Expressions
@using Flirty.Runtime.Admin

<div class="field">
    <label for="@FieldId">Expression</label>
    @* Deliberately a raw <textarea> with @oninput instead of <InputTextArea>: only this way is it
       validated on EVERY input (the form binding fires only when the field is left). *@
    <textarea id="@FieldId" class="input mono" rows="3" disabled="@Disabled"
              value="@_expression" @oninput="OnExpressionInput"></textarea>
    <span class="hint">
        Boolean expression, e.g. <code>role == "dev" &amp;&amp; age &gt; 18</code>.
        Empty means "@EmptyHint".
    </span>
</div>

@if (_validation is not null)
{
    @if (_validation.IsValid)
    {
        <p class="expr-status ok">
            ✓ @(string.IsNullOrWhiteSpace(_expression)
                ? $"No condition – {EmptyMeaning}."
                : "Expression is valid.")
        </p>
    }
    else
    {
        @* The error message comes from the expression engine (DynamicExpresso) and is already English –
           hence the English frame in front of it. *@
        <p class="expr-status err">✗ The expression is invalid: @_validation.Error</p>

        @if (Caret() is { } caret)
        {
            <pre class="expr-caret">@_expression
@caret</pre>
        }
    }
}

@if (ShowBuilder)
{
    <h3>Insert snippet</h3>

    @if (BuilderVariables.Count == 0)
    {
        <p class="hint">
            There are no referenceable questions in this dialog yet – create questions first,
            then conditions can be built on them.
        </p>
    }
    else
    {
        <div class="field-row">
            <div class="field">
                <label for="@($"{FieldId}Variable")">Variable</label>
                <select id="@($"{FieldId}Variable")" class="input" disabled="@Disabled"
                        @bind="_builderVariable" @bind:after="OnBuilderVariableChanged">
                    @foreach (var variable in BuilderVariables)
                    {
                        <option value="@variable.Name">@variable.Name (@variable.TypeLabel)</option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="@($"{FieldId}Operator")">Operator</label>
                <select id="@($"{FieldId}Operator")" class="input" disabled="@Disabled"
                        @bind="_builderOperator">
                    @foreach (var candidate in BuilderOperators)
                    {
                        <option value="@candidate">@candidate</option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="@($"{FieldId}Value")">Value</label>
                @if (SelectedVariable?.Kind == ExpressionValueKind.Boolean)
                {
                    <select id="@($"{FieldId}Value")" class="input" disabled="@Disabled"
                            @bind="_builderValue">
                        <option value="true">true (yes)</option>
                        <option value="false">false (no)</option>
                    </select>
                }
                else
                {
                    <input id="@($"{FieldId}Value")" class="input" disabled="@Disabled"
                           @bind="_builderValue" @bind:event="oninput" />
                }
            </div>

            <div class="field">
                <label for="@($"{FieldId}Conjunction")">Conjunction</label>
                <select id="@($"{FieldId}Conjunction")" class="input" @bind="_builderConjunction"
                        disabled="@(Disabled || string.IsNullOrWhiteSpace(_expression))">
                    <option value="&amp;&amp;">and (&amp;&amp;)</option>
                    <option value="||">or (||)</option>
                </select>
            </div>
        </div>

        <div class="actions">
            <button type="button" class="btn" disabled="@Disabled"
                    @onclick="InsertCondition">Insert</button>
            <span class="hint">Preview: <code class="mono">@Preview()</code></span>
        </div>
    }

    <h3>Available identifiers</h3>

    <table class="data-table">
        <thead>
            <tr>
                <th>Identifier</th>
                <th>Type</th>
                <th>Example</th>
                <th>Note</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var variable in _variables)
            {
                <tr>
                    <td class="mono">@variable.Name</td>
                    <td>@variable.TypeLabel</td>
                    <td class="mono">@(variable.IsUsable ? variable.Example : "—")</td>
                    <td>
                        @if (!variable.IsUsable)
                        {
                            <span class="badge badge-draft">not usable</span>
                        }
                        @variable.Note
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    /// <summary>The dialog against whose sample context validation runs.</summary>
    [Parameter, EditorRequired]
    public required DialogDetail Detail { get; set; }

    /// <summary>The edited expression; <see langword="null"/> or empty means "unconditional".</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Reports every input – bindable via <c>@bind-Value</c>.</summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Whether the field is locked (published dialog or running gesture).</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// What an empty expression means – the only functional difference between the callers
    /// ("matches unconditionally" for the transition, "fires unconditionally" for the trigger).
    /// </summary>
    [Parameter]
    public string EmptyHint { get; set; } = "matches unconditionally";

    /// <summary>The same fact as a sentence fragment for the success message.</summary>
    [Parameter]
    public string EmptyMeaning { get; set; } = "the transition always matches";

    /// <summary>
    /// Whether the snippet inserter and identifier reference are shown too. In the narrow inspector panel
    /// deliberately switchable off – space is tight there and the full editor is one jump away.
    /// </summary>
    [Parameter]
    public bool ShowBuilder { get; set; } = true;

    /// <summary>
    /// The <c>id</c> of the input field. Default <c>expression</c>, so the existing editors (and their
    /// E2E selectors) do not change; where two fields sit on one page, it is set.
    /// </summary>
    [Parameter]
    public string FieldId { get; set; } = "expression";

    [Inject]
    private IExpressionEvaluator Evaluator { get; set; } = default!;

    private string? _expression;
    private ExpressionContext? _context;
    private IReadOnlyList<ExpressionVariable> _variables = [];
    private ExpressionValidationResult? _validation;
    private string? _builderVariable;
    private string _builderOperator = "==";
    private string _builderValue = string.Empty;
    private string _builderConjunction = "&&";

    /// <summary>
    /// The dialog for which context and identifiers were last computed. Without this comparison the whole
    /// context construction would run again on <b>every</b> keystroke – <c>OnParametersSet</c> runs after
    /// every parent render.
    /// </summary>
    private DialogDetail? _contextFor;

    private IReadOnlyList<ExpressionVariable> BuilderVariables =>
        [.. _variables.Where(variable => variable.IsUsable && variable.Kind != ExpressionValueKind.Context)];

    private ExpressionVariable? SelectedVariable =>
        BuilderVariables.FirstOrDefault(variable => variable.Name == _builderVariable);

    private IReadOnlyList<string> BuilderOperators =>
        SelectedVariable is { } variable ? DesignerExpressionContext.OperatorsFor(variable.Kind) : [];

    protected override void OnParametersSet()
    {
        var contextChanged = !ReferenceEquals(_contextFor, Detail);

        if (contextChanged)
        {
            _contextFor = Detail;
            _context = DesignerExpressionContext.Build(Detail);
            _variables = DesignerExpressionContext.Describe(Detail);
            _builderVariable = BuilderVariables.FirstOrDefault()?.Name;
            OnBuilderVariableChanged();
        }

        // A value set from outside (selection change, reset) takes over; the own input already sits
        // in _expression and is not overwritten here.
        if (_expression != Value)
        {
            _expression = Value;
            Validate();
        }
        else if (contextChanged)
        {
            Validate();
        }
    }

    private async Task OnExpressionInput(ChangeEventArgs args)
    {
        _expression = args.Value?.ToString();
        Validate();
        await ValueChanged.InvokeAsync(_expression);
    }

    /// <summary>
    /// Validates the expression against the dialog's sample context – on every input. The compile check
    /// is a synchronous in-memory operation (DynamicExpresso <c>Parse</c>), hence tolerable without
    /// debouncing.
    /// </summary>
    private void Validate()
    {
        var normalized = string.IsNullOrWhiteSpace(_expression) ? null : _expression!.Trim();

        _validation = _context is null
            ? null
            : DesignerExpressionContext.Validate(Evaluator, normalized, _context);
    }

    private void OnBuilderVariableChanged()
    {
        // After a variable change the previous operator may no longer fit (e.g. ">" on a list) -> reset
        // to the first matching one.
        if (!BuilderOperators.Contains(_builderOperator))
        {
            _builderOperator = BuilderOperators.FirstOrDefault() ?? "==";
        }

        if (SelectedVariable?.Kind == ExpressionValueKind.Boolean
            && _builderValue is not ("true" or "false"))
        {
            _builderValue = "true";
        }
    }

    private string Preview()
        => SelectedVariable is { } variable
            ? DesignerExpressionContext.BuildCondition(variable, _builderOperator, _builderValue)
            : string.Empty;

    private async Task InsertCondition()
    {
        if (SelectedVariable is not { } variable)
        {
            return;
        }

        _expression = DesignerExpressionContext.Append(
            _expression,
            DesignerExpressionContext.BuildCondition(variable, _builderOperator, _builderValue),
            _builderConjunction);

        Validate();
        await ValueChanged.InvokeAsync(_expression);
    }

    /// <summary>Builds the caret line that places a "^" under the reported error position.</summary>
    private string? Caret()
    {
        if (_validation?.ErrorPosition is not { } position
            || string.IsNullOrEmpty(_expression)
            || position < 0
            || position > _expression.Length)
        {
            return null;
        }

        return new string(' ', position) + "^";
    }
}
