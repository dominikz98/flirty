@*
    The canvas of the run view (#104): the same graph as in the editor, but with the run path over it –
    visited nodes, taken edges, iteration count on the loop frame.

    The graph itself is NOT editable here: a running session works on exactly this graph, and changing it
    out from under it is the trap that made #95 expensive. Moving stays allowed – a position does not
    belong to the graph (ADR 0007) – and is the only writing path from here.

    Unlike the editor page, this component binds the JS module itself: the canvas belongs to it, and the
    back channel for the drag would otherwise be an ElementReference that the page would have to pass
    through. The module is unchanged from #101–#103; without a palette in the DOM and without rendered
    ports only moving, zooming and panning run there.
*@
@implements IAsyncDisposable
@using Flirty.Domain
@inject IJSRuntime JS

<div class="graph-canvas-host">
    @* First the words, then the picture: a screen reader should learn the state of the run without
       walking 30 nodes. The text is two-part – structure of the graph (#101) and state of the run (#104). *@
    <p class="visually-hidden" aria-live="polite">@Model.Summary @Run.Summary</p>

    <svg @ref="_canvas"
         class="graph-canvas is-run"
         role="group"
         aria-label="@($"{Model.Summary} {Run.Summary}")"
         data-editable="false"
         data-busy="@(Busy ? "true" : "false")"
         viewBox="0 @SvgFormat.N(Model.MinY) @SvgFormat.N(Model.Width) @SvgFormat.N(Model.Height)">
        <defs>
            <marker id="graph-run-arrow" viewBox="0 0 10 10" refX="9" refY="5"
                    markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" class="graph-arrow-head" />
            </marker>
            <marker id="graph-run-arrow-taken" viewBox="0 0 10 10" refX="9" refY="5"
                    markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" class="graph-arrow-head is-taken" />
            </marker>
        </defs>

        @* The transform of this group belongs to the JS module – C# never renders it (ADR 0006). *@
        <g class="graph-viewport">
            @* Order as in the editor: frames, then edges, then nodes. If an edge lay over a node, its hit
               path would swallow the click on the node centre. *@
            @foreach (var loop in Model.Loops.Where(frame => frame.Width > 0))
            {
                var state = Run.Loop(loop.LoopId);

                <g class="graph-loop @(state is { Iterations: > 0 } ? "is-run" : "") @(state is { IsActive: true } ? "is-active" : "") @(IsSelected(GraphElementKind.Loop, loop.LoopId) ? "is-selected" : "")"
                   @key="loop.LoopId">
                    <rect class="graph-loop-frame"
                          x="@SvgFormat.N(loop.X)" y="@SvgFormat.N(loop.Y)"
                          width="@SvgFormat.N(loop.Width)" height="@SvgFormat.N(loop.Height)"
                          rx="14" />
                    <foreignObject x="@SvgFormat.N(loop.X)" y="@SvgFormat.N(loop.Y - 26)"
                                   width="@SvgFormat.N(Math.Max(loop.Width, 220))" height="26">
                        <button type="button" class="graph-loop-label"
                                aria-label="@LoopLabel(loop, state)"
                                @onclick="() => Select.InvokeAsync(new GraphSelection(GraphElementKind.Loop, loop.LoopId))">
                            ↻ @loop.CollectionKey
                            @if (state is { Iterations: > 0 } running)
                            {
                                <span class="graph-loop-iterations">
                                    @running.Iterations @(running.Iterations == 1 ? "iteration" : "iterations")
                                </span>
                            }
                        </button>
                    </foreignObject>
                </g>
            }

            @* data-from/data-to stay: through them the JS module dims the adjacent edges while a node is
               being dragged, instead of recomputing their path in the browser. *@
            @foreach (var edge in Model.Edges)
            {
                var use = Run.Edge(edge.TransitionId);

                <g class="graph-edge @EdgeClasses(edge, use)" @key="edge.TransitionId"
                   data-from="@edge.FromQuestionId" data-to="@edge.TargetQuestionId">
                    <path class="graph-edge-line" d="@edge.Path"
                          marker-end="@(use is null ? "url(#graph-run-arrow)" : "url(#graph-run-arrow-taken)")" />
                    <path class="graph-edge-hit" d="@edge.Path"
                          role="img" aria-label="@($"{edge.AriaLabel} {EdgeRunLabel(use)}")" tabindex="-1"
                          @onclick="() => Select.InvokeAsync(new GraphSelection(GraphElementKind.Transition, edge.TransitionId))" />
                    <text class="graph-edge-label" aria-hidden="true"
                          x="@SvgFormat.N(edge.LabelX)" y="@SvgFormat.N(edge.LabelY)">@edge.Label</text>
                </g>
            }

            @foreach (var node in Model.Nodes)
            {
                <GraphNodeCard @key="node.QuestionId"
                               Node="node"
                               Selected="IsSelected(GraphElementKind.Question, node.QuestionId)"
                               Editable="false"
                               Run="Run.Visit(node.QuestionId)"
                               Fired="Run.TriggersOf(node.QuestionId)"
                               Select="OnSelectQuestion" />
            }

            @if (Model.StartMarker is { } start)
            {
                @ScopeMarker(start)
            }
            @if (Model.EndMarker is { } end)
            {
                @ScopeMarker(end)
            }
        </g>
    </svg>
</div>

@code {
    /// <summary>The drawing model of the graph – unchanged from the editor view (#101).</summary>
    [Parameter, EditorRequired]
    public required DialogGraphModel Model { get; set; }

    /// <summary>The run state over it.</summary>
    [Parameter, EditorRequired]
    public required GraphRunOverlay Run { get; set; }

    /// <summary>The selected element or <see langword="null"/>.</summary>
    [Parameter]
    public GraphSelection? Selection { get; set; }

    /// <summary>Whether an engine step or a layout write is currently running.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Reports the new selection.</summary>
    [Parameter]
    public EventCallback<GraphSelection> Select { get; set; }

    /// <summary>Reports the new position of a dragged node.</summary>
    [Parameter]
    public EventCallback<NodeMove> Move { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<GraphRunCanvas>? _self;

    /// <summary>
    /// Takes the finished drag of a node – the <b>only</b> message the JS module sends from this view
    /// (the remaining gestures assume a palette or port respectively, and neither is rendered here).
    /// </summary>
    /// <param name="questionId">The moved question.</param>
    /// <param name="x">The new horizontal canvas coordinate in px.</param>
    /// <param name="y">The new vertical canvas coordinate in px.</param>
    [JSInvokable]
    public Task MoveNodeAsync(Guid questionId, int x, int y)
        => Move.InvokeAsync(new NodeMove(questionId, x, y));

    /// <summary>Zooms around the centre of the view – the toolbar's way.</summary>
    /// <param name="factor">The factor (&gt; 1 enlarges).</param>
    public async Task ZoomAsync(double factor)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("zoomBy", _canvas, factor);
        }
    }

    /// <summary>Resets pan and zoom.</summary>
    public async Task ResetViewAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("resetViewport", _canvas);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The module itself is the truth about whether it is bound – an additional flag would have to be
        // reset along with every view change.
        if (_module is not null)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Pages/DialogGraph.razor.js");
        _self = DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync(
            "attach",
            _canvas,
            _self,
            new
            {
                minZoom = GraphMetrics.MinZoom,
                maxZoom = GraphMetrics.MaxZoom,
                zoomStep = GraphMetrics.ZoomStep,
                nodeWidth = GraphMetrics.NodeWidth,
                nodeHeight = GraphMetrics.NodeHeight,
            });
    }

    private bool IsSelected(GraphElementKind kind, Guid id)
        => Selection is { } selection && selection.Kind == kind && selection.Id == id;

    private Task OnSelectQuestion(Guid questionId)
        => Select.InvokeAsync(new GraphSelection(GraphElementKind.Question, questionId));

    /// <summary>
    /// The state classes of an edge. A taken edge is not only coloured, but also thicker and solid – no
    /// statement may hang on colour alone (finding #95).
    /// </summary>
    private string EdgeClasses(GraphEdge edge, GraphRunEdgeUse? use)
    {
        var classes = new List<string>(5) { $"shape-{edge.Shape.ToString().ToLowerInvariant()}" };

        if (edge.IsDefault)
        {
            classes.Add("is-default");
        }

        if (edge.IsBackJump)
        {
            classes.Add("is-backjump");
        }

        if (use is not null)
        {
            classes.Add("is-taken");
        }

        if (use is { IsAmbiguous: true })
        {
            classes.Add("is-ambiguous");
        }

        return string.Join(" ", classes);
    }

    /// <summary>The run state of an edge in words – part of its <c>aria-label</c>.</summary>
    private static string EdgeRunLabel(GraphRunEdgeUse? use)
        => use switch
        {
            null => "Not taken in the test run.",
            { IsAmbiguous: true } => $"Traversed {use.Count} times in the test run – which of the parallel "
                + "transitions was taken is not recorded by the engine.",
            { Count: 1 } => "Taken in the test run.",
            _ => $"Taken {use.Count} times in the test run.",
        };

    private static string LoopLabel(GraphLoopFrame loop, GraphRunLoopState? state)
    {
        var label = $"Loop {loop.CollectionKey}, entry {loop.EntryKey}, breaking question {loop.BreakingKey}";

        return state is { Iterations: > 0 }
            ? $"{label}, {state.Iterations} iteration(s) in the test run{(state.IsActive ? ", currently running" : string.Empty)}."
            : $"{label}, not entered in the test run.";
    }

    /// <summary>
    /// A scope marker with the triggers <b>configured</b> there. Unlike in the editor the chips are not
    /// buttons: a jump into the trigger editor would leave the page and thus the run.
    /// </summary>
    private RenderFragment ScopeMarker(GraphScopeMarker marker) => @<g class="graph-scope-marker">
        <foreignObject x="@SvgFormat.N(marker.X)" y="@SvgFormat.N(marker.Y)"
                       width="@SvgFormat.N(Math.Max(GraphMetrics.NodeWidth, 260))" height="48">
            <div class="graph-scope">
                <span class="graph-scope-title">@marker.Title</span>
                <span class="graph-chips">
                    @foreach (var trigger in marker.Triggers)
                    {
                        <span class="chip @(trigger.Kind == TriggerKind.Webhook ? "chip-webhook" : "chip-inprocess")"
                              title="@trigger.Title">@trigger.Label</span>
                    }
                </span>
            </div>
        </foreignObject>
    </g>;

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach", _canvas);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone (reload or close) – there is nothing left to clean up.
            }

            _module = null;
        }

        _self?.Dispose();
        _self = null;
    }
}
