<Project Sdk="Microsoft.NET.Sdk">

  <!-- TFM, Nullable, ImplicitUsings, WarnAsError come centrally from Directory.Build.props.
       Only what is specific to this sample is here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Core only (NO ASP.NET): EF Core, the SQLite provider, Mediator.Abstractions and
       DynamicExpresso come transitively through this single reference. -->
  <ItemGroup>
    <ProjectReference Include="..\Flirty\Flirty.csproj" />
  </ItemGroup>

  <!-- The core only ships Microsoft.Extensions.*.Abstractions. For the concrete ServiceCollection
       setup (AddFlirty) and AddLogging() the implementation packages are needed. Versions are pinned
       centrally in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
