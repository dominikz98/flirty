<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Test stack (from the xUnit templates) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Coverage collector (#48). Has to follow the .NET line: 6.0.4 (from the xUnit template, the
         .NET 8 era) could not instrument the net10.0-compiled Flirty.dll ("Unable to instrument
         module") and produced a report WITHOUT the core – so without exactly what is to be measured. -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Conditional skipping at runtime (xUnit v2 has no Assert.Skip): the Docker-dependent provider
         tests (#19) skip cleanly without Docker instead of failing. -->
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.61" />
    <!-- Testcontainers: real PostgreSQL/SQL Server databases for the provider migration tests
         (#19, "the DB is created against each of the three providers"). Test project only, need Docker. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.13.0" />
    <!-- In-process TestServer for the MapFlirtyEndpoints integration tests (#35): real HTTP calls
         against the minimal-API endpoints without a real Kestrel/port, Docker-free. Version aligned
         with the installed Microsoft.AspNetCore.App 10.0 runtime (shared framework). -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.8" />
    <!-- Playwright E2E of the web sample (#45/#47): drives the chat UI in a real browser against a
         real Kestrel. Browsers are provided via `playwright.ps1 install`; if they are missing, the
         tests skip themselves (SkippableFact) instead of failing. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <!-- Real MCP client for the in-process Flirty.Mcp integration tests (#126): McpClient +
         HttpClientTransport over the TestServer's HttpClient, so the tests drive the actual
         Streamable-HTTP wire instead of calling handlers directly. Test project only – the server side
         comes from ModelContextProtocol.AspNetCore, which depends on this package anyway. Version kept
         in lockstep with it. -->
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.0.0" />
  </ItemGroup>

  <!-- Core dependencies (pinned centrally; wired up via
       <PackageReference Include="…" /> WITHOUT a version in the follow-up issues #14/#18/#19/#23). -->
  <ItemGroup>
    <!-- Mediator (martinothamar) -->
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <!-- EF Core 10 + Provider (Sqlite / SqlServer / PostgreSQL) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Design-time tooling (dotnet ef): generating the migrations per provider (#19).
         Referenced only as PrivateAssets=all in the migration projects. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <!-- Native SQLite binary (transitive over EF Core Sqlite, test host only).
         Raised to the patched, ABI-compatible version: SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 has a
         high-severity vulnerability (GHSA-2m69-gcr7-jv3q); otherwise NU1903 breaks the build
         (TreatWarningsAsErrors). The managed packages (core/provider/bundle) are not affected. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- Branching/expression engine (the default evaluator) -->
    <PackageVersion Include="DynamicExpresso.Core" Version="2.19.3" />
    <!-- Microsoft.Extensions (logging/DI/hosting/http) – aligned with the .NET 10 line. Raised to
         10.0.10 because Microsoft.Extensions.Http.Resilience 10.8.0 (#33) transitively requires the
         runtime extensions >= 10.0.10 (otherwise an NU1109 downgrade). EF Core 10.0.9 does not itself
         satisfy >= 10.0.10 but only asks for >= 10.0.9 -> no conflict. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <!-- IHostedService + AddHostedService for the auto-migration (#20, FlirtyMigrationHostedService).
         NOT pulled in transitively over EF Core, hence explicit. A real runtime dependency of the
         Flirty package. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <!-- Outbound webhook handler (#33): IHttpClientFactory/AddHttpClient + retry/timeout over the
         standard resilience pipeline (Polly v8). Http.Resilience follows the independent
         dotnet/extensions version line (10.x). -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <!-- MCP server SDK (#126): the Streamable-HTTP transport, tool discovery and the call-tool filter
         pipeline of Flirty.Mcp. Deliberately the ONLY dependency of that package beyond the core, and
         deliberately not referenced by Flirty.AspNetCore – see
         docs/adr/0009-mcp-as-its-own-opt-in-package.md. Its transitive
         Microsoft.Extensions.AI.Abstractions 10.8.x sits on the same dotnet/extensions line as the
         already-pinned Http.Resilience 10.8.0, so no NU1109 downgrade against the runtime extensions
         10.0.10 above. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.0.0" />
  </ItemGroup>

  <!-- SourceLink: embeds GitHub source references for debugging (packaging issue #15).
       Wired up repo-wide in Directory.Build.props (PrivateAssets=all). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
  </ItemGroup>

</Project>
