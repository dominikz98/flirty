<Project>

  <!--
    The doc REQUIREMENT ("every visible API is documented") is enforced as a build error only for the
    publishable library packages. GenerateDocumentationFile deliberately lives in
    Directory.Build.props (it has to be set early); here it is only decided whether missing docs
    (CS1591) break the build or are suppressed. Evaluated in .targets, because IsPackable is only set
    in the respective .csproj.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <!-- CS1591 = a missing XML comment on a visible type/member -> build error.
         (TreatWarningsAsErrors applies anyway; explicit here to document the convention.) -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'true'">
    <!-- Apps/tests/designer need carry no XML docs: missing docs are not an error there. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Package wiring only for publishable packages. In .targets (after the .csproj), so that the
    IsPackable set there can be evaluated – the same pattern as CS1591 above.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <!-- Symbol packages (.snupkg) for debugging. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Deterministic paths only on CI (SourceLink); off locally, so that pack stays warning-free. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Date-based NuGet version YYYYMM.Revision (e.g. 202604.1).
         The revision can be overridden via -p:BuildRevision=N (the CI build number). -->
    <BuildRevision Condition="'$(BuildRevision)' == ''">1</BuildRevision>
    <Version>$([System.DateTime]::UtcNow.ToString(yyyyMM)).$(BuildRevision)</Version>
    <!-- AssemblyVersion/FileVersion segments are UInt16 (max 65535) -> YYYYMM does not fit.
         Hence decoupled to year.month.revision.0 (e.g. 2026.07.1.0).
         The month as "MM" (not "M": a single "M" is the standard specifier month+day). -->
    <AssemblyVersion>$([System.DateTime]::UtcNow.ToString(yyyy)).$([System.DateTime]::UtcNow.ToString(MM)).$(BuildRevision).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
  </PropertyGroup>

  <!-- README + icon from the repo root into the package. $(MSBuildThisFileDirectory) = root (where this file lives). -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
