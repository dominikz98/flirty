<Project>

  <!-- Repo-wide build conventions. For the project-specific doc enforcement see Directory.Build.targets. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Generate the XML docs. MUST stand here (props), not in .targets: the SDK derives
         DocumentationFile (and thereby the /doc switch) from GenerateDocumentationFile before
         Directory.Build.targets is evaluated. Whether missing docs (CS1591) break the build or are
         suppressed is decided by Directory.Build.targets, depending on IsPackable. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Default: not packable. Only Flirty + Flirty.AspNetCore set IsPackable=true. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Shared package metadata. Inert on non-package projects, hence deliberately unconditional (the
       IsPackable-dependent package wiring lives in Directory.Build.targets, because IsPackable is
       only set in the respective .csproj). -->
  <PropertyGroup>
    <Authors>Dominik Zettl</Authors>
    <Product>Flirty</Product>
    <Copyright>© 2026 Dominik Zettl</Copyright>
    <PackageProjectUrl>https://github.com/dominikz98/flirty</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dominikz98/flirty</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- SourceLink (GitHub) repo-wide; harmless on non-package projects. Version pinned centrally. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
