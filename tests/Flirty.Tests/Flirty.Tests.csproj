<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- The DI container, logging and IHttpClientFactory/AddHttpClient (mediator pipeline + webhook
       handler tests, #33) have come over the FrameworkReference Microsoft.AspNetCore.App (shared
       framework) since #35 and must therefore NOT be referenced explicitly any more (otherwise
       NU1510 -> an error under TreatWarningsAsErrors). Only the standard resilience (retry/timeout)
       lies outside the shared framework and stays explicit; version pinned centrally. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <!-- SQLite as the test host for the FlirtyDbContext tests (in-memory, #18); since #19 the provider
       also comes transitively over Flirty, the explicit reference stays for clarity. Version pinned
       centrally. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <!-- ASP.NET Core + in-process TestServer for the MapFlirtyEndpoints integration tests (#35): the
       FrameworkReference provides WebApplication/TestServer (it does NOT come transitively over the
       project reference to Flirty.AspNetCore), TestHost supplies UseTestServer()/GetTestClient(). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <!-- Testcontainers: real PostgreSQL/SQL Server databases for the provider migration tests (#19).
       They need a running Docker; without Docker the affected tests skip themselves at runtime. -->
  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Copy the root README into the test output directory: PackageReadmeTests (#52) checks the
       nuget.org rules against it (absolute links only, images from allow-listed hosts) – the README
       is packed into both packages via PackageReadmeFile. Same pattern as the wwwroot copy in
       Flirty.E2E. -->
  <ItemGroup>
    <Content Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The core + the three provider-separated migration assemblies (#19): the latter supply the
       InitialCreate migrations the tests apply via Database.Migrate() against each provider. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Flirty\Flirty.csproj" />
    <!-- WebAPI endpoints (#35): MapFlirtyEndpoints + DTOs, tested over the in-process TestServer. -->
    <ProjectReference Include="..\..\src\Flirty.AspNetCore\Flirty.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Flirty.Migrations.Sqlite\Flirty.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Flirty.Migrations.PostgreSql\Flirty.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Flirty.Migrations.SqlServer\Flirty.Migrations.SqlServer.csproj" />
    <!-- Console sample (#44): ConsoleSampleTests plays the sample runner through end-to-end. -->
    <ProjectReference Include="..\..\src\Flirty.Samples\Flirty.Samples.csproj" />
    <!-- Web sample (#45): WebSampleTests plays the sample composition through over the in-process TestServer. -->
    <ProjectReference Include="..\..\src\Flirty.Samples.Web\Flirty.Samples.Web.csproj" />
    <!-- Designer (#37): service tests of the connection-profile management (store/factory/
         operations); the internals are visible via InternalsVisibleTo("Flirty.Tests") in the designer. -->
    <ProjectReference Include="..\..\src\Flirty.Designer\Flirty.Designer.csproj" />
  </ItemGroup>

</Project>