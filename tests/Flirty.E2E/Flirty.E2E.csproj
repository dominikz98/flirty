<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Browser automation for the chat-UI E2E (#45/#47). -->
    <PackageReference Include="Microsoft.Playwright" />
    <!-- If the browser is missing, the E2E tests skip themselves instead of failing. -->
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <!-- WebApplication/Kestrel for hosting the sample app in-process (a real port for the browser). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The web sample under test (brings Flirty + Flirty.AspNetCore + migrations along transitively). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Flirty.Samples.Web\Flirty.Samples.Web.csproj" />
    <!-- The Blazor designer under test (#46). On the side, the project reference copies the static
         web assets manifests (Flirty.Designer.staticwebassets.{endpoints,runtime}.json) into the test
         output directory – without them the in-process hosted designer serves no
         _framework/blazor.web.js and the pages would stay without interactivity. -->
    <ProjectReference Include="..\..\src\Flirty.Designer\Flirty.Designer.csproj" />
  </ItemGroup>

  <!-- Copy the sample's static chat UI into the test output wwwroot, so that the in-process hosted
       Kestrel serves it (the browser loads index.html/app.js/styles.css from there). -->
  <ItemGroup>
    <Content Include="..\..\src\Flirty.Samples.Web\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
