<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration of the coverage collector (coverlet.collector, #48). Centrally in the repo root, so
  that the CI run and a local run use exactly the same filters and the numbers stay comparable.

  The collector is deliberately NOT enabled here (no `enabled` attribute): it stays bound to the
  `collect:"XPlat Code Coverage"` switch of `dotnet test`. Otherwise every ordinary `dotnet test` run
  would instrument along unasked and get slower.

  docs/CI.md and CLAUDE.md show the exact invocation (incl. the `settings` switch).
  Careful when editing: XML comments must not contain two consecutive hyphens – VSTest otherwise
  rejects the file with "does not conform to required format".
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Cobertura: the input format of ReportGenerator (see docs/CI.md). -->
          <Format>cobertura</Format>

          <!-- What is measured is what ships: the two NuGet packages. -->
          <Include>[Flirty]*,[Flirty.AspNetCore]*</Include>

          <!-- Deliberately left out:
               - Flirty.Migrations.*  generated EF code (designer output), says nothing;
               - Flirty.Samples*      demo applications, not the product;
               - Flirty.Designer      an app of its own (#37-#43), not a package. -->
          <Exclude>[Flirty.Migrations.*]*,[Flirty.Samples*]*,[Flirty.Designer]*</Exclude>

          <!-- Compiler-generated and obsolete members would otherwise skew the ratio downwards. -->
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <!-- Auto-properties have no code path of their own – with the many sealed records in the
               domain model they would otherwise inflate the number artificially. -->
          <SkipAutoProps>true</SkipAutoProps>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <!-- Deliberately OFF, even though SourceLink is wired up repo-wide
               (Directory.Build.props): switched on, coverlet writes raw.githubusercontent URLs
               pointing at HEAD's commit into the report instead of file paths. ReportGenerator does
               not fetch those, so the HTML report shows no source code – and locally it would show
               the last committed state instead of the working directory anyway. -->
          <UseSourceLink>false</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
